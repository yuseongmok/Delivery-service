  gatlingButton: {fileID: 0}
  smgButton: {fileID: 0}
  takeButton: {fileID: 0}
  buyButton: {fileID: 0}
  greeting:
  - "\uBB34\uAE30\uC0C1: \uC2E4\uC7A5\uC774 \uBCF4\uB0C8\uC9C0? \uC9C0\uAC11 \uB123\uC5B4.
    \uC694 \uBA70\uCE60 \uC0AC\uB78C \uD558\uB098 \uBAA8\uC790\uB77C\uC11C \uB0B4\uAC00
    \uB354 \uC190\uD574\uC57C."
  - "\uD50C\uB808\uC774\uC5B4: \uB098\uBCF4\uACE0 \uC77C\uD558\uB77C\uACE0?"
  - "\uBB34\uAE30\uC0C1: \uD558\uB098 \uACE8\uB77C. \uADF8\uAC70\uC5D0 \uB538\uB9B0
    \uC77C \uD558\uB098\uB9CC \uB05D\uB0B4\uBA74 \uB531 \uADF8 \uAC12\uC774\uC57C."
  briefing:
  - "\uBB34\uAE30\uC0C1: \uC544\uAE4C \uB4E4\uC5B4\uC628 \uC0C1\uC790 \uB458\uC774
    \uBC14\uB00C\uC5C8\uC5B4. \uCE74\uC6B4\uD130\uC5D0 \uB0B4 \uC804\uD45C \uC788\uC744
    \uAC70\uC57C."
  - "\uD50C\uB808\uC774\uC5B4: \uC774\uB7F0 \uAC74 \uC6B0\uB9AC \uAC00\uAC8C\uC11C\uB3C4
    \uB9E8\uB0A0 \uD558\uB294\uB370."
  - "\uBB34\uAE30\uC0C1: \uADF8\uB7FC \uC624\uB298\uC740 \uD2C0\uB9AC\uC9C0 \uB9C8."
  wrongBox:
  - "\uC9C1\uC6D0: \uC55E\uBC88\uD638\uB294 \uAC19\uC544\uC694. \uB05D\uC5D0 \uAC70
    \uBCF4\uC138\uC694."
  accepted:
  - "\uBB34\uAE30\uC0C1: \uB9DE\uB124. \uC774\uAC70 \uCC3E\uB290\uB77C \uB098\uBA38\uC9C0
    \uC0C1\uC790\uAE4C\uC9C0 \uB2E4 \uB72F\uC744 \uBED4\uD588\uC5B4."
  settlement:
  - "\uBB34\uAE30\uC0C1: \uC77C\uD55C \uAC12\uC774\uB791 \uBB3C\uAC74\uAC12\uC774\uB791,
    \uC774\uAC78\uB85C \uB05D. \uC601\uC218\uC99D\uC740?"
  - "\uD50C\uB808\uC774\uC5B4: \uB410\uC5B4. \uAC00\uAC8C \uC7A5\uBD80\uC5D0 \uC4F8
    \uC77C\uB3C4 \uC544\uB2C8\uACE0."

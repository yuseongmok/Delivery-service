  m_Script: {fileID: 11500000, guid: 991102a90f5f0a64192966ec1e9e2660, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionManager
  currentState: 0
  player: {fileID: 317343082}
  deliveryNpc: {fileID: 0}
  mingi: {fileID: 0}
  mingiActor: {fileID: 813224775}
  extraGameplayObjects: []
  deliveryTarget: {fileID: 601967464}
  mingiTarget: {fileID: 813224774}
  interactDistance: 2.46
  requireInteractKeyForDelivery: 1
  nextTarget: {fileID: 383457214}
  nextTargetMarkerLabel: "\uC11C\uC548\uACE8\uBAA9\uC73C\uB85C \uC774\uB3D9"
  requireInteractAtNextTarget: 0
  deliveryCutscene:
    cutsceneCanvas: {fileID: 1154439225}
    cutsceneNpc: {fileID: 382545257}
    cutsceneCamera: {fileID: 942416488}
    extraCutsceneObjects:
    - {fileID: 1476977841}
    dialogueText: {fileID: 1369653350}
    lines:
    - text: "\uC2E4\uC7A5: \uBB50\uC57C \uB108\uB124\uB4E4 \uC5EC\uAE30\uC788\uC5C8\uC5B4?
        \uC5B4\uB514\uAC00\uC11C \uC8FD\uC740\uC904 \uC54C\uC558\uB294\uB370 "
      cameraPoint: {fileID: 1065578580}
    - text: "\uC2E4\uC7A5: \uADF8\uAC83\uBCF4\uB2E4 \uB108\uB124\uC5D0 \uB300\uD574\uC11C
        \uC911\uC694\uD55C \uC18C\uC2DD\uC774 \uC788\uC5B4 "
      cameraPoint: {fileID: 0}
    - text: "\uC2E4\uC7A5: \uB300\uCCB4 \uC774\uBC88 \uD53C\uC790\uAC00\uAC8C  \uCC28\uB9AC\uB294\uB370 
        \uB3C8\uC744 \uC5BC\uB9C8\uB098 \uC4F4\uAC70\uC57C?"
      cameraPoint: {fileID: 0}
    - text: "\uC2E4\uC7A5: \uC57C\uB9C8\uC790\uD0A4\uD30C\uB791 \uBC15\uC9C4\uC6C5
        \uCE21\uC5D0\uC11C \uB108\uB124\uB4E4\uC744 \uC950\uC7A1\uB4EF\uC774 \uCC3E\uACE0\uC788\uB2E4\uACE0"
      cameraPoint: {fileID: 0}
    - text: "\uC544.. \uC0C8 \uC2E0\uBD84\uC774\uB791 \uB9E4\uC7A5 \uCC28\uB9AC\uB290\uB77C
        \uB3C8\uC744 \uC880 \uC4F0\uAE34\uD588\uC8E0.."
      cameraPoint: {fileID: 1381633037}
    - text: "\uC2E4\uC7A5: \uC544\uBB34\uD2BC \uC5EC\uAE30\uC788\uC73C\uBA74 \uAC1C\uC8FD\uC74C
        \uB2F9\uD560\uAC70 \uBED4\uD558\uB2C8\uAE4C"
      cameraPoint: {fileID: 1065578580}
    - text: "\uC2E4\uC7A5: \uADF8 \uB9CE\uC740 \uB3C8\uC73C\uB85C \uB0B4\uAC00 \uB9D0\uD558\uB294
        \uBB34\uAE30\uC0C1\uC774\uB098 \uCC3E\uC544\uAC00\uB77C\uACE0"
      cameraPoint: {fileID: 1065578580}
    - text: "\uC774\uAC70 \uC27D\uC9C0\uC54A\uC740\uB370\uC694"
      cameraPoint: {fileID: 1381633037}
  mingiCutscene:
    cutsceneCanvas: {fileID: 1154439225}
    cutsceneNpc: {fileID: 1706290261}
    cutsceneCamera: {fileID: 942416488}
    extraCutsceneObjects: []
    dialogueText: {fileID: 1369653350}
    lines:
    - text: "\uBBFC\uAE30: \uBB50? \uC774\uB807\uAC8C \uBE68\uB9AC \uB4E4\uCF30\uB2E4\uACE0?"
      cameraPoint: {fileID: 1519027074}
    - text: "\uBBFC\uAE30: \uC774\uAC70 \uD070\uC77C\uC778\uB370...\uC2E4\uC7A5\uC774
        \uB9D0\uD55C \uBB34\uAE30\uC0C1 \uC815\uBCF4\uB294 \uBC1B\uC544\uC654\uC9C0? "
      cameraPoint: {fileID: 0}
    - text: "\uBBFC\uAE30: \uC77C\uB2E8 \uC5BC\uB978 \uAC00\uBD10. \uB09C \uCC59\uAE38\uAC70
        \uCC59\uAE30\uACE0 \uB530\uB77C\uAC08\uAC8C "
      cameraPoint: {fileID: 0}
  showControlHint: 1
  objective: {fileID: 0}
  marker: {fileID: 601732862}
  deliveryMarkerLabel: "\uD53C\uC790 \uBC30\uB2EC"
  mingiMarkerLabel: "\uBBFC\uAE30\uC640 \uB300\uD654"

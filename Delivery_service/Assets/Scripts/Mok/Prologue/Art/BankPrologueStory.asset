%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f7ed5a6f9a35904d8a40f0f4aded09a, type: 3}
  m_Name: BankPrologueStory
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrologueStory
  title: "\uD504\uB864\uB85C\uADF8  /  \uD68C\uC218 \uC791\uC804"
  vault:
    text: "\uBBFC\uAE30: \uC57C\uB9C8\uC790\uD0A4\uD30C\uC5D0 \uBE7C\uC557\uAE34
      \uB3C8\uB9CC \uB418\uCC3E\uB294 \uAC70\uB798. \uAE08\uACE0\uB294 \uB0B4\uAC00
      \uC5F4\uAC8C. \uB4A4\uB97C \uBD10 \uC918."
    seconds: 5
  alarm:
    text: "\uBBFC\uAE30: \uACBD\uBCF4\uC57C! \uBE44\uC5B4 \uC788\uB2E4\uB354\uB2C8!
      \uB3C8\uC740 \uB0B4\uAC00 \uCC59\uAE38\uAC8C. \uCD9C\uAD6C\uB97C \uC9C0\uCF1C!"
    seconds: 4
  police:
    text: "\uC870\uC9C1\uC6D0: \uAE08\uACE0\uC5D0 \uCE68\uC785\uC790\uB2E4! \uC5BC\uAD74
      \uB611\uB611\uD788 \uBD24\uC5B4. \uCD9C\uAD6C \uB9C9\uC544!"
    seconds: 3.5
  cashBundleSeconds: 8
  firstContactSeconds: 10
  breatherSeconds: 6
  supportSeconds: 9
  breather: "\uBBFC\uAE30: \uC7A0\uAE50 \uB738\uD574\uC84C\uC5B4! \uC7A5\uC804\uD574,
    \uB0B4\uAC00 \uC11C\uB450\uB97C\uAC8C!"
  reinforcement: "\uC870\uC9C1\uC6D0: \uC9C0\uC6D0 \uC654\uB2E4! \uAE08\uACE0 \uCABD\uC73C\uB85C
    \uB4E4\uC5B4\uAC00!"
  finalPressure: "\uBBFC\uAE30: \uAC70\uC758 \uB2E4 \uB2F4\uC558\uC5B4! \uC870\uAE08\uB9CC
    \uB354 \uBC84\uD168!"
  collect: "\uBBFC\uAE30: \uB188\uB4E4\uC774 \uBAB0\uB824\uC628\uB2E4! \uAC00\uBC29\uC740
    \uB0B4\uAC00 \uCC59\uAE38\uAC8C!"
  escape: "\uBBFC\uAE30: \uB2E4 \uCC59\uACBC\uC5B4! \uAC19\uC774 \uCC28\uB85C \uAC00\uC790!"
  routeNames:
  - "\uC624\uB978\uCABD \uBCF4\uC548 \uD1B5\uB85C"
  - "\uC67C\uCABD \uC0AC\uBB34\uC2E4 \uD1B5\uB85C"
  - "\uC624\uB978\uCABD \uB300\uAE30 \uD640"
  - "\uC815\uBB38 \uC55E \uB3C4\uC8FC \uCC28\uB7C9"
  routeLines:
  - "\uBBFC\uAE30: \uC624\uB978\uCABD \uD1B5\uB85C\uC57C! \uAE30\uB465 \uB4A4\uB85C
    \uC228\uC5B4\uC11C \uC6C0\uC9C1\uC5EC!"
  - "\uBBFC\uAE30: \uC0AC\uBB34\uC2E4\uC744 \uAC00\uB85C\uC9C8\uB7EC \uC67C\uCABD\uC73C\uB85C!"
  - "\uBBFC\uAE30: \uB9C8\uC9C0\uB9C9 \uD640\uC774\uC57C. \uC624\uB978\uCABD \uC815\uBB38\uC73C\uB85C
    \uB098\uC640!"
  - "\uBBFC\uAE30: \uCC28\uAC00 \uBC14\uB85C \uC55E\uC774\uC57C. \uB6F0\uC5B4!"
  carConversation:
  - text: "\uB098: \uBE44\uC5B4 \uC788\uB294 \uAE08\uACE0\uB77C\uB354\uB2C8, \uBB34\uC7A5\uD55C
      \uB188\uB4E4\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC796\uC544!"
    seconds: 4.5
  - text: "\uBBFC\uAE30: \uBD84\uBA85 \uBE7C\uC557\uAE34 \uB3C8\uB9CC \uBAB0\uB798
      \uD68C\uC218\uD558\uBA74 \uB41C\uB2E4\uACE0 \uD588\uB294\uB370.."
    seconds: 4.5
  - text: "\uB098: \uC800\uCABD \uC870\uC9C1\uC774 \uC6B0\uB9AC \uC5BC\uAD74\uAE4C\uC9C0
      \uBD24\uC5B4. \uC2E4\uC7A5\uC740 \uBB50\uB798?"
    seconds: 4
  - text: "\uBBFC\uAE30: \uC5F0\uB77D\uB3C4 \uC5C6\uACE0 \uC804\uD654\uAC00 \uC548
      \uB3FC. "
    seconds: 3.5
  - text: "\uB098: \uC6B0\uB9AC\uAC00 \uBBF8\uB07C\uC600\uB358 \uAC74\uAC00?"
    seconds: 3
  - text: "\uBBFC\uAE30: \uC544\uC9C1\uC740 \uBAB0\uB77C. \uC5F0\uB77D \uC62C \uB54C\uAE4C\uC9C0
      \uC2E0\uBD84\uC744 \uC228\uAE30\uACE0 \uC870\uC6A9\uD788 \uAE30\uB2E4\uB9AC\uC790."
    seconds: 5
  - text: "\uBBFC\uAE30: \uC544\uBC84\uC9C0\uAC00 \uD558\uB358 \uD53C\uC790 \uAC00\uAC8C\uAC00
      \uC788\uC5B4. \uAC70\uAE30\uB85C \uAC00\uC790."
    seconds: 4
  shopConversation:
  - text: "\uB098: \uC5EC\uAE30\uC11C \uD53C\uC790 \uC7A5\uC0AC\uB97C \uD558\uC790\uACE0?"
    seconds: 3.2
  - text: "\uBBFC\uAE30: \uC544\uBC84\uC9C0\uAC00 \uC811\uC740 \uAC00\uAC8C\uC57C.
      \uC5F4\uC1E0\uB791 \uC870\uB9AC\uBC95\uC740 \uB0A8\uC544 \uC788\uC5B4."
    seconds: 4.5
  - text: "\uBBFC\uAE30: \uC800\uCABD\uC740 \uAE08\uACE0\uB97C \uD134 \uB450 \uB188\uC744
      \uCC3E\uACA0\uC9C0. \uC6B0\uB9B0 \uD3C9\uBC94\uD55C \uAC00\uAC8C \uC8FC\uC778\uACFC
      \uBC30\uB2EC\uC6D0\uC778 \uAC70\uC57C."
    seconds: 6
  - text: "\uB098: \uCC59\uACA8 \uC628 \uB3C8\uC740?"
    seconds: 2.5
  - text: "\uBBFC\uAE30: \uB530\uB85C \uC228\uACA8 \uB458\uAC8C. \uB204\uAD6C \uB3C8\uC778\uC9C0\uBD80\uD130
      \uD655\uC778\uD574\uC57C \uD574. \uC9C0\uAE08 \uC4F0\uBA74 \uAF2C\uB9AC\uB97C
      \uC7A1\uD790 \uC218\uB3C4 \uC788\uC5B4."
    seconds: 6
  - text: "\uB098: \uAC00\uBC29\uC740 \uAF49 \uCC3C\uB294\uB370 \uC6B0\uB9B0 \uBE48\uD138\uD130\uB9AC\uB124."
    seconds: 3.5
  - text: "\uBBFC\uAE30: \uB0B4 \uBE44\uC0C1\uAE08\uC73C\uB85C \uC7AC\uB8CC\uBD80\uD130
      \uC0AC\uC790. \uBC30\uB2EC \uC624\uD1A0\uBC14\uC774\uB3C4 \uC5EC\uAE30 \uC788\uACE0."
    seconds: 5
  - text: "\uB098: \uADF8\uB0E5 \uBB38 \uC7A0\uADF8\uACE0 \uAE30\uB2E4\uB9AC\uBA74
      \uC548 \uB3FC?"
    seconds: 3
  - text: "\uBBFC\uAE30: \uC228\uC5B4\uB9CC \uC788\uC73C\uBA74 \uB354 \uC218\uC0C1\uD574.
      \uC7A5\uC0AC\uB85C \uC0DD\uD65C\uBE44\uB97C \uBC8C\uBA74\uC11C \uC2E4\uC7A5
      \uC5F0\uB77D\uC744 \uAE30\uB2E4\uB9AC\uB294 \uAC70\uC57C."
    seconds: 5.5
  - text: "\uB098: \uB124\uAC00 \uD53C\uC790\uB294 \uB9CC\uB4E4 \uC904 \uC54C\uACE0?"
    seconds: 3
  - text: "\uBBFC\uAE30: \uC5B4\uB9B4 \uB54C \uC9C0\uACB9\uAC8C \uB3C4\uC654\uC5B4.
      \uB0B4\uC77C\uC740 \uB124 \uCC28\uB840\uC57C."
    seconds: 3.8
  - text: "\uB098: \uC88B\uC544. \uB2F9\uBD84\uAC04\uC740 \uD3C9\uBC94\uD55C \uBC30\uB2EC\uC6D0\uC73C\uB85C
      \uC9C0\uB0B4 \uBCF4\uC790."
    seconds: 4
  boarding:
    text: "\uBBFC\uAE30: \uB098\uB3C4 \uD0D4\uC5B4. \uCD9C\uBC1C\uD574!"
    seconds: 2
  getaway:
    text: "\uC5BC\uAD74\uC744 \uC228\uAE30\uACE0 \uC2E4\uC7A5\uC758 \uC5F0\uB77D\uC744
      \uAE30\uB2E4\uB9AC\uAE30 \uC704\uD574, \uC6B0\uB9AC\uB294 \uD53C\uC790 \uAC00\uAC8C
      \uBB38\uC744 \uB2E4\uC2DC \uC5F4\uC5C8\uB2E4."
    seconds: 5
  ending:
    text: "\uB2E4\uC74C \uB0A0 \uC544\uCE68\n\n\uCCAB \uC601\uC5C5\uC77C"
    seconds: 2.5
  driving: "\uBBFC\uAE30: \uC55E\uC5D0 \uCC28\uB4E4\uC740 \uD53C\uD574 \uAC00! \uB9C8\uC9C0\uB9C9
    \uBD09\uC1C4\uB294 \uC18D\uB3C4 \uBD99\uC5EC\uC11C \uBC00\uC5B4\uBC84\uB824!"
  cityArrivalSeconds: 8
  cityPanSeconds: 3
  logoSeconds: 3
  failure: "\uD0C8\uCD9C\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."

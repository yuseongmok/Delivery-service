  alarm:
    text: "\uACF5\uBC94: \uACBD\uBCF4\uC57C! \uB3C8\uC740 \uB0B4\uAC00 \uCC59\uAE38
      \uD14C\uB2C8\uAE4C \uACBD\uCC30\uC744 \uB9C9\uC544!"
    seconds: 3
  police:
    text: "\uACBD\uCC30: \uAC74\uBB3C\uC744 \uD3EC\uC704\uD588\uB2E4! \uBB34\uAE30\uB97C
      \uBC84\uB9AC\uACE0 \uB098\uC640\uB77C!"

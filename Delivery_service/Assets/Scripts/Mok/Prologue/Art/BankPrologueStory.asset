  cashBundleSeconds: 8
  collect: "\uACF5\uBC94: \uAC00\uBC29\uC5D0 \uB2F4\uACE0 \uC788\uC5B4. \uC870\uAE08\uB9CC
    \uBC84\uD168!"
  escape: "\uACF5\uBC94: \uB2E4 \uCC59\uACBC\uC5B4! \uAC19\uC774 \uCC28\uB85C \uAC00\uC790!"
  routeNames:
  - "\uC624\uB978\uCABD \uBCF4\uC548 \uD1B5\uB85C"
  - "\uC67C\uCABD \uC0AC\uBB34\uC2E4 \uD1B5\uB85C"
  - "\uC624\uB978\uCABD \uB300\uAE30 \uD640"
  - "\uC815\uBB38 \uC55E \uB3C4\uC8FC \uCC28\uB7C9"
  routeLines:
  - "\uACF5\uBC94: \uC624\uB978\uCABD \uD1B5\uB85C\uC57C! \uAE30\uB465 \uB4A4\uB85C
    \uC228\uC5B4\uC11C \uC6C0\uC9C1\uC5EC!"
  - "\uACF5\uBC94: \uC0AC\uBB34\uC2E4\uC744 \uAC00\uB85C\uC9C8\uB7EC \uC67C\uCABD\uC73C\uB85C!"
  - "\uACF5\uBC94: \uB9C8\uC9C0\uB9C9 \uD640\uC774\uC57C. \uC624\uB978\uCABD \uC815\uBB38\uC73C\uB85C
    \uB098\uC640!"
  - "\uACF5\uBC94: \uCC28\uAC00 \uBC14\uB85C \uC55E\uC774\uC57C. \uB6F0\uC5B4!"
  boarding:
    text: "\uACF5\uBC94: \uB098\uB3C4 \uD0D4\uC5B4. \uCD9C\uBC1C\uD574!"
    seconds: 2
  getaway:
    text: "\uADF8\uB0A0 \uC774\uD6C4, \uB098\uB294 \uC791\uC740 \uD53C\uC790 \uAC00\uAC8C\uB97C
      \uCC28\uB838\uB2E4."
    seconds: 5
  ending:
    text: "\uBA87 \uC8FC \uD6C4\n\n\uC774\uC58F\uD638 \uD53C\uC790, \uCCAB \uC601\uC5C5\uC77C"
    seconds: 2.5
  driving: "\uACF5\uBC94: \uC55E\uC5D0 \uC800\uC9C0\uC120\uC774\uC57C! \uB3C4\uB85C
    \uB05D\uAE4C\uC9C0 \uB3CC\uD30C\uD574!"
  cityArrivalSeconds: 8
  cityPanSeconds: 3
  logoSeconds: 3
  failure: "\uD0C8\uCD9C\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."

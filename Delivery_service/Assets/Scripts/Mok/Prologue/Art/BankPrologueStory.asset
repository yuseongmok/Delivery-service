  title: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uD55C\uD0D5"
  vault:
    text: "\uACF5\uBC94: \uAE08\uACE0\uB294 \uB0B4\uAC00 \uC5F4\uAC8C. \uB10C \uB4A4\uB97C
      \uBD10\uC918."

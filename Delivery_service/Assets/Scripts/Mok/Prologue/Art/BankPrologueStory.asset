%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f7ed5a6f9a35904d8a40f0f4aded09a, type: 3}
  m_Name: BankPrologueStory
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrologueStory
  title: "\uD504\uB864\uB85C\uADF8"
  vault:
    text: "\uBBFC\uAE30: \uC2E4\uC7A5 \uBD80\uD0C1\uC774\uC57C. \uAE08\uACE0\uB294
      \uB0B4\uAC00 \uC5F4\uAC8C. \uB4A4\uB97C \uBD10 \uC918."
    seconds: 3
  alarm:
    text: "\uBBFC\uAE30: \uACBD\uBCF4\uC57C! \uB3C8\uC740 \uB0B4\uAC00 \uCC59\uAE38
      \uD14C\uB2C8\uAE4C \uACBD\uCC30\uC744 \uB9C9\uC544!"
    seconds: 3
  police:
    text: "\uACBD\uCC30: \uAC74\uBB3C\uC744 \uD3EC\uC704\uD588\uB2E4! \uBB34\uAE30\uB97C
      \uBC84\uB9AC\uACE0 \uB098\uC640\uB77C!"
    seconds: 3.5
  cashBundleSeconds: 8
  firstContactSeconds: 10
  breatherSeconds: 6
  supportSeconds: 9
  breather: "\uBBFC\uAE30: \uC7A0\uAE50 \uB738\uD574\uC84C\uC5B4! \uC7A5\uC804\uD574,
    \uB0B4\uAC00 \uC11C\uB450\uB97C\uAC8C!"
  reinforcement: "\uACBD\uCC30: \uC9C0\uC6D0 \uBCD1\uB825 \uB3C4\uCC29! \uC548\uCABD\uC73C\uB85C
    \uC9C4\uC785\uD55C\uB2E4!"
  finalPressure: "\uBBFC\uAE30: \uAC70\uC758 \uB2E4 \uB2F4\uC558\uC5B4! \uC870\uAE08\uB9CC
    \uB354 \uBC84\uD168!"
  collect: "\uBBFC\uAE30: \uAC00\uBC29\uC5D0 \uB2F4\uACE0 \uC788\uC5B4. \uC870\uAE08\uB9CC
    \uBC84\uD168!"
  escape: "\uBBFC\uAE30: \uB2E4 \uCC59\uACBC\uC5B4! \uAC19\uC774 \uCC28\uB85C \uAC00\uC790!"
  routeNames:
  - "\uC624\uB978\uCABD \uBCF4\uC548 \uD1B5\uB85C"
  - "\uC67C\uCABD \uC0AC\uBB34\uC2E4 \uD1B5\uB85C"
  - "\uC624\uB978\uCABD \uB300\uAE30 \uD640"
  - "\uC815\uBB38 \uC55E \uB3C4\uC8FC \uCC28\uB7C9"
  routeLines:
  - "\uBBFC\uAE30: \uC624\uB978\uCABD \uD1B5\uB85C\uC57C! \uAE30\uB465 \uB4A4\uB85C
    \uC228\uC5B4\uC11C \uC6C0\uC9C1\uC5EC!"
  - "\uBBFC\uAE30: \uC0AC\uBB34\uC2E4\uC744 \uAC00\uB85C\uC9C8\uB7EC \uC67C\uCABD\uC73C\uB85C!"
  - "\uBBFC\uAE30: \uB9C8\uC9C0\uB9C9 \uD640\uC774\uC57C. \uC624\uB978\uCABD \uC815\uBB38\uC73C\uB85C
    \uB098\uC640!"
  - "\uBBFC\uAE30: \uCC28\uAC00 \uBC14\uB85C \uC55E\uC774\uC57C. \uB6F0\uC5B4!"
  carConversation:
  - text: "\uB098: \uC774\uC81C \uC2E4\uC7A5 \uB9CC\uB098\uC11C \uC6B0\uB9AC \uBAAB
      \uBC1B\uC73C\uBA74 \uB05D\uC774\uC9C0?"
    seconds: 3.8
  - text: "\uBBFC\uAE30: \uADF8\uB798. \uC870\uC9C1\uC774 \uC2DC\uD0A8 \uC77C\uC740
      \uB05D\uB0C8\uC73C\uB2C8\uAE4C."
    seconds: 3
  - text: "\uB098: \uC2E4\uC7A5, \uC804\uD654 \uBC1B\uC544?"
    seconds: 2
  - text: "\uBBFC\uAE30: \u2026\uC548 \uBC1B\uC544. \uC57D\uC18D \uC7A5\uC18C\uC5D0\uB3C4
      \uC5C6\uB300."
    seconds: 3.5
  - text: "\uB098: \uACBD\uCC30 \uB54C\uBB38\uC5D0 \uC7A0\uC801\uD55C \uAC74\uAC00?"
    seconds: 2.8
  - text: "\uBBFC\uAE30: \uBAA8\uB974\uACA0\uC5B4. \uC5F0\uB77D \uC62C \uB54C\uAE4C\uC9C0
      \uC870\uC6A9\uD788 \uC788\uC790."
    seconds: 3.8
  - text: "\uBBFC\uAE30: \uC6B0\uB9AC \uC544\uBC84\uC9C0\uAC00 \uD558\uB358 \uAC00\uAC8C\uAC00
      \uC788\uC5B4. \uAC70\uAE30\uB85C \uAC00\uC790."
    seconds: 4
  shopConversation:
  - text: "\uB098: \uD53C\uC790 \uAC00\uAC8C\uC5D0 \uC228\uC790\uACE0?"
    seconds: 3.2
  - text: "\uBBFC\uAE30: \uC544\uBC84\uC9C0\uAC00 \uC811\uC740 \uAC00\uAC8C\uC57C.
      \uC5F4\uC1E0\uB791 \uC870\uB9AC\uBC95\uC740 \uB0A8\uC544 \uC788\uC5B4."
    seconds: 4.5
  - text: "\uBBFC\uAE30: \uB0B4 \uBE44\uC0C1\uAE08\uC73C\uB85C \uC7AC\uB8CC\uBD80\uD130
      \uC0AC\uC790. \uBC30\uB2EC \uC624\uD1A0\uBC14\uC774\uB3C4 \uC5EC\uAE30 \uC788\uACE0."
    seconds: 5
  - text: "\uB098: \uC740\uD589 \uB3C8\uC740?"
    seconds: 2
  - text: "\uBBFC\uAE30: \uC228\uACA8 \uB458\uAC8C. \uC870\uC9C1\uC5D0 \uB118\uAE38
      \uB3C8\uC774\uC57C. \uC6B0\uB9AC \uBAAB\uC740 \uB530\uB85C \uBC1B\uAE30\uB85C
      \uD588\uC796\uC544."
    seconds: 4.2
  - text: "\uB098: \uAC00\uBC29\uC740 \uAF49 \uCC3C\uB294\uB370 \uC6B0\uB9B0 \uBE48\uD138\uD130\uB9AC\uB124."
    seconds: 3.5
  - text: "\uBBFC\uAE30: \uC2E4\uC7A5 \uC5F0\uB77D\uC744 \uAE30\uB2E4\uB9AC\uB824\uBA74
      \uBA39\uACE0\uC0B4 \uB3C8\uC740 \uBC8C\uC5B4\uC57C\uC9C0."
    seconds: 5
  - text: "\uB098: \uADF8\uB0E5 \uBB38 \uC7A0\uADF8\uACE0 \uC788\uC73C\uBA74?"
    seconds: 2.7
  - text: "\uBBFC\uAE30: \uB2EB\uD78C \uAC00\uAC8C\uC5D0 \uB458\uC774 \uC228\uC5B4
      \uC788\uC73C\uBA74 \uB354 \uB208\uC5D0 \uB744\uC5B4. \uD3C9\uBC94\uD558\uAC8C
      \uC7A5\uC0AC\uD558\uB294 \uAC70\uC57C."
    seconds: 5.5
  - text: "\uB098: \uB124\uAC00 \uD53C\uC790\uB294 \uB9CC\uB4E4 \uC904 \uC54C\uACE0?"
    seconds: 3
  - text: "\uBBFC\uAE30: \uC5B4\uB9B4 \uB54C \uC9C0\uACB9\uAC8C \uB3C4\uC654\uC5B4.
      \uB0B4\uC77C\uC740 \uB124 \uCC28\uB840\uC57C."
    seconds: 3.8
  - text: "\uB098: \u2026\uC88B\uC544. \uC801\uC5B4\uB3C4 \uC5EC\uAE30\uC11C \uBC88
      \uB3C8\uC740 \uC6B0\uB9AC\uAC00 \uC4F0\uC790."
    seconds: 4
  boarding:
    text: "\uBBFC\uAE30: \uB098\uB3C4 \uD0D4\uC5B4. \uCD9C\uBC1C\uD574!"
    seconds: 2
  getaway:
    text: "\uC2E4\uC7A5\uC758 \uC5F0\uB77D\uC744 \uAE30\uB2E4\uB9AC\uBA70, \uC6B0\uB9AC\uB294
      \uD53C\uC790 \uAC00\uAC8C \uBB38\uC744 \uB2E4\uC2DC \uC5F4\uC5C8\uB2E4."
    seconds: 5
  ending:
    text: "\uB2E4\uC74C \uB0A0 \uC544\uCE68\n\n\uC774\uC58F\uD638 \uD53C\uC790, \uCCAB
      \uC601\uC5C5\uC77C"
    seconds: 2.5
  driving: "\uBBFC\uAE30: \uC55E\uC5D0 \uC800\uC9C0\uC120\uC774\uC57C! \uB3C4\uB85C
    \uB05D\uAE4C\uC9C0 \uB3CC\uD30C\uD574!"
  cityArrivalSeconds: 8
  cityPanSeconds: 3
  logoSeconds: 3
  failure: "\uD0C8\uCD9C\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."

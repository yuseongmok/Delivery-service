    text: "\n\uAC00\uAE4C\uC774\uC5D0\uC11C \uD45C\uC2DD\uC744 \uBC14\uB77C\uBCF4\uACE0
      [F] \uAE38\uAC8C \uB204\uB974\uAE30"
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Indebted Mechanic.briefing.Array.data[0]'
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC815\uBE44\uC0AC: \uBBFC\uAE30\uAC00 \uBCF4\uB0C8\uC9C0? \uD589\uC0AC\uC7A5
      \uB4A4\uC5D0 \uC900\uBE44\uD574 \uB458 \uCC28\uAC00 \uD544\uC694\uD558\uB2E4\uBA74\uC11C."
    text: "\uC815\uBE44\uC0AC: \uBBFC\uAE30\uAC00 \uBCF4\uB0C8\uC9C0? \uD589\uC0AC\uC7A5
      \uB4A4\uC5D0 \uC900\uBE44\uD574 \uB458 \uCC28\uAC00 \uD544\uC694\uD558\uB2E4\uBA74\uC11C."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Indebted Mechanic.briefing.Array.data[1]'
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uB098: \uB208\uC5D0 \uC548 \uB744\uACE0, \uD655\uC2E4\uD558\uAC8C
      \uC6C0\uC9C1\uC774\uB294 \uCC28\uBA74 \uB3FC.\n\uC815\uBE44\uC0AC: \uCC28\uB294
      \uC788\uC5B4. \uBB38\uC81C\uB294 \uC2DC\uB3D9 \uC81C\uC5B4\uAE30\uC57C. \uBE5A\uC740
      \uB2E4 \uAC1A\uC558\uB294\uB370 \uADF8\uB188\uB4E4\uC774 \uBD80\uD488\uC744
      \uB2F4\uBCF4\uB77C\uACE0 \uC548 \uB3CC\uB824\uC918."
    text: "\uB098: \uB208\uC5D0 \uC548 \uB744\uACE0, \uD655\uC2E4\uD558\uAC8C \uC6C0\uC9C1\uC774\uB294
      \uCC28\uBA74 \uB3FC.\n\uC815\uBE44\uC0AC: \uCC28\uB294 \uC788\uC5B4. \uBB38\uC81C\uB294
      \uC2DC\uB3D9 \uC81C\uC5B4\uAE30\uC57C. \uBE5A\uC740 \uB2E4 \uAC1A\uC558\uB294\uB370
      \uADF8\uB188\uB4E4\uC774 \uBD80\uD488\uC744 \uB2F4\uBCF4\uB77C\uACE0 \uC548
      \uB3CC\uB824\uC918."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Indebted Mechanic.briefing.Array.data[2]'
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC815\uBE44\uC0AC: \uD45C\uC2DC\uD55C \uACE8\uBAA9\uC5D0 \uACF5\uAD6C
      \uC0C1\uC790\uAC00 \uC788\uC5B4. \uB178\uB780 \uB760\uC5D0 \uB0B4 \uC815\uBE44\uC18C
      \uD45C\uC2DC\uAC00 \uBD99\uC5B4 \uC788\uC9C0. \uADF8\uAC83\uB9CC \uCC3E\uC544\uC640
      \uC918."
    text: "\uC815\uBE44\uC0AC: \uD45C\uC2DC\uD55C \uACE8\uBAA9\uC5D0 \uACF5\uAD6C
      \uC0C1\uC790\uAC00 \uC788\uC5B4. \uB178\uB780 \uB760\uC5D0 \uB0B4 \uC815\uBE44\uC18C
      \uD45C\uC2DC\uAC00 \uBD99\uC5B4 \uC788\uC9C0. \uADF8\uAC83\uB9CC \uCC3E\uC544\uC640
      \uC918."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Indebted Mechanic.briefing.Array.data[3]'
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uB098: \uAC00\uC838\uC624\uBA74?\n\uC815\uBE44\uC0AC: \uBD80\uD488\uC744
      \uB2EC\uACE0 \uD589\uC0AC \uB2F9\uC77C \uB124\uAC00 \uD655\uC778\uD55C \uD569\uB958
      \uC9C0\uC810\uC5D0 \uCC28\uB97C \uAC00\uC838\uB2E4 \uB458\uAC8C. \uC6B4\uC804\uC740
      \uB124\uAC00 \uD574."
    text: "\uB098: \uAC00\uC838\uC624\uBA74?\n\uC815\uBE44\uC0AC: \uBD80\uD488\uC744
      \uB2EC\uACE0 \uD589\uC0AC \uB2F9\uC77C \uB124\uAC00 \uD655\uC778\uD55C \uD569\uB958
      \uC9C0\uC810\uC5D0 \uCC28\uB97C \uAC00\uC838\uB2E4 \uB458\uAC8C."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Indebted Mechanic.ending.Array.data[0]'
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC815\uBE44\uC0AC: \uB9DE\uC544, \uC774 \uBD80\uD488\uC774\uC57C.
      \uC774\uC81C \uC800 \uCC28\uB97C \uB2E4\uC2DC \uAD74\uB9B4 \uC218 \uC788\uACA0\uC5B4."
    text: "\uC815\uBE44\uC0AC: \uB9DE\uC544, \uC774 \uBD80\uD488\uC774\uC57C. \uC774\uC81C
      \uC800 \uCC28\uB97C \uB2E4\uC2DC \uAD74\uB9B4 \uC218 \uC788\uACA0\uC5B4."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Indebted Mechanic.ending.Array.data[1]'
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uB098: \uD589\uC0AC\uC7A5 \uACE8\uBAA9 \uB05D, \uD070\uAE38 \uD569\uB958
      \uC9C0\uC810\uC774\uC57C. \uBBFC\uAE30\uAC00 \uC704\uCE58\uB97C \uBCF4\uB0B4
      \uC904 \uAC70\uC57C.\n\uC815\uBE44\uC0AC: \uBC1B\uC558\uC5B4. \uCC28\uC640
      \uC5F4\uC1E0\uB97C \uAC70\uAE30 \uB450\uACE0 \uBA3C\uC800 \uBE60\uC9C8\uAC8C.
      \uD0C8\uCD9C \uD6C4\uC5D0\uB294 \uC9C0\uC815\uD55C \uACF3\uC5D0 \uCC28\uB97C
      \uBC84\uB824. \uCD94\uC801\uB420 \uC218 \uC788\uC73C\uB2C8\uAE4C."
    text: "\uB098: \uD589\uC0AC\uC7A5 \uACE8\uBAA9 \uB05D, \uD070\uAE38 \uD569\uB958
      \uC9C0\uC810\uC774\uC57C. \uBBFC\uAE30\uAC00 \uC704\uCE58\uB97C \uBCF4\uB0B4
      \uC904 \uAC70\uC57C.\n\uC815\uBE44\uC0AC: \uBC1B\uC558\uC5B4. \uCC28\uC640
      \uC5F4\uC1E0\uB97C \uAC70\uAE30 \uB450\uACE0 \uBA3C\uC800 \uBE60\uC9C8\uAC8C.
      \uD0C8\uCD9C \uD6C4\uC5D0\uB294 \uC9C0\uC815\uD55C \uACF3\uC5D0 \uCC28\uB97C
      \uBC84\uB824. \uCD94\uC801\uB420 \uC218 \uC788\uC73C\uB2C8\uAE4C."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Indebted Mechanic.ending.Array.data[2]'
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC815\uBE44\uC0AC: \uC774\uAC74 \uC608\uBE44 \uC5F4\uC1E0\uC57C.
      \uC774\uBC88 \uBE5A\uC740 \uB0B4\uAC00 \uC9C4 \uAC78\uB85C \uD558\uC790.\n\uB098:
      \uADF8\uB0A0 \uAF2D \uAC1A\uC544. \uC2DC\uAC04\uC774 \uC5C6\uC744 \uD14C\uB2C8\uAE4C."
    text: "\uC815\uBE44\uC0AC: \uC774\uAC74 \uC608\uBE44 \uC5F4\uC1E0\uC57C. \uC774\uBC88
      \uBE5A\uC740 \uB0B4\uAC00 \uC9C4 \uAC78\uB85C \uD558\uC790.\n\uB098: \uADF8\uB0A0
      \uAF2D \uAC1A\uC544. \uC2DC\uAC04\uC774 \uC5C6\uC744 \uD14C\uB2C8\uAE4C."
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:27
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uD68C\uC218\uD55C \uBD80\uD488\uC744 \uC815\uBE44\uC0AC\uC5D0\uAC8C
      \uC804\uB2EC\uD558\uC138\uC694."
    text: "\uD68C\uC218\uD55C \uBD80\uD488\uC744 \uC815\uBE44\uC0AC\uC5D0\uAC8C \uC804\uB2EC\uD558\uC138\uC694."
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:27
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uBBFC\uAE30: \uC815\uBE44\uC0AC\uC5D0\uAC8C \uC5F0\uB77D\uD574 \uB480\uC5B4.
      \uC218\uB9AC\uC810\uC5D0\uC11C \uB9CC\uB098 \uBD10. \uCC28\uB7C9\uC740 \uADF8
      \uC0AC\uB78C\uC774 \uC798 \uC54C\uC544."
    text: "\uBBFC\uAE30: \uC815\uBE44\uC0AC\uC5D0\uAC8C \uC5F0\uB77D\uD574 \uB480\uC5B4.
      \uC218\uB9AC\uC810\uC5D0\uC11C \uB9CC\uB098 \uBD10. \uCC28\uB7C9\uC740 \uADF8
      \uC0AC\uB78C\uC774 \uC798 \uC54C\uC544."
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:38
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC870\uC9C1\uC6D0: \uADF8 \uC0C1\uC790 \uB0B4\uB824\uB194!\n\uBBFC\uAE30:
      \uBC1B\uC558\uC73C\uBA74 \uB3CC\uC544\uC640! \uC2F8\uC6B0\uB4E0 \uB530\uB3CC\uB9AC\uB4E0,
      \uC218\uB9AC\uC810\uAE4C\uC9C0 \uB04C\uACE0 \uC624\uC9C4 \uB9C8."
    text: "\uC870\uC9C1\uC6D0: \uADF8 \uC0C1\uC790 \uB0B4\uB824\uB194!\n\uBBFC\uAE30:
      \uBC1B\uC558\uC73C\uBA74 \uB3CC\uC544\uC640! \uC2F8\uC6B0\uB4E0 \uB530\uB3CC\uB9AC\uB4E0,
      \uC218\uB9AC\uC810\uAE4C\uC9C0 \uB04C\uACE0 \uC624\uC9C4 \uB9C8."
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:39
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC815\uBE44\uC0AC: \uB4A4\uC5D0 \uB188\uB4E4\uBD80\uD130 \uB5BC\uC5B4
      \uB0B4! \uC5EC\uAE30\uAE4C\uC9C0 \uB370\uB824\uC624\uBA74 \uC548 \uB3FC."
    text: "\uC815\uBE44\uC0AC: \uB4A4\uC5D0 \uB188\uB4E4\uBD80\uD130 \uB5BC\uC5B4
      \uB0B4! \uC5EC\uAE30\uAE4C\uC9C0 \uB370\uB824\uC624\uBA74 \uC548 \uB3FC."
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:39
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC815\uBE44\uC0AC: \uC798 \uAC00\uC838\uC654\uC5B4. \uB2E8\uC790\uBD80\uD130
      \uD655\uC778\uD574 \uBCFC\uAC8C."
    text: "\uC815\uBE44\uC0AC: \uC798 \uAC00\uC838\uC654\uC5B4. \uB2E8\uC790\uBD80\uD130
      \uD655\uC778\uD574 \uBCFC\uAC8C."
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:42
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC815\uBE44\uC18C \uD45C\uC2DC\uAC00 \uBD99\uC740 \uBD80\uD488 \uC0C1\uC790\uB97C
      \uD68C\uC218\uD558\uC138\uC694. \uC870\uC9C1\uC6D0\uACFC \uC2F8\uC6B0\uAC70\uB098
      \uBE60\uC838\uB098\uC640 \uB3CC\uC544\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    text: "\uC815\uBE44\uC18C \uD45C\uC2DC\uAC00 \uBD99\uC740 \uBD80\uD488 \uC0C1\uC790\uB97C
      \uD68C\uC218\uD558\uC138\uC694. \uC870\uC9C1\uC6D0\uACFC \uC2F8\uC6B0\uAC70\uB098
      \uBE60\uC838\uB098\uC640 \uB3CC\uC544\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:43
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uBE5A\uC9C4 \uC815\uBE44\uC0AC \xB7 \uC900\uBE44 \uC644\uB8CC\n\uD589\uC0AC\uC7A5
      \uD0C8\uCD9C \uCC28\uB7C9\xB7\uCC28\uB7C9 \uD3D0\uAE30 \uC9C0\uC6D0 \uD655\uBCF4"
    text: "\uBE5A\uC9C4 \uC815\uBE44\uC0AC \xB7 \uC900\uBE44 \uC644\uB8CC\n\uD589\uC0AC\uC7A5
      \uD0C8\uCD9C \uCC28\uB7C9\xB7\uCC28\uB7C9 \uD3D0\uAE30 \uC9C0\uC6D0 \uD655\uBCF4"
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:43
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uD0C8\uCD9C \uCC28\uB7C9 \uC9C0\uC6D0 \uD655\uBCF4"
    text: "\uD0C8\uCD9C \uCC28\uB7C9 \uC9C0\uC6D0 \uD655\uBCF4"
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:43
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC815\uBE44\uC0AC\uAC00 \uD589\uC0AC \uB2F9\uC77C \uACE8\uBAA9 \uB05D
      \uD569\uB958 \uC9C0\uC810\uC5D0 \uCC28\uC640 \uC5F4\uC1E0\uB97C \uB450\uAE30\uB85C
      \uD588\uC5B4. \uC9C1\uC811 \uC6B4\uC804\uD574 \uD0C8\uCD9C\uD55C \uB2E4\uC74C
      \uC9C0\uC815 \uC7A5\uC18C\uC5D0 \uCC28\uB97C \uBC84\uB824. \uAC00\uAC8C\uAE4C\uC9C0
      \uCD94\uC801\uB418\uBA74 \uC548 \uB3FC. \u2018\uBE5A\uC9C4 \uC815\uBE44\uC0AC\u2019
      \uC900\uBE44 \uC131\uACFC\uC5D0 \uAE30\uB85D\uD588\uC5B4."
    text: "\uC815\uBE44\uC0AC\uAC00 \uD589\uC0AC \uB2F9\uC77C \uACE8\uBAA9 \uB05D
      \uD569\uB958 \uC9C0\uC810\uC5D0 \uCC28\uC640 \uC5F4\uC1E0\uB97C \uB450\uAE30\uB85C
      \uD588\uC5B4. \uC9C1\uC811 \uC6B4\uC804\uD574 \uD0C8\uCD9C\uD55C \uB2E4\uC74C
      \uC9C0\uC815 \uC7A5\uC18C\uC5D0 \uCC28\uB97C \uBC84\uB824. \uAC00\uAC8C\uAE4C\uC9C0
      \uCD94\uC801\uB418\uBA74 \uC548 \uB3FC. \u2018\uBE5A\uC9C4 \uC815\uBE44\uC0AC\u2019
      \uC900\uBE44 \uC131\uACFC\uC5D0 \uAE30\uB85D\uD588\uC5B4."
  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:48
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uBBF8\uC158\uC744 \uC911\uB2E8\uD588\uC2B5\uB2C8\uB2E4."
    text: "\uBBF8\uC158\uC744 \uC911\uB2E8\uD588\uC2B5\uB2C8\uB2E4."

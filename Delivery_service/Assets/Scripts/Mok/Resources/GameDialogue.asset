      \uCE58\uC988\uD53C\uC790\uB97C \uC804\uB2EC\uD574 \uAC00\uAC8C \uC774\uB984\uC73C\uB85C
      \uD589\uC0AC\uC7A5 \uCD9C\uC785 \uC2B9\uC778\uC744 \uBC1B\uC73C\uC138\uC694."
  - id: FirstChapterPreparation.missions.Array.data[1].result
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uC815\uC2DD \uB0A9\uD488 \uC2B9\uC778 \xB7 \uB2E4\uC74C \uC77C\uCC28\uC5D0

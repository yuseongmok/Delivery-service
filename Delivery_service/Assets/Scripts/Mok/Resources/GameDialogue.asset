    original: "\n\uB3C4\uCC29\uD558\uBA74 \uB0B4\uB824\uC11C \uC0C1\uD638\uC791\uC6A9\uD558\uC138\uC694"
    text: "\n\uB3C4\uCC29\uD558\uBA74 \uB0B4\uB824\uC11C \uC0C1\uD638\uC791\uC6A9\uD558\uC138\uC694"
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.opening.Array.data[0]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uBBFC\uAE30: \uC624\uB298\uC740 \uBB38 \uB2EB\uC544. \uB0A9\uD488
      \uC2B9\uC778, \uCD9C\uC785\uAD6C, \uD0C8\uCD9C \uCC28\uB7C9\uAE4C\uC9C0 \uC900\uBE44\uB410\uC5B4."
    text: "\uBBFC\uAE30: \uC624\uB298\uC740 \uBB38 \uB2EB\uC544. \uB0A9\uD488 \uC2B9\uC778,
      \uCD9C\uC785\uAD6C, \uD0C8\uCD9C \uCC28\uB7C9\uAE4C\uC9C0 \uC900\uBE44\uB410\uC5B4."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.opening.Array.data[1]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uBBFC\uAE30: \uBC15\uC9C4\uC6C5\uD55C\uD14C \uB530\uC9C0\uB7EC \uAC00\uB294
      \uAC8C \uC544\uB2C8\uC57C. \uC65C \uC6B0\uB9B4 \uCAD3\uB294\uC9C0, \uC548 \uB4E4\uD0A4\uACE0
      \uB4E4\uC5B4 \uBD10."
    text: "\uBBFC\uAE30: \uBC15\uC9C4\uC6C5\uD55C\uD14C \uB530\uC9C0\uB7EC \uAC00\uB294
      \uAC8C \uC544\uB2C8\uC57C. \uC65C \uC6B0\uB9B4 \uBC84\uB838\uB294\uC9C0, \uC548
      \uB4E4\uD0A4\uACE0 \uB4E4\uC5B4 \uBD10."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.overheard.Array.data[0]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uC870\uC9C1\uC6D0: \uC57C\uB9C8\uC790\uD0A4 \uCABD\uC774 \uAE08\uACE0
      \uC2B5\uACA9\uC5D0 \uB300\uD55C \uBCF4\uBCF5\uC744 \uC900\uBE44\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    text: "\uC870\uC9C1\uC6D0: \uC57C\uB9C8\uC790\uD0A4 \uCABD\uC774 \uAE08\uACE0
      \uC2B5\uACA9\uC5D0 \uB300\uD55C \uBCF4\uBCF5\uC744 \uC900\uBE44\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.overheard.Array.data[1]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uBC15\uC9C4\uC6C5: \uADF8\uB798\uC57C\uC9C0. \uBBFC\uAE30\uC640 \uADF8
      \uCE5C\uAD6C\uB97C \uBCF4\uB0B8 \uBCF4\uB78C\uC774 \uC788\uAD70. \uBE7C\uC557\uAE34
      \uB3C8\uC744 \uD68C\uC218\uD558\uB294 \uC904 \uC54C\uACE0 \uC77C\uC744 \uBC8C\uC600\uC73C\uB2C8."
    text: "\uBC15\uC9C4\uC6C5: \uADF8\uB798\uC57C\uC9C0. \uADF8\uB188\uB4E4\uC744
      \uBCF4\uB0B8 \uBCF4\uB78C\uC774 \uC788\uAD70. \uBE7C\uC557\uAE34 \uB3C8\uC744
      \uD68C\uC218\uD558\uB294 \uC904 \uC54C\uACE0 \uC77C\uC744 \uBC8C\uC600\uC73C\uB2C8."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.overheard.Array.data[2]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uC870\uC9C1\uC6D0: \uC6B0\uB9AC \uBCF4\uC2A4\uAED8\uC11C \uC9C1\uC811
      \uC218\uC2B5\uD558\uB7EC \uAC00\uC2E0\uB2F5\uB2C8\uB2E4. \uD68C\uB2F4 \uC7A5\uC18C\uB97C
      \uC7A1\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    text: "\uC870\uC9C1\uC6D0: \uC6B0\uB9AC \uBCF4\uC2A4\uAED8\uC11C \uC9C1\uC811
      \uC218\uC2B5\uD558\uB7EC \uAC00\uC2E0\uB2F5\uB2C8\uB2E4. \uD68C\uB2F4 \uC7A5\uC18C\uB97C
      \uC7A1\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.overheard.Array.data[3]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uBC15\uC9C4\uC6C5: \uADF8 \uC790\uB9AC\uB97C \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uB9CC\uB4E4\uC5B4. \uC57C\uB9C8\uC790\uD0A4\uAC00 \uD55C \uC77C\uB85C \uBCF4\uC774\uAC8C.
      \uBCF4\uC2A4\uAC00 \uC5C6\uC5B4\uC9C0\uBA74 \uC870\uC9C1\uC740 \uB0B4\uAC00
      \uB9E1\uB294\uB2E4."
    text: "\uBC15\uC9C4\uC6C5: \uADF8 \uC790\uB9AC\uB97C \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uB9CC\uB4E4\uC5B4. \uC57C\uB9C8\uC790\uD0A4\uAC00 \uD55C \uC77C\uB85C \uBCF4\uC774\uAC8C.
      \uBCF4\uC2A4\uAC00 \uC5C6\uC5B4\uC9C0\uBA74 \uC870\uC9C1\uC740 \uB0B4\uAC00
      \uB9E1\uB294\uB2E4."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.overheard.Array.data[4]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uC870\uC9C1\uC6D0: \uC2E4\uC7A5\uACFC \uAE08\uACE0\uC5D0 \uB4E4\uC5B4\uAC14\uB358
      \uB450 \uC0AC\uB78C\uC740 \uC5B4\uB5BB\uAC8C \uD560\uAE4C\uC694?"
    text: "\uC870\uC9C1\uC6D0: \uC2E4\uC7A5\uACFC \uAE08\uACE0\uC5D0 \uB4E4\uC5B4\uAC14\uB358
      \uB450 \uC0AC\uB78C\uC740 \uC544\uC9C1\uAE4C\uC9C0 \uC704\uCE58\uAC00 \uD655\uC778\uC774
      \uC548\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.overheard.Array.data[5]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uBC15\uC9C4\uC6C5: \uC804\uBD80 \uC815\uB9AC\uD574. \uB0B4\uAC00
      \uC2DC\uCF30\uB2E4\uB294 \uAC78 \uC544\uB294 \uB188\uC774 \uC0B4\uC544 \uC788\uC73C\uBA74
      \uC548 \uB3FC."
    text: "\uBC15\uC9C4\uC6C5: \uB2A6\uC9C0\uC54A\uAC8C \uC804\uBD80 \uC815\uB9AC\uD574.
      \uB0B4\uAC00 \uC2DC\uCF30\uB2E4\uB294 \uAC78 \uC544\uB294 \uB188\uC774 \uC0B4\uC544
      \uC788\uC73C\uBA74 \uC548 \uB3FC."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.overheard.Array.data[6]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uB098: \uC6B0\uB9AC\uAC00 \uC870\uC9C1\uB07C\uB9AC \uC2F8\uC6B0\uAC8C
      \uB9CC\uB4DC\uB294 \uBBF8\uB07C\uC600\uC5B4. \uBCF4\uC2A4\uB97C \uC5C6\uC560\uACE0
      \uC790\uAE30\uAC00 \uB450\uBAA9\uC774 \uB418\uB824\uACE0\u2026\n\uBBFC\uAE30:
      \u2026\uB4E4\uC5C8\uC5B4. \uC774\uC81C \uB098\uC640. \uC0B4\uC544\uC11C \uB3CC\uC544\uC640."
    text: "\uB098: \uC6B0\uB9AC\uAC00 \uC870\uC9C1\uB07C\uB9AC \uC2F8\uC6B0\uAC8C
      \uB9CC\uB4DC\uB294 \uBBF8\uB07C\uC600\uC5B4. \uBCF4\uC2A4\uB97C \uC5C6\uC560\uACE0
      \uC790\uAE30\uAC00 \uB450\uBAA9\uC774 \uB418\uB824\uACE0\u2026"
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.closing.Array.data[0]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uB098: \uCC28\uB294 \uBC84\uB9AC\uACE0 \uC654\uC5B4. \uC774 \uAC00\uAC8C\uAE4C\uC9C0
      \uB530\uB77C\uC624\uC9C0\uB294 \uC54A\uC558\uC744 \uAC70\uC57C."
    text: "\uB098: \uCC28\uB294 \uBC84\uB9AC\uACE0 \uC654\uC5B4. \uC774 \uAC00\uAC8C\uAE4C\uC9C0
      \uB530\uB77C\uC624\uC9C0\uB294 \uC54A\uC558\uC744 \uAC70\uC57C."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.closing.Array.data[1]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uB098: \uD68C\uC218 \uC791\uC804\uC740 \uAC70\uC9D3\uB9D0\uC774\uC5C8\uC5B4.
      \uBC15\uC9C4\uC6C5\uC740 \uC6B0\uB9AC\uB85C \uC57C\uB9C8\uC790\uD0A4\uB97C
      \uC790\uADF9\uD558\uACE0, \uC2F8\uC6C0\uC774 \uBC8C\uC5B4\uC9C0\uBA74 \uC6B0\uB9AC
      \uBCF4\uC2A4\uB97C \uC5C6\uC568 \uC0DD\uAC01\uC774\uC57C."
    text: "\uB098: \uD68C\uC218 \uC791\uC804\uC740 \uAC70\uC9D3\uB9D0\uC774\uC5C8\uC5B4.
      \uBC15\uC9C4\uC6C5\uC740 \uC6B0\uB9AC\uB85C \uC57C\uB9C8\uC790\uD0A4\uB97C
      \uC790\uADF9\uD558\uACE0, \uC2F8\uC6C0\uC774 \uBC8C\uC5B4\uC9C0\uBA74 \uC6B0\uB9AC
      \uBCF4\uC2A4\uB97C \uC5C6\uC568 \uC0DD\uAC01\uC774\uC57C."
  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.closing.Array.data[2]'

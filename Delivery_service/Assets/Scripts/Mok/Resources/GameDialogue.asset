  - id: Assets/Scripts/Mok/ShopUI/SpecialOrderMission.cs:69
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB2F4\uB2F9\uC790: \uB3C4\uC6B0\xB7\uC18C\uC2A4\xB7\uCE58\uC988\uB9CC
      \uB123\uC5B4 \uAD6C\uC6B4, \uC190\uC0C1\uB418\uC9C0 \uC54A\uC740 \uD53C\uC790\uAC00
      \uD544\uC694\uD574\uC694. \uB2E4\uC2DC \uC900\uBE44\uD574 \uC8FC\uC138\uC694."
    text: "\uB2F4\uB2F9\uC790: \uB3C4\uC6B0\xB7\uC18C\uC2A4\xB7\uCE58\uC988\uB9CC
      \uB123\uC5B4 \uAD6C\uC6B4, \uC190\uC0C1\uB418\uC9C0 \uC54A\uC740 \uD53C\uC790\uAC00
      \uD544\uC694\uD574\uC694. \uB2E4\uC2DC \uC900\uBE44\uD574 \uC8FC\uC138\uC694."

  - id: Assets/Scripts/Mok/Prologue/StoryTutorial.cs:130
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uCCAB \uC601\uC5C5\uC77C  \xB7  "
    text: "\uCCAB \uC601\uC5C5\uC77C  \xB7  "
  - id: Assets/Scripts/Mok/Prologue/StoryTutorial.cs:154
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uC5C5\uC801 \uB2EC\uC131 \xB7 \uCCAB \uC815\uB2F9\uD55C \uC218\uC785\n\uC774\uC81C
      \uC2A4\uC2A4\uB85C \uC8FC\uBB38\uC744 \uACE8\uB77C \uBC30\uB2EC\uD574 \uBCF4\uC138\uC694."
    text: "\uC5C5\uC801 \uB2EC\uC131 \xB7 \uCCAB \uC815\uB2F9\uD55C \uC218\uC785\n\uC774\uC81C
      \uC2A4\uC2A4\uB85C \uC8FC\uBB38\uC744 \uACE8\uB77C \uBC30\uB2EC\uD574 \uBCF4\uC138\uC694."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Missing Broker.meetingLines.Array.data[0]'
    group: "04 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    original: "\uC2E4\uC7A5: \uBAA9\uC18C\uB9AC \uB0AE\uCDB0. \uB0B4 \uBB38\uC790,
      \uB108\uD76C \uB458\uB9CC \uBD24\uC9C0?"
    text: "\uC2E4\uC7A5: \uBAA9\uC18C\uB9AC \uB0AE\uCDB0. \uB0B4 \uBB38\uC790, \uB108\uD76C
      \uB458\uB9CC \uBD24\uC9C0?"
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Missing Broker.meetingLines.Array.data[1]'
    group: "04 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    original: "\uB098: \uC870\uC9C1 \uC77C\uC774\uB77C\uBA70 \uB2E4\uB978 \uC870\uC9C1\uC758
      \uAE08\uACE0\uAE4C\uC9C0 \uB4E4\uC5B4\uAC14\uC5B4. \uADF8\uB7F0\uB370 \uC65C
      \uC5F0\uB77D\uC744 \uB04A\uACE0, \uC774\uC81C \uC640\uC11C \uB3C4\uC640 \uB2EC\uB77C\uB294
      \uAC70\uC57C?"
    text: "\uB098: \uC870\uC9C1 \uC77C\uC774\uB77C\uBA70 \uC57C\uB9C8\uC790\uD0A4\uD30C\uC758
      \uAE08\uACE0\uAE4C\uC9C0 \uB4E4\uC5B4\uAC14\uC5B4. \uADF8\uB7F0\uB370 \uC65C
      \uC5F0\uB77D\uC744 \uB04A\uACE0, \uC774\uC81C \uC640\uC11C \uB3C4\uC640 \uB2EC\uB77C\uB294
      \uAC70\uC57C?"
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Missing Broker.meetingLines.Array.data[2]'
    group: "04 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    original: "\uC2E4\uC7A5: \uB04A\uC740 \uAC8C \uC544\uB2C8\uC57C. \uB3C8 \uBC1B\uC744
      \uC7A5\uC18C\uB85C \uAC14\uB354\uB2C8 \uC6B0\uB9AC \uC870\uC9C1 \uB188\uB4E4\uC774
      \uB0A0 \uC8FD\uC774\uB824 \uB4E4\uC5C8\uC5B4. \uC774\uC720\uB294 \uB098\uB3C4
      \uBAB0\uB77C."
    text: "\uC2E4\uC7A5: \uB04A\uC740 \uAC8C \uC544\uB2C8\uC57C. \uB3C8 \uBC1B\uC744
      \uC7A5\uC18C\uB85C \uAC14\uB354\uB2C8 \uC6B0\uB9AC \uC870\uC9C1 \uB188\uB4E4\uC774
      \uB0A0 \uC8FD\uC774\uB824 \uB4E4\uC5C8\uC5B4. \uC774\uC720\uB294 \uB098\uB3C4
      \uBAB0\uB77C."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Missing Broker.meetingLines.Array.data[3]'
    group: "04 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    original: "\uC870\uC9C1\uC6D0: \uC2E4\uC7A5 \uC606\uC5D0 \uC800\uB188\uB3C4 \uC788\uB2E4!
      \uB193\uCE58\uC9C0 \uB9C8!\n\uC2E4\uC7A5: \uB530\uB77C\uBD99\uC5C8\uC5B4! \uC5EC\uAE30\uC120
      \uC548 \uB3FC. \uC77C\uB2E8 \uAC19\uC774 \uBE60\uC838\uB098\uAC00\uC790!"
    text: "\uC870\uC9C1\uC6D0: \uC2E4\uC7A5 \uC606\uC5D0 \uC800\uB188\uB3C4 \uC788\uB2E4!
      \uB193\uCE58\uC9C0 \uB9C8!\n\uC2E4\uC7A5: \uB530\uB77C\uBD99\uC5C8\uC5B4! \uC5EC\uAE30\uC120
      \uC548 \uB3FC. \uC77C\uB2E8 \uAC19\uC774 \uBE60\uC838\uB098\uAC00\uC790!"
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Missing Broker.endingLines.Array.data[0]'
    group: "04 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    original: "\uC2E4\uC7A5: \uD68C\uC218\uD558\uB77C\uB294 \uC9C0\uC2DC\uB294 \uBC15\uC9C4\uC6C5\uC5D0\uAC8C
      \uC9C1\uC811 \uBC1B\uC558\uC5B4. \uC870\uC9C1\uC758 \uC2E4\uC138\uC57C. \uADF8\uB7F0\uB370
      \uC784\uBB34\uAC00 \uB05D\uB098\uC790 \uBA85\uB839\uC744 \uC804\uB2EC\uD55C
      \uB098\uAE4C\uC9C0 \uC5C6\uC560\uB824 \uD574. \uC774\uC720\uB294 \uADF8\uB188\uC774
      \uC54C\uACA0\uC9C0."
    text: "\uC2E4\uC7A5: \uD68C\uC218\uD558\uB77C\uB294 \uC9C0\uC2DC\uB294 \uBC15\uC9C4\uC6C5\uC5D0\uAC8C
      \uC9C1\uC811 \uBC1B\uC558\uC5B4. \uC870\uC9C1\uC758 \uC2E4\uC138\uAC00 \uB2E4
      \uB410\uB354\uAD70... \uADF8\uB7F0\uB370 \uC784\uBB34\uAC00 \uB05D\uB098\uC790
      \uBA85\uB839\uC744 \uC804\uB2EC\uD55C \uB098\uAE4C\uC9C0 \uC5C6\uC560\uB824
      \uD574. \uC774\uC720\uB294 \uADF8\uB188\uC774 \uC54C\uACA0\uC9C0."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Missing Broker.endingLines.Array.data[1]'
    group: "04 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    original: "\uB098: \uB9CC\uB098\uC11C \uC9C1\uC811 \uBB3C\uC5B4\uBCF4\uB77C\uB294
      \uAC70\uC57C?\n\uC2E4\uC7A5: \uADF8\uB7EC\uB2E4 \uC8FD\uC5B4. \uBE44\uACF5\uAC1C
      \uD589\uC0AC\uC5D0 \uB098\uC628\uB2E4\uB2C8, \uBA3C\uC800 \uBB34\uC2A8 \uB9D0\uC744
      \uD558\uB294\uC9C0 \uB4E4\uC5B4 \uBD10. \uB0A9\uD488 \uB2F4\uB2F9\uC790 \uC5F0\uB77D\uCC98\uB97C
      \uC904\uAC8C."
    text: "\uB098: \uB9CC\uB098\uC11C \uC9C1\uC811 \uBB3C\uC5B4\uBCF4\uB77C\uB294
      \uAC70\uC57C?\n\uC2E4\uC7A5: \uADF8\uB7EC\uB2E4 \uC8FD\uC5B4. \uBE44\uACF5\uAC1C
      \uC74C\uC2DD \uB0A9\uD488\uD589\uC0AC\uC5D0 \uB098\uC628\uB2E4\uB2C8, \uD589\uC0AC\uC7A5\uC5D0
      \uC7A0\uC785\uD574\uC11C \uBB34\uC2A8 \uC77C\uC778\uC9C0 \uD655\uC778\uD574\uBD10.
      \uB0A9\uD488 \uB2F4\uB2F9\uC790 \uC5F0\uB77D\uCC98\uB97C \uC904\uAC8C."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Missing Broker.endingLines.Array.data[2]'
    group: "04 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    original: "\uBBFC\uAE30: \uBC1B\uC558\uC5B4. \uD53C\uC790 \uAC00\uAC8C \uC774\uB984\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uBA74 \uB418\uACA0\uB124. \uB0B4\uC77C \uC2DC\uC2DD \uB0A9\uD488
      \uC57D\uC18D\uBD80\uD130 \uC7A1\uC744\uAC8C. \uC624\uB298\uC740 \uB3CC\uC544\uC640."
    text: "\uBBFC\uAE30: \uBC1B\uC558\uC5B4. \uD53C\uC790 \uAC00\uAC8C \uC774\uB984\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uBA74 \uB418\uACA0\uB124. \uB0B4\uC77C \uC2DC\uC2DD \uB0A9\uD488
      \uC57D\uC18D\uBD80\uD130 \uC7A1\uC744\uAC8C. \uC624\uB298\uC740 \uB3CC\uC544\uC640."
  - id: Assets/Scripts/Mok/ShopUI/BrokerMission.cs:40
    group: "04 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    original: "\uC2E4\uC7A5\uC774 \uC774\uB3D9\uD560 \uAE38\uC744 \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    text: "\uC2E4\uC7A5\uC774 \uC774\uB3D9\uD560 \uAE38\uC744 \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  - id: Assets/Scripts/Mok/ShopUI/BrokerMission.cs:44
    group: "04 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    original: "\uBBFC\uAE30: \uC2E4\uC7A5\uC774 \uBCF4\uB0B8 \uC57D\uC18D \uC7A5\uC18C\uC57C.
      \uC624\uB298 \uC628\uB2E4\uACE0 \uD588\uC73C\uB2C8 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC744 \uAC70\uC57C. \uC870\uC2EC\uD574\uC11C \uB9CC\uB098 \uBD10."
    text: "\uBBFC\uAE30: \uC2E4\uC7A5\uC774 \uBCF4\uB0B8 \uC57D\uC18D \uC7A5\uC18C\uC57C.

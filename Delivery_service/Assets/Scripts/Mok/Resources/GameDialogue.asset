  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.briefing.Array.data[0]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB2F4\uB2F9\uC790: \uC2DC\uC2DD \uB0A9\uD488 \uC608\uC57D\uD558\uC2E0
      \uC774\uC58F\uD638 \uD53C\uC790\uC8E0? \uC774\uBC88 \uBE44\uACF5\uAC1C \uD589\uC0AC\uC5D0
      \uB0A9\uD488\uD560 \uC5C5\uCCB4\uB97C \uCC3E\uACE0 \uC788\uC5B4\uC694."
    text: "\uB2F4\uB2F9\uC790: \uC2DC\uC2DD \uB0A9\uD488 \uC608\uC57D\uD558\uC2E0
      \uC774\uC58F\uD638 \uD53C\uC790\uC8E0? \uC774\uBC88 \uBE44\uACF5\uAC1C \uD589\uC0AC\uC5D0
      \uB0A9\uD488\uD560 \uC5C5\uCCB4\uB97C \uCC3E\uACE0 \uC788\uC5B4\uC694."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.briefing.Array.data[1]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB098: \uC800\uD76C \uAC00\uAC8C\uAC00 \uB9E1\uACA0\uC2B5\uB2C8\uB2E4.\n\uB2F4\uB2F9\uC790:
      \uBA3C\uC800 \uAE30\uBCF8\uBD80\uD130 \uBD05\uC2DC\uB2E4. \uCE58\uC988\uD53C\uC790
      \uD55C \uD310. \uB3C4\uC6B0, \uC18C\uC2A4, \uCE58\uC988\uB9CC\uC694."
    text: "\uB098: \uC800\uD76C \uAC00\uAC8C\uAC00 \uB9E1\uACA0\uC2B5\uB2C8\uB2E4.\n\uB2F4\uB2F9\uC790:
      \uBA3C\uC800 \uAE30\uBCF8\uBD80\uD130 \uBD05\uC2DC\uB2E4. \uCE58\uC988\uD53C\uC790
      \uD55C \uD310 \uAC00\uC838\uC624\uC138\uC694."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.briefing.Array.data[2]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB2F4\uB2F9\uC790: \uC81C\uB300\uB85C \uAD6C\uC6CC\uC11C \uC0C1\uC790\uC5D0
      \uB2F4\uC544 \uC624\uC138\uC694. \uBA40\uCA61\uD55C \uD53C\uC790\uB97C \uBC1B\uC73C\uBA74
      \uB0A9\uD488 \uBA85\uB2E8\uC5D0 \uC62C\uB824 \uB4DC\uB9AC\uC8E0."
    text: "\uB2F4\uB2F9\uC790: \uC81C\uB300\uB85C \uAD6C\uC6CC\uC11C \uC0C1\uC790\uC5D0
      \uB2F4\uC544 \uC624\uC138\uC694. \uBA40\uCA61\uD55C \uD53C\uC790\uB97C \uBC1B\uC73C\uBA74
      \uB0A9\uD488 \uBA85\uB2E8\uC5D0 \uC62C\uB824 \uB4DC\uB9AC\uC8E0."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.briefing.Array.data[3]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB098: \uD589\uC0AC\uC7A5 \uC548\uAE4C\uC9C0 \uAC00\uC838\uB2E4\uB4DC\uB9AC\uBA74
      \uB429\uB2C8\uAE4C?\n\uB2F4\uB2F9\uC790: \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0.
      \uC2B9\uC778\uBC1B\uC740 \uC5C5\uCCB4\uB9CC \uD589\uC0AC \uB54C \uC11C\uBE44\uC2A4
      \uCD9C\uC785\uAD6C\uB97C \uC4F8 \uC218 \uC788\uC5B4\uC694."
    text: "\uB098: \uD589\uC0AC\uC7A5 \uC548\uAE4C\uC9C0 \uAC00\uC838\uB2E4\uB4DC\uB9AC\uBA74
      \uB429\uB2C8\uAE4C?\n\uB2F4\uB2F9\uC790: \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0.
      \uC2B9\uC778\uBC1B\uC740 \uC5C5\uCCB4\uB9CC \uD589\uC0AC \uB54C \uC11C\uBE44\uC2A4
      \uCD9C\uC785\uAD6C\uB97C \uC4F8 \uC218 \uC788\uC5B4\uC694."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.approval.Array.data[0]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB2F4\uB2F9\uC790: \uD1A0\uD551\uB3C4 \uB9DE\uACE0, \uC0C1\uC790
      \uC548\uB3C4 \uBA40\uCA61\uD558\uB124\uC694. \uC88B\uC544\uC694. \uC815\uC2DD
      \uB0A9\uD488 \uC5C5\uCCB4\uB85C \uB4F1\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    text: "\uB2F4\uB2F9\uC790: \uD1A0\uD551\uB3C4 \uB9DE\uACE0, \uC0C1\uC790 \uC548\uB3C4
      \uBA40\uCA61\uD558\uB124\uC694. \uC88B\uC544\uC694. \uC815\uC2DD \uB0A9\uD488
      \uC5C5\uCCB4\uB85C \uB4F1\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.approval.Array.data[1]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB2F4\uB2F9\uC790: \uC774 \uC2B9\uC778\uC11C\uB97C \uAC00\uC838\uAC00\uC138\uC694.
      \uD589\uC0AC \uB2F9\uC77C \uBB3C\uD488 \uAC80\uC0AC\uAE4C\uC9C0 \uBA74\uC81C\uB418\uB294
      \uAC74 \uC544\uB2D9\uB2C8\uB2E4. \uC11C\uBE44\uC2A4 \uCD9C\uC785\uAD6C\uB85C
      \uC624\uC138\uC694."
    text: "\uB2F4\uB2F9\uC790: \uC774 \uC2B9\uC778\uC11C\uB97C \uAC00\uC838\uAC00\uC138\uC694.
      \uD589\uC0AC \uB2F9\uC77C \uBB3C\uD488 \uAC80\uC0AC\uAE4C\uC9C0 \uBA74\uC81C\uB418\uB294
      \uAC74 \uC544\uB2D9\uB2C8\uB2E4. \uC11C\uBE44\uC2A4 \uCD9C\uC785\uAD6C\uB85C
      \uC624\uC138\uC694."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.approval.Array.data[2]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB098: \uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC2DC\uAC04 \uB9DE\uCDB0
      \uC624\uC8E0."
    text: "\uB098: \uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC2DC\uAC04 \uB9DE\uCDB0 \uC624\uC8E0."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.ending.Array.data[0]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uBBFC\uAE30: \uB410\uC5B4?\n\uB098: \uAC00\uAC8C \uC774\uB984\uC73C\uB85C
      \uB0A9\uD488 \uC2B9\uC778\uC744 \uBC1B\uC558\uC5B4. \uC6B0\uB9AC \uC5BC\uAD74\uC740
      \uBAA8\uB974\uB294 \uB208\uCE58\uC57C."
    text: "\uBBFC\uAE30: \uB410\uC5B4?\n\uB098: \uAC00\uAC8C \uC774\uB984\uC73C\uB85C
      \uB0A9\uD488 \uC2B9\uC778\uC744 \uBC1B\uC558\uC5B4. \uC6B0\uB9AC \uC5BC\uAD74\uC740
      \uBAA8\uB974\uB294 \uB208\uCE58\uC57C."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.ending.Array.data[1]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uBBFC\uAE30: \uC88B\uC544. \uC870\uC9C1 \uC77C\uC744 \uB530\uC9C0\uB7EC
      \uC628 \uC0AC\uB78C\uC774 \uC544\uB2C8\uB77C \uBC30\uB2EC\uC6D0\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uB294 \uAC70\uC57C. \uBC15\uC9C4\uC6C5\uC774 \uC65C \uC6B0\uB9B4
      \uCAD3\uB294\uC9C0, \uC790\uAE30 \uC785\uC73C\uB85C \uB9D0\uD558\uB294 \uAC78
      \uB4E4\uC5B4\uC57C \uD574."
    text: "\uBBFC\uAE30: \uC88B\uC544. \uC870\uC9C1 \uC77C\uC744 \uB530\uC9C0\uB7EC
      \uC628 \uC0AC\uB78C\uC774 \uC544\uB2C8\uB77C \uBC30\uB2EC\uC6D0\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uB294 \uAC70\uC57C. \uBC15\uC9C4\uC6C5\uC774 \uC65C \uC6B0\uB9B4
      \uBC84\uB838\uB294\uC9C0, \uC790\uAE30 \uC785\uC73C\uB85C \uB9D0\uD558\uB294
      \uAC78 \uB4E4\uC5B4\uC57C \uD574."
  - id: 'Assets/Scenes/JJinCity.unity:Night Mission - Special Order.ending.Array.data[2]'
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB098: \uB4E4\uD0A4\uBA74?\n\uBBFC\uAE30: \uADF8\uB798\uC11C \uB0B4\uC77C
      \uBC24\uC5D4 \uC8FC\uBCC0\uBD80\uD130 \uC0B4\uD53C\uC790. \uB4E4\uC5B4\uAC08
      \uBB38, \uC228\uC744 \uACF3, \uB098\uC62C \uAE38. \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0
      \uD558\uC790."
    text: "\uB098: \uB4E4\uD0A4\uBA74?\n\uBBFC\uAE30: \uC548\uB4E4\uCF1C\uC57C\uC9C0.
      \uB0B4\uC77C \uBC24\uC5D4 \uC8FC\uBCC0\uBD80\uD130 \uC0B4\uD53C\uC790. \uB4E4\uC5B4\uAC08
      \uBB38, \uC228\uC744 \uACF3, \uB098\uC62C \uAE38. \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0
      \uD558\uC790."
  - id: Assets/Scripts/Mok/ShopUI/SpecialOrderMission.cs:50
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uC2E4\uC7A5\uC774 \uC5F0\uACB0\uD55C \uD589\uC0AC \uB0A9\uD488 \uB2F4\uB2F9\uC790\uB97C
      \uB9CC\uB098\uC138\uC694. \uC774\uBC88\uC5D0\uB294 \uC815\uC2DD \uBC30\uB2EC\uC6D0\uC73C\uB85C
      \uC811\uADFC\uD569\uB2C8\uB2E4."
    text: "\uC2E4\uC7A5\uC774 \uC5F0\uACB0\uD55C \uD589\uC0AC \uB0A9\uD488 \uB2F4\uB2F9\uC790\uB97C
      \uB9CC\uB098\uC138\uC694. \uC774\uBC88\uC5D0\uB294 \uC815\uC2DD \uBC30\uB2EC\uC6D0\uC73C\uB85C
      \uC811\uADFC\uD569\uB2C8\uB2E4."
  - id: Assets/Scripts/Mok/ShopUI/SpecialOrderMission.cs:69
    group: "05 \uD2B9\uBCC4 \uC8FC\uBB38"
    original: "\uB2F4\uB2F9\uC790: \uBC30\uB2EC\uD1B5\uC5D0 \uC788\uB2E4\uBA74 \uAEBC\uB0B4\uC11C
      \uC9C1\uC811 \uAC74\uB124\uC8FC\uC138\uC694. \uAD6C\uC6B4 \uCE58\uC988\uD53C\uC790
      \uD55C \uD310\uC785\uB2C8\uB2E4."
    text: "\uB2F4\uB2F9\uC790: \uBC30\uB2EC\uD1B5\uC5D0 \uC788\uB2E4\uBA74 \uAEBC\uB0B4\uC11C

    original: "\uACF5\uBC94\uACFC \uD568\uAED8 \uD0C8\uCD9C  /  {route}"
    text: "\uBBFC\uAE30\uC640 \uD568\uAED8 \uD0C8\uCD9C  /  {route}"
  - id: Assets/Scripts/Mok/Prologue/BankPrologue.cs:215

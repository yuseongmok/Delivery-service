    original: "\uD53C\uC790 \uBC30\uB2EC\uC6D0\uC73C\uB85C \uD589\uC0AC\uC7A5\uC5D0
      \uC7A0\uC785\uD574 \uBC15\uC9C4\uC6C5\uC758 \uACC4\uD68D\uC744 \uD655\uC778\uD558\uC138\uC694.
      \uBC1C\uAC01\uB418\uBA74 \uC900\uBE44\uD55C \uCC28\uB7C9\uC73C\uB85C \uD0C8\uCD9C\uD558\uACE0,
      \uBBFC\uAE30\uC640 \uD568\uAED8 \uB178\uCD9C\uB41C \uB9E4\uC7A5\uC744 \uB5A0\uB098\uC57C
      \uD569\uB2C8\uB2E4."
    text: "\uD53C\uC790 \uBC30\uB2EC\uC6D0\uC73C\uB85C \uD589\uC0AC\uC7A5\uC5D0 \uC7A0\uC785\uD574

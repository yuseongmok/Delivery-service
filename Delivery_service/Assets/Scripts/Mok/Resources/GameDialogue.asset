  - id: Assets/Scripts/Mok/ShopUI/VenueFinale.cs:136
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\n\uC900\uBE44 \uC131\uACFC\uB294 \uC720\uC9C0\uB429\uB2C8\uB2E4.

  entries:
  - id: BankPrologueStory.title
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uD504\uB864\uB85C\uADF8  /  \uD68C\uC218 \uC791\uC804"
    text: "\uD504\uB864\uB85C\uADF8  /  \uD68C\uC218 \uC791\uC804"
  - id: BankPrologueStory.vault.text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uAE08\uACE0\uB294 \uB0B4\uAC00 \uC5F4\uAC8C. \uB4A4\uB97C
      \uBD10 \uC918."
    text: "\uBBFC\uAE30: \uAE08\uACE0\uB294 \uB0B4\uAC00 \uC5F4\uAC8C. \uB4A4\uB97C
      \uBD10 \uC918."
  - id: BankPrologueStory.alarm.text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uACBD\uBCF4\uC57C! \uBE44\uC5B4 \uC788\uB2E4\uB354\uB2C8!
      \uB3C8\uC740 \uB0B4\uAC00 \uCC59\uAE38\uAC8C. \uCD9C\uAD6C\uB97C \uC9C0\uCF1C!"
    text: "\uBBFC\uAE30: \uACBD\uBCF4\uC57C! \uBE44\uC5B4 \uC788\uB2E4\uB354\uB2C8!
      \uB3C8\uC740 \uB0B4\uAC00 \uCC59\uAE38\uAC8C. \uCD9C\uAD6C\uB97C \uC9C0\uCF1C!"
  - id: BankPrologueStory.police.text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uC870\uC9C1\uC6D0: \uAE08\uACE0\uC5D0 \uCE68\uC785\uC790\uB2E4! \uC5BC\uAD74
      \uB611\uB611\uD788 \uBD24\uC5B4. \uCD9C\uAD6C \uB9C9\uC544!"
    text: "\uC870\uC9C1\uC6D0: \uAE08\uACE0\uC5D0 \uCE68\uC785\uC790\uB2E4! \uCD9C\uAD6C
      \uB9C9\uC544!"
  - id: BankPrologueStory.breather
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC7A0\uAE50 \uB738\uD574\uC84C\uC5B4! \uC7A5\uC804\uD574,
      \uB0B4\uAC00 \uC11C\uB450\uB97C\uAC8C!"
    text: "\uBBFC\uAE30: \uC7A0\uAE50 \uB738\uD574\uC84C\uC5B4! \uC7A5\uC804\uD574,
      \uB0B4\uAC00 \uC11C\uB450\uB97C\uAC8C!"
  - id: BankPrologueStory.reinforcement
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uC870\uC9C1\uC6D0: \uC9C0\uC6D0 \uC654\uB2E4! \uAE08\uACE0 \uCABD\uC73C\uB85C
      \uB4E4\uC5B4\uAC00!"
    text: "\uC870\uC9C1\uC6D0: \uC9C0\uC6D0 \uC654\uB2E4! \uAE08\uACE0 \uCABD\uC73C\uB85C
      \uB4E4\uC5B4\uAC00!"
  - id: BankPrologueStory.finalPressure
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uAC70\uC758 \uB2E4 \uB2F4\uC558\uC5B4! \uC870\uAE08\uB9CC
      \uB354 \uBC84\uD168!"
    text: "\uBBFC\uAE30: \uAC70\uC758 \uB2E4 \uB2F4\uC558\uC5B4! \uC870\uAE08\uB9CC
      \uB354 \uBC84\uD168!"
  - id: BankPrologueStory.collect
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uB188\uB4E4\uC774 \uBAB0\uB824\uC628\uB2E4! \uAC00\uBC29\uC740
      \uB0B4\uAC00 \uCC59\uAE38\uAC8C!"
    text: "\uBBFC\uAE30: \uB188\uB4E4\uC774 \uBAB0\uB824\uC628\uB2E4! \uAC00\uBC29\uC740
      \uB0B4\uAC00 \uCC59\uAE38\uAC8C!"
  - id: BankPrologueStory.escape
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uB2E4 \uCC59\uACBC\uC5B4! \uAC19\uC774 \uCC28\uB85C
      \uAC00\uC790!"
    text: "\uBBFC\uAE30: \uB2E4 \uCC59\uACBC\uC5B4! \uAC19\uC774 \uCC28\uB85C \uAC00\uC790!"
  - id: 'BankPrologueStory.routeNames.Array.data[0]'
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uC624\uB978\uCABD \uBCF4\uC548 \uD1B5\uB85C"
    text: "\uC624\uB978\uCABD \uBCF4\uC548 \uD1B5\uB85C"
  - id: 'BankPrologueStory.routeNames.Array.data[1]'
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uC67C\uCABD \uC0AC\uBB34\uC2E4 \uD1B5\uB85C"
    text: "\uC67C\uCABD \uC0AC\uBB34\uC2E4 \uD1B5\uB85C"
  - id: 'BankPrologueStory.routeNames.Array.data[3]'
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uC815\uBB38 \uC55E \uB3C4\uC8FC \uCC28\uB7C9"
    text: "\uC815\uBB38 \uC55E \uB3C4\uC8FC \uCC28\uB7C9"
  - id: 'BankPrologueStory.routeLines.Array.data[0]'
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC624\uB978\uCABD \uD1B5\uB85C\uC57C! \uAE30\uB465
      \uB4A4\uB85C \uC228\uC5B4\uC11C \uC6C0\uC9C1\uC5EC!"
    text: "\uBBFC\uAE30: \uC624\uB978\uCABD \uD1B5\uB85C\uC57C! \uAE30\uB465 \uB4A4\uB85C
      \uC228\uC5B4\uC11C \uC6C0\uC9C1\uC5EC!"
  - id: 'BankPrologueStory.routeLines.Array.data[1]'
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC0AC\uBB34\uC2E4\uC744 \uAC00\uB85C\uC9C8\uB7EC \uC67C\uCABD\uC73C\uB85C!"
    text: "\uBBFC\uAE30: \uC0AC\uBB34\uC2E4\uC744 \uAC00\uB85C\uC9C8\uB7EC \uC67C\uCABD\uC73C\uB85C!"
  - id: 'BankPrologueStory.routeLines.Array.data[2]'
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uB9C8\uC9C0\uB9C9 \uD640\uC774\uC57C. \uC624\uB978\uCABD
      \uC815\uBB38\uC73C\uB85C \uB098\uC640!"
    text: "\uBBFC\uAE30: \uB9C8\uC9C0\uB9C9 \uD640\uC774\uC57C. \uC624\uB978\uCABD
      \uC815\uBB38\uC73C\uB85C \uB098\uC640!"
  - id: 'BankPrologueStory.routeLines.Array.data[3]'
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uCC28\uAC00 \uBC14\uB85C \uC55E\uC774\uC57C. \uB6F0\uC5B4!"
    text: "\uBBFC\uAE30: \uCC28\uAC00 \uBC14\uB85C \uC55E\uC774\uC57C. \uB6F0\uC5B4!
      F\uB97C \uB20C\uB7EC \uD0D1\uC2B9\uD574!"
  - id: BankPrologueStory.carConversation.Array.data[0].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB098: \uBE44\uC5B4 \uC788\uB294 \uAE08\uACE0\uB77C\uB354\uB2C8,
      \uBB34\uC7A5\uD55C \uB188\uB4E4\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC796\uC544!"
    text: "\uB098: \uBE44\uC5B4 \uC788\uB294 \uAE08\uACE0\uB77C\uB354\uB2C8, \uBB34\uC7A5\uD55C
      \uB188\uB4E4\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC796\uC544!"
  - id: BankPrologueStory.carConversation.Array.data[1].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC2E4\uC7A5\uC774 \uBE7C\uC557\uAE34 \uB3C8\uB9CC \uD68C\uC218\uD558\uBA74
      \uB41C\uB2E4\uACE0 \uD588\uC5B4. \uC57C\uB9C8\uC790\uD0A4 \uB188\uB4E4\uC740
      \uC9C0\uAE08 \uB2E4\uB978\uACF3\uC5D0 \uC788\uB2E4\uACE0.."
    text: "\uBBFC\uAE30: \uC2E4\uC7A5\uC774 \uBE7C\uC557\uAE34 \uB3C8\uB9CC \uD68C\uC218\uD558\uBA74
      \uB41C\uB2E4\uACE0 \uD588\uC5B4. \uC57C\uB9C8\uC790\uD0A4 \uB188\uB4E4\uC740
      \uC9C0\uAE08 \uB2E4\uB978\uACF3\uC5D0 \uC788\uB2E4\uACE0.."
  - id: BankPrologueStory.carConversation.Array.data[2].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB098: \uC800\uCABD \uC870\uC9C1\uC774 \uC6B0\uB9AC \uC5BC\uAD74\uAE4C\uC9C0
      \uBD24\uC5B4. \uC2E4\uC7A5\uC740 \uBB50\uB798?"
    text: "\uB098: \uC57C\uB9C8\uC790\uD0A4 \uB188\uB4E4\uC774 \uC6B0\uB9AC \uC5BC\uAD74\uAE4C\uC9C0
      \uBD24\uC5B4... \uC2E4\uC7A5\uC740 \uBB50\uB798?"
  - id: BankPrologueStory.carConversation.Array.data[3].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC804\uD654\uAC00 \uC548 \uB3FC. \uC57D\uC18D \uC7A5\uC18C\uC5D0\uB3C4
      \uC5C6\uB300."
    text: "\uBBFC\uAE30: \uC804\uD654\uAC00 \uC548 \uB3FC. \uC57D\uC18D \uC7A5\uC18C\uC5D0\uB3C4
      \uC5C6\uB300."
  - id: BankPrologueStory.carConversation.Array.data[4].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB098: \uC6B0\uB9AC\uAC00 \uBBF8\uB07C\uC600\uB358 \uAC74\uAC00?"
    text: "\uB098: \uC6B0\uB9AC\uAC00 \uBBF8\uB07C\uC600\uB358 \uAC74\uAC00?"
  - id: BankPrologueStory.carConversation.Array.data[5].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC5BC\uAD74\uC774 \uB178\uCD9C\uB410\uC5B4. \uC5F0\uB77D\uC774
      \uB2E4\uC2DC \uB2FF\uC744 \uB54C\uAE4C\uC9C0 \uC228\uC5B4 \uC788\uC5B4\uC57C
      \uD574."
    text: "\uBBFC\uAE30: \uC5BC\uAD74\uC774 \uB178\uCD9C\uB410\uC5B4. \uC5F0\uB77D\uC774
      \uB2E4\uC2DC \uB2FF\uC744 \uB54C\uAE4C\uC9C0 \uC228\uC5B4 \uC788\uC5B4\uC57C
      \uD574."
  - id: BankPrologueStory.carConversation.Array.data[6].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC544\uBC84\uC9C0\uAC00 \uD558\uB358 \uD53C\uC790 \uAC00\uAC8C\uAC00
      \uC788\uC5B4. \uAC70\uAE30\uB85C \uAC00\uC790."
    text: "\uBBFC\uAE30: \uC544\uBC84\uC9C0\uAC00 \uD558\uB358 \uD53C\uC790 \uAC00\uAC8C\uAC00
      \uC788\uC5B4. \uAC70\uAE30\uB85C \uAC00\uC790."
  - id: BankPrologueStory.shopConversation.Array.data[0].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB098: \uC5EC\uAE30\uC11C \uD53C\uC790 \uC7A5\uC0AC\uB97C \uD558\uC790\uACE0?"
    text: "\uB098: \uC5EC\uAE30\uC11C \uD53C\uC790 \uC7A5\uC0AC\uB97C \uD558\uC790\uACE0?"
  - id: BankPrologueStory.shopConversation.Array.data[1].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC544\uBC84\uC9C0\uAC00 \uC811\uC740 \uAC00\uAC8C\uC57C.
      \uC5F4\uC1E0\uB791 \uC870\uB9AC\uBC95\uC740 \uB0A8\uC544 \uC788\uC5B4."
    text: "\uBBFC\uAE30: \uC544\uBC84\uC9C0\uAC00 \uC811\uC740 \uAC00\uAC8C\uC57C.
      \uC5F4\uC1E0\uB791 \uC870\uB9AC\uBC95\uC740 \uB0A8\uC544 \uC788\uC5B4."
  - id: BankPrologueStory.shopConversation.Array.data[2].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC800\uCABD\uC740 \uAE08\uACE0\uB97C \uD134 \uB450
      \uB188\uC744 \uCC3E\uACA0\uC9C0. \uC6B0\uB9B0 \uD3C9\uBC94\uD55C \uAC00\uAC8C
      \uC8FC\uC778\uACFC \uBC30\uB2EC\uC6D0\uC778 \uAC70\uC57C."
    text: "\uBBFC\uAE30: \uC800\uCABD\uC740 \uAE08\uACE0\uB97C \uD134 \uB450 \uB188\uC744
      \uCC3E\uACA0\uC9C0. \uC6B0\uB9B0 \uD3C9\uBC94\uD55C \uAC00\uAC8C \uC8FC\uC778\uACFC
      \uBC30\uB2EC\uC6D0\uC778 \uAC70\uC57C."
  - id: BankPrologueStory.shopConversation.Array.data[3].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB098: \uCC59\uACA8 \uC628 \uB3C8\uC740?"
    text: "\uB098: \uCC59\uACA8 \uC628 \uB3C8\uC740?"
  - id: BankPrologueStory.shopConversation.Array.data[4].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uB530\uB85C \uC228\uACA8 \uB458\uAC8C. \uC5B4\uB5A4
      \uB3C8\uC778\uC9C0\uBD80\uD130 \uD655\uC778\uD574\uC57C \uD574. \uC9C0\uAE08
      \uC4F0\uBA74 \uAF2C\uB9AC\uB97C \uC7A1\uD790 \uC218\uB3C4 \uC788\uC5B4."
    text: "\uBBFC\uAE30: \uB530\uB85C \uC228\uACA8 \uB458\uAC8C. \uC5B4\uB5A4 \uB3C8\uC778\uC9C0\uBD80\uD130
      \uD655\uC778\uD574\uC57C \uD574. \uC9C0\uAE08 \uC4F0\uBA74 \uAF2C\uB9AC\uB97C
      \uC7A1\uD790 \uC218\uB3C4 \uC788\uC5B4."
  - id: BankPrologueStory.shopConversation.Array.data[5].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB098: \uAC00\uBC29\uC740 \uAF49 \uCC3C\uB294\uB370 \uC6B0\uB9B0
      \uBE48\uD138\uD130\uB9AC\uB124."
    text: "\uB098: \uAC00\uBC29\uC740 \uAF49 \uCC3C\uB294\uB370 \uC6B0\uB9B0 \uBE48\uD138\uD130\uB9AC\uB124."
  - id: BankPrologueStory.shopConversation.Array.data[6].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uB0B4 \uBE44\uC0C1\uAE08\uC73C\uB85C \uC7AC\uB8CC\uBD80\uD130
      \uC0AC\uC790. \uBC30\uB2EC \uC624\uD1A0\uBC14\uC774\uB3C4 \uC5EC\uAE30 \uC788\uACE0."
    text: "\uBBFC\uAE30: \uB0B4 \uBE44\uC0C1\uAE08\uC73C\uB85C \uC7AC\uB8CC\uBD80\uD130
      \uC0AC\uC790. \uBC30\uB2EC \uC624\uD1A0\uBC14\uC774\uB3C4 \uC5EC\uAE30 \uC788\uACE0."
  - id: BankPrologueStory.shopConversation.Array.data[7].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB098: \uADF8\uB0E5 \uBB38 \uC7A0\uADF8\uACE0 \uAE30\uB2E4\uB9AC\uBA74
      \uC548 \uB3FC?"
    text: "\uB098: \uADF8\uB0E5 \uBB38 \uC7A0\uADF8\uACE0 \uAE30\uB2E4\uB9AC\uBA74
      \uC548 \uB3FC?"
  - id: BankPrologueStory.shopConversation.Array.data[8].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC228\uC5B4\uB9CC \uC788\uC73C\uBA74 \uB354 \uC218\uC0C1\uD574.
      \uC7A5\uC0AC\uB85C \uC0DD\uD65C\uBE44\uB97C \uBC8C\uBA74\uC11C \uC2E4\uC7A5
      \uC5F0\uB77D\uC744 \uAE30\uB2E4\uB9AC\uB294 \uAC70\uC57C."
    text: "\uBBFC\uAE30: \uC228\uC5B4\uB9CC \uC788\uC73C\uBA74 \uB354 \uC218\uC0C1\uD574.
      \uC7A5\uC0AC\uB85C \uC0DD\uD65C\uBE44\uB97C \uBC8C\uBA74\uC11C \uC2E4\uC7A5
      \uC5F0\uB77D\uC744 \uAE30\uB2E4\uB9AC\uB294 \uAC70\uC57C."
  - id: BankPrologueStory.shopConversation.Array.data[9].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB098: \uB124\uAC00 \uD53C\uC790\uB294 \uB9CC\uB4E4 \uC904 \uC54C\uACE0?"
    text: "\uB098: \uB124\uAC00 \uD53C\uC790\uB294 \uB9CC\uB4E4 \uC904 \uC54C\uACE0?"
  - id: BankPrologueStory.shopConversation.Array.data[10].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC5B4\uB9B4 \uB54C \uC9C0\uACB9\uAC8C \uB3C4\uC654\uC5B4.
      \uB0B4\uC77C\uC740 \uB124 \uCC28\uB840\uC57C."
    text: "\uBBFC\uAE30: \uC5B4\uB9B4 \uB54C \uC9C0\uACB9\uAC8C \uB3C4\uC654\uC5B4.
      \uB0B4\uC77C\uC740 \uB124 \uCC28\uB840\uC57C."
  - id: BankPrologueStory.shopConversation.Array.data[11].text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB098: \uC88B\uC544. \uB2F9\uBD84\uAC04\uC740 \uD3C9\uBC94\uD55C
      \uBC30\uB2EC\uC6D0\uC73C\uB85C \uC9C0\uB0B4 \uBCF4\uC790."
    text: "\uB098: \uC88B\uC544. \uB2F9\uBD84\uAC04\uC740 \uD3C9\uBC94\uD55C \uBC30\uB2EC\uC6D0\uC73C\uB85C
      \uC9C0\uB0B4 \uBCF4\uC790."
  - id: BankPrologueStory.boarding.text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uB098\uB3C4 \uD0D4\uC5B4. \uCD9C\uBC1C\uD574!"
    text: "\uBBFC\uAE30: \uB098\uB3C4 \uD0D4\uC5B4. \uCD9C\uBC1C\uD574!"
  - id: BankPrologueStory.getaway.text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uC5BC\uAD74\uC744 \uC228\uAE30\uACE0 \uC2E4\uC7A5\uC758 \uC5F0\uB77D\uC744
      \uAE30\uB2E4\uB9AC\uAE30 \uC704\uD574, \uC6B0\uB9AC\uB294 \uD53C\uC790 \uAC00\uAC8C
      \uBB38\uC744 \uB2E4\uC2DC \uC5F4\uC5C8\uB2E4."
    text: "\uC5BC\uAD74\uC744 \uC228\uAE30\uACE0 \uC2E4\uC7A5\uC758 \uC5F0\uB77D\uC744
      \uAE30\uB2E4\uB9AC\uAE30 \uC704\uD574, \uC6B0\uB9AC\uB294 \uD53C\uC790 \uAC00\uAC8C
      \uBB38\uC744 \uB2E4\uC2DC \uC5F4\uC5C8\uB2E4."
  - id: BankPrologueStory.ending.text
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB2E4\uC74C \uB0A0 \uC544\uCE68\n\n\uCCAB \uC601\uC5C5\uC77C"
    text: "\uB2E4\uC74C \uB0A0 \uC544\uCE68\n\n\uCCAB \uC601\uC5C5\uC77C"
  - id: BankPrologueStory.driving
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uBBFC\uAE30: \uC55E\uC5D0 \uCC28\uB4E4\uC740 \uD53C\uD574 \uAC00!
      \uB9C8\uC9C0\uB9C9 \uBD09\uC1C4\uB294 \uC18D\uB3C4 \uBD99\uC5EC\uC11C \uBC00\uC5B4\uBC84\uB824!"
    text: "\uBBFC\uAE30: \uC55E\uC5D0 \uB188\uB4E4\uC774\uC57C! \uC18D\uB3C4 \uBD99\uC5EC\uC11C
      \uBC00\uC5B4\uBC84\uB824!"
  - id: BankPrologueStory.failure
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uD0C8\uCD9C\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
    text: "\uD0C8\uCD9C\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  - id: Assets/Scripts/Mok/Prologue/BankPrologue.cs:125
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "Space  \uCEF7\uC2E0 \uAC74\uB108\uB6F0\uAE30"
    text: "Space  \uCEF7\uC2E0 \uAC74\uB108\uB6F0\uAE30"
  - id: Assets/Scripts/Mok/Prologue/BankPrologue.cs:198
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uACF5\uBC94\uC774 \uB3C8\uC744 \uCC59\uAE30\uB294 \uB3D9\uC548 \uC870\uC9C1\uC6D0\uB4E4\uC744
      \uB9C9\uC73C\uC138\uC694   {Collected} / {cash.Length}"
    text: "\uBBFC\uAE30\uAC00 \uB3C8\uC744 \uCC59\uAE30\uB294 \uB3D9\uC548 \uC870\uC9C1\uC6D0\uB4E4\uC744
      \uB9C9\uC73C\uC138\uC694   {Collected} / {cash.Length}"

    original: "\uC900\uBE44\uB294 \uB05D\uB0AC\uC5B4. \uB0B4\uC77C\uC740 \uC601\uC5C5\uC744
      \uC26C\uACE0 \uD589\uC0AC\uC7A5\uC5D0 \uB4E4\uC5B4\uAC00\uC790. \uD734\uB300\uD3F0\uC5D0\uC11C
      \u2018\uB9C8\uC9C0\uB9C9 \uBC30\uB2EC\u2019\uC744 \uC120\uD0DD\uD558\uBA74
      \uB2E4\uC74C \uB0A0\uB85C \uB118\uC5B4\uAC00. \uBC15\uC9C4\uC6C5\uC774 \uC65C
      \uC6B0\uB9B4 \uCAD3\uB294\uC9C0 \uC54C\uC544\uB0B4\uC57C \uD574."
    text: "\uC900\uBE44\uB294 \uB05D\uB0AC\uC5B4. \uB0B4\uC77C\uC740 \uC601\uC5C5\uC744

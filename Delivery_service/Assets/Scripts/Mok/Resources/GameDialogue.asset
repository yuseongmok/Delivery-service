  - id: Assets/Scripts/Mok/ShopUI/VenueFinale.cs:73
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uB124\uAC00 \uBE60\uC838\uB098\uC624\uB294 \uB3D9\uC548 \uB0A8\uC740
      \uD1B5\uC2E0\uC744 \uB4E4\uC5C8\uC5B4. \uBC15\uC9C4\uC6C5\uC774 \uC6B0\uB9B4
      \uBCF4\uB0B4 \uC57C\uB9C8\uC790\uD0A4\uC640 \uC2F8\uC6C0\uC744 \uBD99\uC600\uC5B4.
      \uD63C\uB780 \uC18D\uC5D0\uC11C \uC6B0\uB9AC \uBCF4\uC2A4\uB97C \uC81C\uAC70\uD558\uACE0
      \uB450\uBAA9\uC774 \uB418\uB824\uB294 \uAC70\uC57C. \uC6B0\uB9AC\uC640 \uC2E4\uC7A5\uB3C4
      \uC5C6\uC560\uB77C\uACE0 \uD588\uC5B4. \uC9C0\uAE08\uC740 \uC0B4\uC544\uC11C
      \uB098\uC640!"
    text: "\uB124\uAC00 \uBE60\uC838\uB098\uC624\uB294 \uB3D9\uC548 \uB0A8\uC740
      \uD1B5\uC2E0\uC744 \uB4E4\uC5C8\uC5B4. \uBC15\uC9C4\uC6C5\uC774 \uC6B0\uB9B4
      \uBCF4\uB0B4 \uC57C\uB9C8\uC790\uD0A4\uC640 \uC2F8\uC6C0\uC744 \uBD99\uC600\uC5B4.
      \uD63C\uB780 \uC18D\uC5D0\uC11C \uC6B0\uB9AC \uBCF4\uC2A4\uB97C \uC81C\uAC70\uD558\uACE0
      \uB450\uBAA9\uC774 \uB418\uB824\uB294 \uAC70\uC57C. \uC6B0\uB9AC\uC640 \uC2E4\uC7A5\uB3C4
      \uC5C6\uC560\uB77C\uACE0 \uD588\uC5B4. \uC9C0\uAE08\uC740 \uC0B4\uC544\uC11C
      \uB098\uC640!"
  - id: Assets/Scripts/Mok/ShopUI/VenueFinale.cs:76

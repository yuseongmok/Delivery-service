  - id: 'Assets/Scenes/JJinCity.unity:First Event - Last Delivery.closing.Array.data[5]'
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uBBFC\uAE30: \uAC00\uBC29\uB9CC \uCC59\uACA8. \uC5F0\uB77D\uC744
      \uAE30\uB2E4\uB9B4 \uB54C\uAC00 \uC544\uB2C8\uC57C. \uC9C0\uAE08 \uB5A0\uB098\uC790."
    text: "\uBBFC\uAE30: \uAC00\uBC29\uB9CC \uCC59\uACA8. \uC9C0\uAE08 \uB5A0\uB098\uC57C\uD574."
  - id: FirstChapterPreparation.chapterTitle
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uCCAB \uBC88\uC9F8 \uC0AC\uAC74 \xB7 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC"
    text: "\uCCAB \uBC88\uC9F8 \uC0AC\uAC74 \xB7 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC"
  - id: FirstChapterPreparation.premise
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uBC15\uC9C4\uC6C5\uC758 \uC9C0\uC2DC\uB85C \uC57C\uB9C8\uC790\uD0A4\uD30C\uC758
      \uAE08\uACE0\uC5D0\uC11C \uBE7C\uC557\uAE34 \uB3C8\uC744 \uD68C\uC218\uD588\uC9C0\uB9CC,
      \uC784\uBB34 \uC774\uD6C4 \uC2E4\uC7A5\uACFC \uC5F0\uB77D\uC774 \uB04A\uACBC\uC2B5\uB2C8\uB2E4.
      \uC5BC\uAD74\uC774 \uB178\uCD9C\uB41C \uB450 \uC0AC\uB78C\uC740 \uC5F0\uB77D\uC774
      \uB2E4\uC2DC \uB2FF\uC744 \uB54C\uAE4C\uC9C0 \uC2A4\uC2A4\uB85C \uD53C\uC790
      \uAC00\uAC8C\uC5D0\uC11C \uC704\uC7A5 \uC0DD\uD65C\uC744 \uD558\uAE30\uB85C
      \uD569\uB2C8\uB2E4. \uB0AE\uC5D0\uB294 \uC0DD\uD65C\uBE44\uC640 \uC900\uBE44
      \uBE44\uC6A9\uC744 \uBC8C\uACE0, \uBC24\uC5D0\uB294 \uC5F0\uB77D\uC774 \uB04A\uAE34
      \uC774\uC720\uB97C \uCD94\uC801\uD569\uB2C8\uB2E4."
    text: "\uBC15\uC9C4\uC6C5\uC758 \uC9C0\uC2DC\uB85C \uC57C\uB9C8\uC790\uD0A4\uD30C\uC758
      \uAE08\uACE0\uC5D0\uC11C \uB3C8\uC744 \uD68C\uC218\uD588\uC9C0\uB9CC, \uC784\uBB34
      \uC774\uD6C4 \uC2E4\uC7A5\uACFC \uC5F0\uB77D\uC774 \uB04A\uACBC\uC2B5\uB2C8\uB2E4.
      \uC5BC\uAD74\uC774 \uB178\uCD9C\uB41C \uB450 \uC0AC\uB78C\uC740 \uC5F0\uB77D\uC774
      \uB2E4\uC2DC \uB2FF\uC744 \uB54C\uAE4C\uC9C0 \uC2A4\uC2A4\uB85C \uD53C\uC790
      \uAC00\uAC8C\uC5D0\uC11C \uC704\uC7A5 \uC0DD\uD65C\uC744 \uD558\uAE30\uB85C
      \uD569\uB2C8\uB2E4. \uB0AE\uC5D0\uB294 \uC0DD\uD65C\uBE44\uC640 \uC900\uBE44
      \uBE44\uC6A9\uC744 \uBC8C\uACE0, \uBC24\uC5D0\uB294 \uC5F0\uB77D\uC774 \uB04A\uAE34
      \uC774\uC720\uB97C \uCD94\uC801\uD569\uB2C8\uB2E4."
  - id: FirstChapterPreparation.missions.Array.data[0].title
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    text: "\uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
  - id: FirstChapterPreparation.missions.Array.data[0].description
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uC5F0\uB77D\uC774 \uB04A\uACBC\uB358 \uC2E4\uC7A5\uC774 \uC790\uC2E0\uC744
      \uC81C\uAC70\uD558\uB824\uB294 \uC870\uC9C1\uC744 \uD53C\uD574 \uB9CC\uB098\uC790\uACE0
      \uBB38\uC790\uB97C \uBCF4\uB0C8\uC2B5\uB2C8\uB2E4. \uC57D\uC18D\uD55C \uB0A0
      \uBC24\uC5D0 \uCC3E\uC544\uAC00 \uD568\uAED8 \uD0C8\uCD9C\uD558\uC138\uC694."
    text: "\uC5F0\uB77D\uC774 \uB04A\uACBC\uB358 \uC2E4\uC7A5\uC774 \uC790\uC2E0\uC744
      \uC81C\uAC70\uD558\uB824\uB294 \uC870\uC9C1\uC744 \uD53C\uD574 \uB9CC\uB098\uC790\uACE0
      \uBB38\uC790\uB97C \uBCF4\uB0C8\uC2B5\uB2C8\uB2E4. \uC57D\uC18D\uD55C \uB0A0
      \uBC24\uC5D0 \uCC3E\uC544\uAC00 \uD568\uAED8 \uD0C8\uCD9C\uD558\uC138\uC694."
  - id: FirstChapterPreparation.missions.Array.data[0].result
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uBC15\uC9C4\uC6C5\uC758 \uD589\uC0AC \uC815\uBCF4\uC640 \uB0A9\uD488

      \uBC8C\uACE0, \uBC24\uB9C8\uB2E4 \uD55C \uAC00\uC9C0\uC529 \uB2E8\uC11C\uB97C
      \uCAD3\uC544 \uBC15\uC9C4\uC6C5\uC758 \uC18D\uB0B4\uB97C \uC54C\uC544\uB0C5\uB2C8\uB2E4."
    text: "\uC870\uC9C1\uC758 \uC758\uB8B0\uB85C \uBE7C\uC557\uAE34 \uB3C8\uC744
      \uD68C\uC218\uD558\uB7EC \uAC14\uC9C0\uB9CC \uBCF4\uC218\uB3C4 \uC5F0\uB77D\uB3C4
      \uB04A\uACBC\uC2B5\uB2C8\uB2E4. \uB0AE\uC5D0\uB294 \uD53C\uC790 \uAC00\uAC8C\uB85C
      \uC704\uC7A5\uD558\uBA70 \uC0DD\uD65C\uBE44\uC640 \uC900\uBE44 \uBE44\uC6A9\uC744
      \uBC8C\uACE0, \uBC24\uB9C8\uB2E4 \uD55C \uAC00\uC9C0\uC529 \uB2E8\uC11C\uB97C
      \uCAD3\uC544 \uBC15\uC9C4\uC6C5\uC758 \uC18D\uB0B4\uB97C \uC54C\uC544\uB0C5\uB2C8\uB2E4."
  - id: Assets/Scripts/Mok/ShopUI/VenueFinale.cs:41
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uB2E4\uC74C \uB0A0 \uC804\uD658\uC744 \uC644\uB8CC\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    text: "\uB2E4\uC74C \uB0A0 \uC804\uD658\uC744 \uC644\uB8CC\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  - id: Assets/Scripts/Mok/ShopUI/VenueFinale.cs:51
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uACBD\uBE44: \uB0A9\uD488 \uBA85\uB2E8 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.
      \uD53C\uC790\uB294 \uC11C\uBE44\uC2A4 \uD14C\uC774\uBE14\uC5D0 \uB193\uACE0
      \uBC14\uB85C \uB098\uC624\uC138\uC694."
    text: "\uACBD\uBE44: \uB0A9\uD488 \uBA85\uB2E8 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.
      \uD53C\uC790\uB294 \uC11C\uBE44\uC2A4 \uD14C\uC774\uBE14\uC5D0 \uB193\uACE0
      \uBC14\uB85C \uB098\uC624\uC138\uC694."
  - id: Assets/Scripts/Mok/ShopUI/VenueFinale.cs:52
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uBBFC\uAE30: \uC548\uCABD\uC774 VIP \uD589\uC0AC\uC7A5\uC774\uC57C.
      \uC21C\uCC30\uC774 \uC9C0\uB098\uAC00\uBA74 \uC6C0\uC9C1\uC5EC. \uAE30\uB465
      \uC606\uC774\uB098 \uC11C\uBE44\uC2A4 \uD1B5\uB85C\uC5D0\uC11C \uB300\uD654\uB97C
      \uB4E4\uC5B4\uBD10."
    text: "\uBBFC\uAE30: \uC548\uCABD\uC774 VIP \uD589\uC0AC\uC7A5\uC774\uC57C. \uC21C\uCC30\uC774
      \uC9C0\uB098\uAC00\uBA74 \uC6C0\uC9C1\uC5EC. \uAE30\uB465 \uC606\uC774\uB098
      \uC11C\uBE44\uC2A4 \uD1B5\uB85C\uC5D0\uC11C \uB300\uD654\uB97C \uB4E4\uC5B4\uBD10."
  - id: Assets/Scripts/Mok/ShopUI/VenueFinale.cs:54
    group: "08 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC \xB7 \uC2A4\uD1A0\uB9AC \uC548\uB0B4"
    original: "\uCD9C\uAD6C \uBD09\uC1C4 \xB7 \uACBD\uBE44\uB97C 2\uBA85 \uC81C\uC555\uD574

    original: "F  \uACF5\uBC94\uACFC \uB3C4\uC8FC \uCC28\uB7C9 \uD0D1\uC2B9"
    text: "F  \uACF5\uBC94\uACFC \uB3C4\uC8FC \uCC28\uB7C9 \uD0D1\uC2B9"
  - id: Assets/Scripts/Mok/Prologue/BankPrologue.cs:327
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uB2E4\uC74C \uB0A0 \uC544\uCE68\n\uC774\uC58F\uD638 \uD53C\uC790,
      \uCCAB \uC601\uC5C5\uC77C"
    text: "\uB2E4\uC74C \uB0A0 \uC544\uCE68\n\uCCAB \uC601\uC5C5\uC77C"
  - id: Assets/Scripts/Mok/Prologue/BankPrologue.cs:337
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "R  \uD68C\uC218 \uC791\uC804 \uB2E4\uC2DC \uC2DC\uC791"
    text: "R  \uD68C\uC218 \uC791\uC804 \uB2E4\uC2DC \uC2DC\uC791"
  - id: Assets/Scripts/Mok/Prologue/BankPrologue.cs:344
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uC77C\uC2DC\uC815\uC9C0\n\nEnter  \uACC4\uC18D\uD558\uAE30\nR  \uD504\uB864\uB85C\uADF8
      \uB2E4\uC2DC \uC2DC\uC791\nL  \uB85C\uBE44\uB85C \uB3CC\uC544\uAC00\uAE30"
    text: "\uC77C\uC2DC\uC815\uC9C0\n\nEnter  \uACC4\uC18D\uD558\uAE30\nR  \uD504\uB864\uB85C\uADF8
      \uB2E4\uC2DC \uC2DC\uC791\nL  \uB85C\uBE44\uB85C \uB3CC\uC544\uAC00\uAE30"
  - id: Assets/Scripts/Mok/Prologue/BankPrologue.cs:352
    group: "01 \uD504\uB864\uB85C\uADF8"
    original: "\uC52C \uC5F0\uACB0\uC744 \uD655\uC778\uD574 \uC8FC\uC138\uC694."
    text: "\uC52C \uC5F0\uACB0\uC744 \uD655\uC778\uD574 \uC8FC\uC138\uC694."
  - id: Assets/Scenes/BankPrologue.unity:Prologue Director.supportLine
    group: "02 \uD504\uB864\uB85C\uADF8 \uCC28\uB7C9 \uD0C8\uCD9C"
    original: "\uBBFC\uAE30: \uC6B4\uC804\uC5D0 \uC9D1\uC911\uD574! \uB4A4\uB294
      \uB0B4\uAC00 \uB9E1\uC744\uAC8C!"
    text: "\uBBFC\uAE30: \uC6B4\uC804\uC5D0 \uC9D1\uC911\uD574! \uB4A4\uB294 \uB0B4\uAC00
      \uB9E1\uC744\uAC8C!"
  - id: Assets/Scenes/BankPrologue.unity:Prologue Director.clearLine
    group: "02 \uD504\uB864\uB85C\uADF8 \uCC28\uB7C9 \uD0C8\uCD9C"
    original: "\uBBFC\uAE30: \uB530\uB3CC\uB838\uC5B4. \uADF8\uB300\uB85C \uAC00!"
    text: "\uBBFC\uAE30: \uB530\uB3CC\uB838\uC5B4. \uADF8\uB300\uB85C \uAC00!"
  - id: Assets/Scripts/Mok/Prologue/PrologueEscapePerformance.cs:70
    group: "02 \uD504\uB864\uB85C\uADF8 \uCC28\uB7C9 \uD0C8\uCD9C"
    original: "\uBBFC\uAE30: \uB9C8\uC9C0\uB9C9 \uBD09\uC1C4\uC57C! \uC18D\uB3C4
      \uBD99\uC5EC\uC11C \uAC00\uC6B4\uB370\uB97C \uB6AB\uC5B4!"
    text: "\uBBFC\uAE30: \uC18D\uB3C4 \uBD99\uC5EC\uC11C \uAC00\uC6B4\uB370\uB97C
      \uB6AB\uC5B4!"
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[0]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uB098: \uC5B4\uB514\uC11C\uBD80\uD130 \uD558\uB294\uB370?\n\uBBFC\uAE30:
      \uC55E\uCE58\uB9C8\uBD80\uD130. \uCD1D\uC740 \uB123\uC5B4 \uB450\uACE0. \uCEF4\uD4E8\uD130\uB85C
      \uAC1C\uC810\uD574."
    text: "\uB098: \uC5B4\uB514\uC11C\uBD80\uD130 \uD558\uB294\uB370?\n\uBBFC\uAE30:
      \uC55E\uCE58\uB9C8\uBD80\uD130. \uCD1D\uC740 \uB123\uC5B4 \uB450\uACE0. \uCEF4\uD4E8\uD130\uB85C
      \uAC1C\uC810\uD574."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[1]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uB098: \uC5F4\uC790\uB9C8\uC790 \uB204\uAC00 \uC2DC\uD0A4\uACA0\uC5B4?\n\uBBFC\uAE30:
      \u2026\uC788\uB124. \uCE58\uC988\uD53C\uC790 \uD55C \uD310, \uC218\uB77D\uD574
      \uBD10."
    text: "\uB098: \uC5F4\uC790\uB9C8\uC790 \uB204\uAC00 \uC2DC\uD0A4\uACA0\uC5B4?\n\uBBFC\uAE30:
      \u2026\uC788\uB124. \uCE58\uC988\uD53C\uC790 \uD55C \uD310, \uC218\uB77D\uD574
      \uBD10."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[2]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uC5F0\uC2B5\uD560 \uC7AC\uB8CC\uB294 \uB0B4\uAC00 \uC900\uBE44\uD588\uC5B4.
      \uB3C4\uC6B0\uB97C \uC9D1\uC5B4\uC11C \uC81C\uC791\uB300\uC5D0 \uC62C\uB824."
    text: "\uBBFC\uAE30: \uC5F0\uC2B5\uD560 \uC7AC\uB8CC\uB294 \uB0B4\uAC00 \uC900\uBE44\uD588\uC5B4.
      \uB3C4\uC6B0\uB97C \uC9D1\uC5B4\uC11C \uC81C\uC791\uB300\uC5D0 \uC62C\uB824."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[3]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uC18C\uC2A4\uB97C \uC9D1\uC5B4\uC11C \uB3C4\uC6B0\uC5D0
      \uBC1C\uB77C. \uC21C\uC11C\uB300\uB85C \uD558\uBA74 \uB3FC."
    text: "\uBBFC\uAE30: \uC18C\uC2A4\uB97C \uC9D1\uC5B4\uC11C \uB3C4\uC6B0\uC5D0
      \uBC1C\uB77C. \uC21C\uC11C\uB300\uB85C \uD558\uBA74 \uB3FC."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[4]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uCE58\uC988\uB294 \uADF8 \uC704\uC5D0.\n\uB098: \uC0DD\uAC01\uBCF4\uB2E4
      \uC26C\uC6B4\uB370?"
    text: "\uBBFC\uAE30: \uCE58\uC988\uB294 \uADF8 \uC704\uC5D0.\n\uB098: \uC0DD\uAC01\uBCF4\uB2E4
      \uC26C\uC6B4\uB370?"
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[5]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uADF8\uB7FC \uC774\uC81C \uAD6C\uC6B0\uBA74 \uB418\uACA0\uB124.
      \uD53C\uC790\uB97C \uC9D1\uC5B4\uC11C \uC624\uBE10\uC5D0 \uB123\uC5B4."
    text: "\uBBFC\uAE30: \uADF8\uB7FC \uC774\uC81C \uAD6C\uC6B0\uBA74 \uB418\uACA0\uB124.
      \uD53C\uC790\uB97C \uC9D1\uC5B4\uC11C \uC624\uBE10\uC5D0 \uB123\uC5B4."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[6]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uB2E4 \uAD6C\uC6CC\uC84C\uC73C\uBA74 \uAEBC\uB0B4.
      \uC0C1\uC790\uB97C \uC5F4\uACE0 \uD53C\uC790\uB97C \uB123\uC740 \uB4A4 \uB2EB\uC544.
      \uC606\uC5D0\uC11C \uCC59\uAE30\uACE0."
    text: "\uBBFC\uAE30: \uB2E4 \uAD6C\uC6CC\uC84C\uC73C\uBA74 \uAEBC\uB0B4. \uC0C1\uC790\uB97C
      \uC5F4\uACE0 \uD53C\uC790\uB97C \uB123\uC740 \uB4A4 \uB2EB\uC544. \uC606\uC5D0\uC11C
      \uCC59\uAE30\uACE0."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[7]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uC0C1\uC790\uB294 \uBC30\uB2EC\uD1B5\uC5D0. \uC190\uC5D0
      \uB4E4\uACE0 \uC6B4\uC804\uD560 \uC0DD\uAC01\uC740 \uC544\uB2C8\uC9C0?"
    text: "\uBBFC\uAE30: \uC0C1\uC790\uB294 \uBC30\uB2EC\uD1B5\uC5D0. \uC190\uC5D0
      \uB4E4\uACE0 \uC6B4\uC804\uD560 \uC0DD\uAC01\uC740 \uC544\uB2C8\uC9C0?"
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[8]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: M\uC73C\uB85C \uD3F0\uC744 \uC5F4\uACE0, \uBC29\uD5A5\uD0A4\uC640
      Enter\uB85C \uC9C0\uB3C4 \u2192 \uBC30\uB2EC\uC9C0\uB97C \uACE8\uB77C."
    text: "\uBBFC\uAE30: M\uC73C\uB85C \uD3F0\uC744 \uC5F4\uACE0, \uBC29\uD5A5\uD0A4\uC640
      Enter\uB85C \uC9C0\uB3C4 \u2192 \uBC30\uB2EC\uC9C0\uB97C \uACE8\uB77C."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[9]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uC624\uD1A0\uBC14\uC774\uC5D0 \uD0C0. W/S\uB85C \uAC00\uC18D\xB7\uC81C\uB3D9,
      A/D\uB85C \uBC29\uD5A5\uC744 \uBC14\uAFD4. \uAE09\uD68C\uC804\uC740 \uC870\uC2EC\uD558\uACE0."
    text: "\uBBFC\uAE30: \uC624\uD1A0\uBC14\uC774\uC5D0 \uD0C0. W/S\uB85C \uAC00\uC18D\xB7\uC81C\uB3D9,
      A/D\uB85C \uBC29\uD5A5\uC744 \uBC14\uAFD4. \uAE09\uD68C\uC804\uC740 \uC870\uC2EC\uD558\uACE0."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[10]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uB098: \uAE08\uACE0 \uD138 \uB54C\uBCF4\uB2E4 \uC794\uC18C\uB9AC\uAC00
      \uB9CE\uB124.\n\uBBFC\uAE30: \uC774\uBC88\uC5D4 \uC190\uB2D8 \uB3C8\uC774 \uAC78\uB838\uC796\uC544.
      \uB3C4\uCC29\uD558\uBA74 \uB0B4\uB824\uC11C \uC0C1\uC790\uB97C \uAEBC\uB0B4
      \uB4DC\uB824."
    text: "\uB098: \uAE08\uACE0 \uD138 \uB54C\uBCF4\uB2E4 \uC794\uC18C\uB9AC\uAC00
      \uB9CE\uB124.\n\uBBFC\uAE30: \uC774\uBC88\uC5D4 \uC6B0\uB9AC \uB3C8\uC774 \uAC78\uB838\uC796\uC544.
      \uB3C4\uCC29\uD558\uBA74 \uB0B4\uB824\uC11C \uC0C1\uC790\uB97C \uAEBC\uB0B4
      \uB4DC\uB824."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[11]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uC190\uB2D8: \uC774\uC58F\uD638 \uD53C\uC790? \uB2E4\uC2DC \uC5F4\uC5C8\uB124\uC694.
      \uC608\uC804\uC5D4 \uC790\uC8FC \uC2DC\uCF30\uB294\uB370. \uC798 \uBA39\uC744\uAC8C\uC694!\n\uBBFC\uAE30:
      \uCCAB \uB9AC\uBDF0\uAC00 \uC654\uC5B4. \uD3F0\uC758 \uBCC4\uC810 \uC571\uC744
      \uBD10."
    text: "\uC190\uB2D8: \uC774\uC58F\uD638 \uD53C\uC790\uAC00 \uB2E4\uC2DC \uC5F4\uC5C8\uB124\uC694.
      \uC608\uC804\uC5D4 \uC790\uC8FC \uC2DC\uCF30\uB294\uB370. \uC798 \uBA39\uC744\uAC8C\uC694!\n\uBBFC\uAE30:
      \uCCAB \uB9AC\uBDF0\uAC00 \uC654\uC5B4. \uD3F0\uC758 \uBCC4\uC810 \uC571\uC744
      \uBD10."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[12]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uCCAB \uC190\uB2D8\uC774 \uBCC4 \uB2E4\uC12F \uAC1C\uB97C
      \uC92C\uB124. \uC774\uC81C \uAC00\uAC8C\uB85C \uB3CC\uC544\uC640."
    text: "\uBBFC\uAE30: \uCCAB \uC190\uB2D8\uC774 \uBCC4 \uB2E4\uC12F \uAC1C\uB97C
      \uC92C\uB124. \uC774\uC81C \uAC00\uAC8C\uB85C \uB3CC\uC544\uC640."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[13]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uC5B4\uB560\uC5B4?\n\uB098: \uB2E4\uC2DC \uC5F4\uC5B4\uC11C
      \uC88B\uB300. \uB3C8\uB3C4 \uBC1B\uC558\uC5B4. \uC774\uBC88\uC5D4 \uC544\uBB34\uB3C4
      \uC548 \uCAD3\uC544\uC624\uB354\uB77C."
    text: "\uBBFC\uAE30: \uC5B4\uB560\uC5B4?\n\uB098: \uB2E4\uC2DC \uC5F4\uC5B4\uC11C
      \uC88B\uB300. \uB3C8\uB3C4 \uBC1B\uC558\uC5B4. \uC774\uBC88\uC5D4 \uC544\uBB34\uB3C4
      \uC548 \uCAD3\uC544\uC624\uB354\uB77C."
  - id: 'Assets/Scenes/JJinCity.unity:Story tutorial - first honest income.dialogue.Array.data[14]'
    group: "03 \uCCAB \uBC30\uB2EC \uD29C\uD1A0\uB9AC\uC5BC"
    original: "\uBBFC\uAE30: \uADF8\uB7FC \uD55C \uD310 \uB354 \uD314\uC790. \uC2E4\uC7A5\uD55C\uD14C
      \uBB38\uC790\uAC00 \uC654\uC5B4. \uC624\uB298 \uBC24 \uB9CC\uB098\uC790\uB294\uAD70.
      \uD3F0\uC73C\uB85C \uBCF4\uB0B4 \uC904\uAC8C."
    text: "\uBBFC\uAE30: \uADF8\uB7FC \uD55C \uD310 \uB354 \uD314\uC790. \uC2E4\uC7A5\uD55C\uD14C
      \uBB38\uC790\uAC00 \uC654\uC5B4. \uC624\uB298 \uBC24 \uB9CC\uB098\uC790\uB294\uAD70.
      \uD3F0\uC73C\uB85C \uBCF4\uB0B4 \uC904\uAC8C."

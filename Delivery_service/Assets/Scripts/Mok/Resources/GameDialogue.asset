  - id: Assets/Scripts/Mok/ShopUI/MechanicMission.cs:51
    group: "07 \uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    original: "\uC548\uC804\uD558\uAC8C \uBCF5\uADC0\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    text: "\uC548\uC804\uD558\uAC8C \uBCF5\uADC0\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."

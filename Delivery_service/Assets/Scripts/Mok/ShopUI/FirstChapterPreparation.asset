%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cec97a74c3a36e448a23f91d6520c433, type: 3}
  m_Name: FirstChapterPreparation
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.NightPreparationPlan
  chapterTitle: "\uCCAB \uBC88\uC9F8 \uC0AC\uAC74 \xB7 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC"
  premise: "\uBC30\uB2EC\uC6D0\uC73C\uB85C \uD589\uC0AC\uC7A5\uC5D0 \uB4E4\uC5B4\uAC00
    \uBC15\uC9C4\uC6C5\uC758 \uC811\uCD09 \uC0C1\uB300\uB97C \uD655\uC778\uD574\uC57C
    \uD569\uB2C8\uB2E4. \uB0AE\uC5D0\uB294 \uC791\uC804 \uC790\uAE08\uC744 \uB9C8\uB828\uD558\uACE0
    \uBC24\uC5D0\uB294 \uC7A0\uC785\uACFC \uD0C8\uCD9C\uC744 \uC900\uBE44\uD569\uB2C8\uB2E4."
  missions:
  - id: broker
    title: "\uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    optional: 0
    description: "\uC740\uD589 \uC758\uB8B0\uB97C \uC5F0\uACB0\uD588\uB358 \uC2E4\uC7A5\uC744
      \uCC3E\uC544\uC57C \uD569\uB2C8\uB2E4. \uADF8\uB97C \uCAD3\uB294 \uC870\uC9C1\uC6D0\uC5D0\uAC8C\uC11C
      \uBC97\uC5B4\uB098 \uBC15\uC9C4\uC6C5\uC758 \uD589\uC120\uC9C0\uB97C \uC54C\uC544\uB0B4\uC138\uC694."
    result: "\uBC15\uC9C4\uC6C5\uACFC \uBE44\uACF5\uAC1C \uD589\uC0AC \uC815\uBCF4
      \uD655\uBCF4"
  - id: special_order
    title: "\uD2B9\uBCC4 \uC8FC\uBB38"
    optional: 0
    description: "\uC2E4\uC7A5\uC774 \uC18C\uAC1C\uD55C \uD589\uC0AC \uB0A9\uD488
      \uB2F4\uB2F9\uC790\uB97C \uB9CC\uB098\uC138\uC694. \uAD6C\uC6B4 \uCE58\uC988\uD53C\uC790
      \uD55C \uD310\uC744 \uD3EC\uC7A5\uD574 \uC804\uB2EC\uD558\uACE0, \uC815\uC2DD
      \uB0A9\uD488 \uC2B9\uC778\uC744 \uBC1B\uC544 \uBBFC\uAE30\uC5D0\uAC8C \uB3CC\uC544\uC624\uC138\uC694.
      \uC7AC\uB8CC\uBE44\uB294 \uD3C9\uC18C\uC640 \uAC19\uC73C\uBA70 \uC81C\uD55C
      \uC2DC\uAC04\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
    result: "\uD589\uC0AC \uB0A9\uD488 \uBA85\uB2E8 \uB4F1\uB85D \xB7 \uC11C\uBE44\uC2A4
      \uCD9C\uC785\uAD6C \uC774\uC6A9 \uC790\uACA9\n\uC2DC\uC2DD \uB0A9\uD488 \uB300\uAE08
      5,000\uC6D0"
  - id: backdoor
    title: "\uB3C4\uC2DC\uC758 \uB4B7\uBB38"
    optional: 0
    description: "\uB0A9\uD488 \uC2B9\uC778\uC744 \uBC1B\uC740 \uB4A4 \uBBFC\uAE30\uC640
      \uC0C1\uC758\uD558\uC138\uC694. \uD589\uC0AC \uC11C\uBE44\uC2A4 \uCD9C\uC785\uAD6C\uC640
      \uACBD\uBE44 \uC0AC\uAC01\uC9C0\uB300\uB97C \uC870\uC0AC\uD558\uACE0 \uACE8\uBAA9\uBD80\uD130
      \uCC28\uB7C9 \uD569\uB958 \uC9C0\uC810\uAE4C\uC9C0 \uC9C1\uC811 \uC774\uB3D9\uD574
      \uD0C8\uCD9C \uB3D9\uC120\uC744 \uD655\uBCF4\uD558\uC138\uC694. \uACBD\uBE44\uC5D0\uAC8C
      \uB4E4\uD0A4\uBA74 \uC2DC\uC57C\uB97C \uB04A\uACE0 \uC870\uC0AC\uB97C \uC774\uC5B4\uAC08
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    result: "\uC11C\uBE44\uC2A4 \uCD9C\uC785\uAD6C \xB7 \uC0AC\uAC01\uC9C0\uB300
      \xB7 \uACE8\uBAA9 \uD0C8\uCD9C\uB85C \xB7 \uCC28\uB7C9 \uD569\uB958 \uC9C0\uC810
      \uD655\uBCF4"
  - id: mechanic
    title: "\uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    optional: 0
    description: "\uB3C4\uC2DC\uC758 \uB4B7\uBB38\uC744 \uC644\uB8CC\uD55C \uB4A4
      \uC218\uB9AC\uC810\uC758 \uC815\uBE44\uC0AC\uB97C \uB9CC\uB098\uC138\uC694.
      \uC870\uC9C1\uC6D0\uB4E4\uC5D0\uAC8C \uBE7C\uC557\uAE34 \uC2DC\uB3D9 \uC81C\uC5B4\uAE30
      \uC0C1\uC790\uB97C \uD68C\uC218\uD558\uACE0 \uCD94\uACA9\uC744 \uB530\uB3CC\uB824
      \uC804\uB2EC\uD558\uC138\uC694. \uD68C\uC218\uD55C \uBD80\uD488\uC740 \uC7AC\uC2DC\uB3C4\uC5D0\uB3C4
      \uC720\uC9C0\uB429\uB2C8\uB2E4."
    result: "\uD589\uC0AC\uC7A5 \uD0C8\uCD9C \uCC28\uB7C9\xB7\uC815\uBE44\uC0AC \uC6B4\uC804
      \uC9C0\uC6D0 \uD655\uBCF4"
  - id: finale
    title: "\uCCAB \uBC88\uC9F8 \uC0AC\uAC74 \xB7 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC"
    optional: 0
    description: "\uB0A9\uD488 \uC2B9\uC778\xB7\uC7A0\uC785 \uB3D9\uC120\xB7\uC815\uBE44\uC0AC
      \uC9C0\uC6D0\uC744 \uBAA8\uB450 \uD655\uBCF4\uD55C \uB4A4 \uCD9C\uBC1C\uD558\uC138\uC694.
      \uB2E4\uC74C \uB0A0\uC740 \uC601\uC5C5\uC744 \uC26C\uACE0 \uD589\uC0AC\uC7A5\uC5D0
      \uC7A0\uC785\uD569\uB2C8\uB2E4. \uD53C\uC790\uB97C \uC804\uB2EC\uD558\uACE0
      \uBC15\uC9C4\uC6C5\uC744 \uAD00\uCC30\uD55C \uB4A4, \uBC1C\uAC01\uB418\uBA74
      \uC870\uC0AC\uD55C \uACE8\uBAA9\uC744 \uD1B5\uD574 \uC815\uBE44\uC0AC\uC758
      \uCC28\uB85C \uD0C8\uCD9C\uD558\uC138\uC694."
    result: "\uBC15\uC9C4\uC6C5\uC758 \uB2E4\uC74C \uAC70\uB798\uC640 \uAE30\uB85D
      \uC774\uB3D9 \uACC4\uD68D \uD655\uBCF4"

%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cec97a74c3a36e448a23f91d6520c433, type: 3}
  m_Name: FirstChapterPreparation
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.NightPreparationPlan
  chapterTitle: "\uCCAB \uBC88\uC9F8 \uC0AC\uAC74 \xB7 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC"
  premise: "\uC870\uC9C1\uC758 \uC758\uB8B0\uB85C \uC740\uD589\uC744 \uD138\uC5C8\uC9C0\uB9CC
    \uBCF4\uC218\uB3C4 \uC5F0\uB77D\uB3C4 \uB04A\uACBC\uC2B5\uB2C8\uB2E4. \uB0AE\uC5D0\uB294
    \uD53C\uC790 \uAC00\uAC8C\uB85C \uC704\uC7A5\uD558\uBA70 \uC0DD\uD65C\uBE44\uC640
    \uC900\uBE44 \uBE44\uC6A9\uC744 \uBC8C\uACE0, \uBC24\uB9C8\uB2E4 \uD55C \uAC00\uC9C0\uC529
    \uB2E8\uC11C\uB97C \uCAD3\uC544 \uBC15\uC9C4\uC6C5\uC758 \uC18D\uB0B4\uB97C \uC54C\uC544\uB0C5\uB2C8\uB2E4."
  missions:
  - id: broker
    title: "\uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    optional: 0
    description: "\uC5B4\uC82F\uBC24, \uC5F0\uB77D\uC774 \uB04A\uACBC\uB358 \uC2E4\uC7A5\uC774
      \uC870\uC9C1\uC5D0\uAC8C \uCAD3\uAE34\uB2E4\uB294 \uBB38\uC790\uB97C \uBCF4\uB0C8\uC2B5\uB2C8\uB2E4.
      \uC624\uB298 \uB9C8\uAC10 \uD6C4 \uC57D\uC18D \uC7A5\uC18C\uC5D0\uC11C \uB9CC\uB098
      \uC0AC\uC815\uC744 \uB4E3\uACE0 \uD568\uAED8 \uD0C8\uCD9C\uD558\uC138\uC694."
    result: "\uBC15\uC9C4\uC6C5\uC758 \uD589\uC0AC \uC815\uBCF4\uC640 \uB0A9\uD488
      \uB2F4\uB2F9\uC790 \uC5F0\uB77D\uCC98 \uD655\uBCF4 \xB7 \uB2E4\uC74C \uC77C\uCC28\uC5D0
      \uD2B9\uBCC4 \uC8FC\uBB38"
  - id: special_order
    title: "\uD2B9\uBCC4 \uC8FC\uBB38"
    optional: 0
    description: "\uC2E4\uC7A5\uC744 \uAD6C\uCD9C\uD55C \uB2E4\uC74C \uC77C\uCC28
      \uBC24, \uC608\uC57D\uD55C \uC2DC\uC2DD \uB0A9\uD488\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4.
      \uCE58\uC988\uD53C\uC790\uB97C \uC804\uB2EC\uD574 \uAC00\uAC8C \uC774\uB984\uC73C\uB85C
      \uD589\uC0AC\uC7A5 \uCD9C\uC785 \uC2B9\uC778\uC744 \uBC1B\uC73C\uC138\uC694."
    result: "\uC815\uC2DD \uB0A9\uD488 \uC2B9\uC778 \xB7 \uB2E4\uC74C \uC77C\uCC28\uC5D0
      \uD589\uC0AC\uC7A5 \uC8FC\uBCC0 \uC870\uC0AC"
  - id: backdoor
    title: "\uB3C4\uC2DC\uC758 \uB4B7\uBB38"
    optional: 0
    description: "\uB0A9\uD488 \uC2B9\uC778\uC744 \uBC1B\uC740 \uB2E4\uC74C \uC77C\uCC28
      \uBC24, \uD589\uC0AC\uC7A5 \uC8FC\uBCC0\uC744 \uC870\uC0AC\uD569\uB2C8\uB2E4.
      \uBC15\uC9C4\uC6C5\uC5D0\uAC8C \uB4E4\uD0A4\uC9C0 \uC54A\uC744 \uC790\uB9AC\uC640
      \uD0C8\uCD9C \uB3D9\uC120\uC744 \uD655\uBCF4\uD558\uC138\uC694."
    result: "\uCD9C\uC785\uAD6C\xB7\uC0AC\uAC01\uC9C0\uB300\xB7\uD0C8\uCD9C\uB85C
      \uD655\uBCF4 \xB7 \uB2E4\uC74C \uC77C\uCC28\uC5D0 \uC815\uBE44\uC0AC\uC640
      \uC57D\uC18D"
  - id: mechanic
    title: "\uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    optional: 0
    description: "\uD604\uC7A5 \uC870\uC0AC\uB97C \uB9C8\uCE5C \uB2E4\uC74C \uC77C\uCC28
      \uBC24, \uC815\uBE44\uC0AC\uC758 \uBD80\uD488\uC744 \uB418\uCC3E\uC544 \uC8FC\uACE0
      \uD0C8\uCD9C \uCC28\uB7C9\uC744 \uD655\uBCF4\uD558\uC138\uC694. \uB0AE\uC5D0\uB294
      \uC0DD\uD65C\uBE44\uC640 \uC900\uBE44 \uBE44\uC6A9\uC744 \uBC8C\uC5B4 \uB461\uB2C8\uB2E4."
    result: "\uD0C8\uCD9C \uCC28\uB7C9 \uC9C0\uC6D0 \uD655\uBCF4 \xB7 \uB2E4\uC74C
      \uB0A0 \uD070 \uC0AC\uAC74\uC73C\uB85C \uCD9C\uBC1C \uAC00\uB2A5"
  - id: finale
    title: "\uCCAB \uBC88\uC9F8 \uC0AC\uAC74 \xB7 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC"
    optional: 0
    description: "\uC900\uBE44\uAC00 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uCD9C\uBC1C\uD558\uBA74
      \uB2E4\uC74C \uB0A0\uB85C \uB118\uC5B4\uAC00 \uC601\uC5C5 \uB300\uC2E0 \uD589\uC0AC\uC7A5\uC5D0
      \uC7A0\uC785\uD569\uB2C8\uB2E4. \uD53C\uC790\uB97C \uB0A9\uD488\uD558\uACE0
      \uBC15\uC9C4\uC6C5\uC758 \uC18D\uB0B4\uB97C \uC5FF\uB4E4\uC740 \uB4A4, \uB4E4\uD0A4\uBA74
      \uC900\uBE44\uD55C \uCC28\uB7C9\uC73C\uB85C \uD0C8\uCD9C\uD558\uC138\uC694."
    result: "\uC740\uD589 \uC758\uB8B0\uC758 \uC9C4\uC2E4\uACFC \uC870\uC9C1\uC758
      \uC81C\uAC70 \uACC4\uD68D \uD655\uC778"

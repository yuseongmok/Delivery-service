%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cec97a74c3a36e448a23f91d6520c433, type: 3}
  m_Name: FirstChapterPreparation
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.NightPreparationPlan
  chapterTitle: "\uCCAB \uBC88\uC9F8 \uC0AC\uAC74 \xB7 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC"
  premise: "\uC57C\uB9C8\uC790\uD0A4\uD30C\uC758 \uAE08\uACE0\uC5D0\uC11C \uB3C8\uC744
    \uD68C\uC218\uD55C \uB4A4 \uC5F0\uB77D\uCC45\uC774 \uC0AC\uB77C\uC84C\uC2B5\uB2C8\uB2E4.
    \uB450 \uC0AC\uB78C\uC740 \uD53C\uC790 \uBC30\uB2EC\uC6D0\uC73C\uB85C \uC2E0\uBD84\uC744
    \uC228\uAE30\uACE0 \uC9C0\uB0B4\uB2E4\uAC00, \uBA70\uCE60 \uB4A4 \uC790\uC2E0\uC744
    \uAD6C\uD574 \uB2EC\uB77C\uB294 \uC2E4\uC7A5\uC758 \uC5F0\uB77D\uC744 \uBC1B\uC2B5\uB2C8\uB2E4.
    \uB2E8\uC11C\uB97C \uB530\uB77C \uBC15\uC9C4\uC6C5\uC758 \uC18D\uB0B4\uB97C \uD655\uC778\uD558\uC138\uC694."
  missions:
  - id: broker
    title: "\uC5F0\uB77D\uC774 \uB04A\uAE34 \uC911\uAC1C\uC778"
    optional: 0
    description: "\uBA70\uCE60 \uB9CC\uC5D0 \uC5F0\uB77D\uD574 \uC628 \uC2E4\uC7A5\uC774
      \uC870\uC9C1\uC6D0\uB4E4\uC5D0\uAC8C \uCAD3\uAE30\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uD734\uB300\uD3F0\uC5D0 \uD45C\uC2DC\uB41C \uC57D\uC18D \uC7A5\uC18C\uB85C
      \uAC00\uC11C \uADF8\uB97C \uAD6C\uCD9C\uD558\uACE0 \uC5F0\uB77D\uC774 \uB04A\uACBC\uB358
      \uC774\uC720\uB97C \uD655\uC778\uD558\uC138\uC694."
    result: "\uBC15\uC9C4\uC6C5\uC758 \uD589\uC0AC \uC815\uBCF4\uC640 \uB0A9\uD488
      \uB2F4\uB2F9\uC790 \uC5F0\uB77D\uCC98 \uD655\uBCF4 \xB7 \uD2B9\uBCC4 \uC8FC\uBB38
      \uC900\uBE44 \uAC00\uB2A5"
  - id: special_order
    title: "\uD2B9\uBCC4 \uC8FC\uBB38"
    optional: 0
    description: "\uC2E4\uC7A5\uC5D0\uAC8C \uC5BB\uC740 \uC5F0\uB77D\uCC98\uB85C
      \uD589\uC0AC \uB0A9\uD488 \uB2F4\uB2F9\uC790\uB97C \uB9CC\uB098\uC138\uC694.
      \uC694\uAD6C\uD558\uB294 \uCE58\uC988\uD53C\uC790\uB97C \uB9CC\uB4E4\uC5B4
      \uC2DC\uC2DD\uC5D0 \uD1B5\uACFC\uD558\uBA74 \uD53C\uC790 \uBC30\uB2EC\uC6D0\uC73C\uB85C
      \uD589\uC0AC\uC7A5\uC5D0 \uB4E4\uC5B4\uAC08 \uB0A9\uD488 \uC2B9\uC778\uC744
      \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAE30\uBCF8 \uC7AC\uB8CC\uB294
      \uBBFC\uAE30\uAC00 \uC9C0\uC6D0\uD569\uB2C8\uB2E4."
    result: "\uC815\uC2DD \uB0A9\uD488 \uC2B9\uC778 \xB7 \uD589\uC0AC\uC7A5 \uC8FC\uBCC0
      \uC870\uC0AC \uAC00\uB2A5"
  - id: backdoor
    title: "\uB3C4\uC2DC\uC758 \uB4B7\uBB38"
    optional: 0
    description: "\uB0A9\uD488 \uC2B9\uC778\uC744 \uBC1B\uC558\uC73C\uB2C8 \uD589\uC0AC\uC7A5
      \uC8FC\uBCC0\uC744 \uC870\uC0AC\uD558\uC138\uC694. \uACBD\uBE44\uC758 \uC2DC\uC120\uC744
      \uD53C\uD574 \uC11C\uBE44\uC2A4 \uCD9C\uC785\uAD6C, \uC0AC\uAC01\uC9C0\uB300,
      \uACE8\uBAA9 \uD0C8\uCD9C\uB85C, \uCC28\uB7C9 \uD569\uB958 \uC9C0\uC810\uC744
      \uD655\uC778\uD558\uACE0 \uBBFC\uAE30\uC5D0\uAC8C \uBCF4\uACE0\uD569\uB2C8\uB2E4.
      \uC544\uC9C1 \uD589\uC0AC\uC7A5 \uB0B4\uBD80\uB85C \uC7A0\uC785\uD558\uB294
      \uB2E8\uACC4\uB294 \uC544\uB2D9\uB2C8\uB2E4."
    result: "\uCD9C\uC785\uAD6C\xB7\uC0AC\uAC01\uC9C0\uB300\xB7\uD0C8\uCD9C\uB85C
      \uD655\uBCF4 \xB7 \uC815\uBE44\uC0AC\uC5D0\uAC8C \uCC28\uB7C9 \uC694\uCCAD
      \uAC00\uB2A5"
  - id: mechanic
    title: "\uBE5A\uC9C4 \uC815\uBE44\uC0AC"
    optional: 0
    description: "\uD589\uC0AC\uC7A5 \uCD9C\uC785\uAD6C\uC640 \uD0C8\uCD9C \uACBD\uB85C\uB97C
      \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uC218\uB9AC\uC810\uC5D0\uC11C \uC815\uBE44\uC0AC\uB97C
      \uB9CC\uB098 \uBD80\uD0C1\uC744 \uB4E3\uACE0, \uC870\uC9C1\uC6D0\uB4E4\uC774
      \uAC00\uC9C4 \uBD80\uD488 \uC0C1\uC790\uB97C \uD68C\uC218\uD574 \uB3CC\uB824\uC8FC\uC138\uC694.
      \uBD80\uD488\uC744 \uC804\uB2EC\uD558\uBA74 \uC870\uC0AC\uD55C \uD569\uB958
      \uC9C0\uC810\uC5D0 \uD0C8\uCD9C \uCC28\uB7C9\uACFC \uC5F4\uC1E0\uB97C \uC900\uBE44\uD574
      \uC8FC\uAE30\uB85C \uD569\uB2C8\uB2E4."
    result: "\uD0C8\uCD9C \uCC28\uB7C9 \uC9C0\uC6D0 \uD655\uBCF4 \xB7 \uB9C8\uC9C0\uB9C9
      \uBC30\uB2EC \uCD9C\uBC1C \uAC00\uB2A5"
  - id: finale
    title: "\uCCAB \uBC88\uC9F8 \uC0AC\uAC74 \xB7 \uB9C8\uC9C0\uB9C9 \uBC30\uB2EC"
    optional: 0
    description: "\uC900\uBE44\uD55C \uB0A9\uD488 \uC2B9\uC778\uC73C\uB85C \uD589\uC0AC\uC7A5\uC5D0
      \uB4E4\uC5B4\uAC00 \uD53C\uC790\uB97C \uC804\uB2EC\uD558\uACE0 \uBC15\uC9C4\uC6C5\uC758
      \uB300\uD654\uB97C \uC5FF\uB4E4\uC73C\uC138\uC694. \uB4E4\uD0A4\uBA74 \uC870\uC0AC\uD55C
      \uCD9C\uC785\uAD6C\uC640 \uACE8\uBAA9 \uACBD\uB85C\uB85C \uD0C8\uCD9C\uD574
      \uC815\uBE44\uC0AC\uAC00 \uB9C8\uB828\uD55C \uCC28\uB97C \uD0C0\uACE0 \uBE60\uC838\uB098\uC635\uB2C8\uB2E4."
    result: "\uC870\uC9C1 \uAC04 \uCDA9\uB3CC\uACFC \uB450\uBAA9 \uC790\uB9AC \uD0C8\uCDE8
      \uACC4\uD68D \uD655\uC778 \xB7 \uB9E4\uC7A5 \uD0C8\uCD9C \xB7 \uAC10\uC625
      \uCC55\uD130 \uB3C4\uC785"

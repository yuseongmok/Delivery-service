  m_Script: {fileID: 11500000, guid: 3f7bffca31596a249bb809d2982ac1e3, type: 3}
  m_Name: "\uAC13 \uD280\uAE34 \uCE58\uD0A8 \uB300\uC0AC\uC640 \uC2DC\uAC04"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonChickenText
  kitchenSeconds: 360
  start: "\uBBFC\uAE30: \uC8FC\uBC29\uC7A5\uC774 \uB0AE\uC7A0 \uC790\uB294 \uB3D9\uC548
    \uB9CC\uB4E4\uC790. \uB098\uB294 \uC785\uAD6C\uB97C \uBCFC\uAC8C. \uBC14\uB2E5
    \uC870\uC2EC\uD574."
  caught: "\uC8FC\uBC29\uC7A5: \uB0B4 \uC2E0\uC131\uD55C \uC8FC\uBC29\uC5D0\uC11C
    \uB2F9\uC7A5 \uAEBC\uC838!"
  ambush: "\uC8C4\uC218: \uC7A0\uAE50. \uADF8 \uCE58\uD0A8 \uB0C4\uC0C8\u2026 \uD63C\uC790
    \uBA39\uACA0\uB2E4\uB294 \uAC74 \uC544\uB2C8\uC9C0?"
  cooked: "\uBBFC\uAE30: \uCE58\uD0A8 \uC644\uC131\uC774\uB124! \uCD5C\uD615\uC6B1\uC5D0\uAC8C
    \uAC00\uC838\uAC00\uC790."
  fightCleared: "\uBBFC\uAE30: \uC798 \uC9C0\uCF30\uC5B4. \uC774\uC81C \uCD5C\uD615\uC6B1\uC5D0\uAC8C
    \uAC00\uC838\uAC00\uC790."
  defeated: "\uCE58\uD0A8\uC744 \uC9C0\uD0A4\uC9C0 \uBABB\uD588\uB2E4. \uC8FC\uBC29
    \uC785\uAD6C\uC5D0\uC11C \uB2E4\uC2DC \uC900\uBE44\uD558\uC790."
  delivery:
  - "\uCD5C\uD615\uC6B1: \uC774 \uB0C4\uC0C8\uB294\u2026 \uC774\uAC8C \uC5BC\uB9C8\uB9CC\uC774\uC57C!"
  - "\uB098: \uB118\uACA8\uC8FC\uAE30 \uC804\uC5D0 \uC6B0\uB9AC \uBD80\uD0C1\uBD80\uD130
    \uB4E4\uC5B4\uC8FC\uC154\uC57C\uC9C0."
  - "\uCD5C\uD615\uC6B1: \uC544, \uADF8\uB798. \uBB58 \uC54C\uB824 \uC8FC\uBA74 \uB418\uC9C0?"
  - "\uBBFC\uAE30: \uC6B0\uB9B0 \uD0C8\uC625\uD560 \uC0DD\uAC01\uC774\uC57C. \uAC04\uC218\uBCF5\uC774
    \uD544\uC694\uD55C\uB370 \uC5B4\uB514 \uC788\uB294\uC9C0 \uC54C\uC544?"
  - "\uCD5C\uD615\uC6B1: \uC608\uBE44 \uAC04\uC218\uBCF5\uC740 \uAC04\uC218\uC7A5\uC2E4\uC5D0
    \uC788\uC9C0. \uBB38\uC81C\uB294 \uC55E\uC744 \uC9C0\uD0A4\uB294 \uAC04\uC218\uC57C."
  - "\uCD5C\uD615\uC6B1: \uC758\uBB34\uC2E4\uC5D0\uC11C \uC218\uBA74\uC81C\uB97C
    \uCC98\uBC29\uBC1B\uC740 \uB188\uC744 \uBD24\uC5B4. \uB108\uD76C \uC694\uB9AC
    \uC2E4\uB825\uACFC \uADF8 \uC57D\uC774\uBA74 \uACBD\uACC4\uB97C \uD480 \uC218
    \uC788\uACA0\uC9C0."
  - "\uB098: \uC74C\uC2DD\uC5D0 \uC218\uBA74\uC81C\uB97C \uB123\uC73C\uB77C\uB294
    \uAC70\uAD70."
  - "\uBBFC\uAE30: \uADF8\uB188\uC740 \uC5B4\uB514 \uC788\uC9C0?"
  - "\uCD5C\uD615\uC6B1: \uC544\uAE4C \uC791\uC5C5\uC2E4\uB85C \uB4E4\uC5B4\uAC14\uC5B4.
    \uC21C\uC21C\uD788 \uB0B4\uC904 \uB140\uC11D\uC740 \uC544\uB2D0 \uAC70\uB2E4."
  - "\uB098: \uC77C\uB2E8 \uB9CC\uB098 \uBD10\uC57C\uACA0\uB124."
  lineSeconds: 4

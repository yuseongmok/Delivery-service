  m_Script: {fileID: 11500000, guid: 8b49370ba13e2fa439fe7ad98ce19fde, type: 3}
  m_Name: "\uAC10\uC625 \uB3C4\uC785\uACFC \uC815\uBCF4\uAC70\uB798 \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonIntroductionText
  arrival: "\uC218\uAC10 \uC808\uCC28"
  elapsed: "\uC218\uAC10 \uC774\uD2C0\uC9F8 \xB7 \uAC19\uC740 \uBC29"
  morning: "\uB2E4\uC74C \uB0A0 \uC544\uCE68 \xB7 \uD65C\uB3D9 \uC2DC\uAC04"
  photograph: "\uAC04\uC218: \uC815\uBA74 \uBD10. \uC6C0\uC9C1\uC774\uC9C0 \uB9D0\uACE0.\n\uC606\uC73C\uB85C
    \uB3CC\uC544."
  cell:
  - "\uB098: \uC5B4\uB5A1\uD558\uC9C0\u2026 \uC774\uB7EC\uB2E4\uAC00 \uD3C9\uC0DD
    \uAC10\uC625\uC5D0\uC11C \uC369\uC744 \uAC70\uC57C."
  - "\uBBFC\uAE30: \uB0B4\uAC8C \uC88B\uC740 \uC0DD\uAC01\uC774 \uC788\uC5B4."
  - "\uBBFC\uAE30: \uC774\uACF3\uC5D0 \uB300\uD574 \uC815\uBCF4\uB97C \uAF49 \uC950\uACE0
    \uC788\uB294 \uB188\uC744 \uC54C\uC544\uB0C8\uC5B4."
  - "\uBBFC\uAE30: \uB0B4\uC77C \uC544\uCE68 \uD65C\uB3D9 \uC2DC\uAC04\uC5D0 \uC6B4\uB3D9\uC7A5\uC5D0\uC11C
    \uB9CC\uB098 \uBCF4\uC790."
  meeting:
  - "\uCD5C\uD615\uC6B1: \uBB50\uC57C\u2026 \uACF5\uBB34\uC6D0 \uC900\uBE44\uD574\uC57C
    \uD558\uB2C8\uAE4C \uC800\uB9AC \uAEBC\uC838."
  - "\uBBFC\uAE30: \uC774\uBD10. \uB124\uAC00 \uC774\uACF3\uC758 \uC601\uAC10\uB2D8\uC774\uB77C\uACE0
    \uB4E4\uC5C8\uC5B4. \uC815\uBCF4\uB97C \uC880 \uC0AC\uACE0 \uC2F6\uC740\uB370,
    \uC5B4\uB54C?"
  - "\uCD5C\uD615\uC6B1: \uAC70\uB798\uB294 \uB098\uD55C\uD14C \uC5C6\uB294 \uAC78
    \uAC00\uC838\uC640\uC57C \uC131\uB9BD\uD558\uB294 \uAC70\uC57C. \uB0B4\uAC00
    \uC5C6\uB294 \uAC8C \uC788\uC5B4 \uBCF4\uC774\uB098?"
  - "\uB098: \uBB50\uB4E0 \uC88B\uC73C\uB2C8 \uC6D0\uD558\uB294 \uAC8C \uC788\uB2E4\uBA74
    \uB9D0\uD574 \uC918."
  - "\uCD5C\uD615\uC6B1: \uD760\u2026 \uB208\uBE5B\uC744 \uBCF4\uC544\uD558\uB2C8
    \uB3C5\uAE30\uAC00 \uBC14\uC9DD \uC62C\uB790\uAD70. \uC88B\uC544, \uB0B4\uAC00
    \uC6D0\uD558\uB294 \uAC74\u2026"
  - "\uCD5C\uD615\uC6B1: \uD0A8\u2026"
  - "\uBBFC\uAE30: \uD0A8?"
  - "\uCD5C\uD615\uC6B1: \uCE58\uD0A8\uC774 \uBA39\uACE0 \uC2F6\uB2E4."
  - "\uBBFC\uAE30: \uCE58\uD0A8? \uADF8 \uD6C4\uB77C\uC774\uB4DC\uCE58\uD0A8 \uB9D0\uD558\uB294
    \uAC74\uAC00?"
  - "\uCD5C\uD615\uC6B1: \uADF8\uB798. \uC774\uACF3\uC5D0 \uC628 \uB4A4\uB85C \uBA39\uC740
    \uD280\uAE40\uC774\uB77C\uACE4 \uB9DD\uD560 \uAC00\uC9C0\uD280\uAE40\uBFD0\uC774\uC57C.
    \uAC04\uB9CC\uC5D0 \uBC30\uC5D0 \uAE30\uB984\uCE60 \uC880 \uD558\uACE0 \uC2F6\uAD70."
  - "\uB098: \uB9E1\uACA8 \uB46C. \uC900\uBE44\uD574\uC11C \uB2E4\uC2DC \uC624\uC9C0."
  walkObjective: "\uC815\uBCF4\uAC70\uB798 \xB7 \uBBFC\uAE30\uC640 \uC6B4\uB3D9\uC7A5\uC5D0\uC11C
    \uCD5C\uD615\uC6B1 \uB9CC\uB098\uAE30"
  talkObjective: "\uC815\uBCF4\uAC70\uB798 \xB7 \uCD5C\uD615\uC6B1\uACFC \uB300\uD654\uD558\uAE30"
  completeObjective: "\uC815\uBCF4\uAC70\uB798 \uC644\uB8CC \xB7 \uCD5C\uD615\uC6B1\uC740
    \uAC13 \uD280\uAE34 \uCE58\uD0A8\uC744 \uC6D0\uD55C\uB2E4"
  information: "\uCD5C\uD615\uC6B1\uC740 \uAC10\uC625 \uC0AC\uC815\uC5D0 \uBC1D\uC740
    \uC815\uBCF4\uD1B5\uC774\uB2E4. \uCE58\uD0A8\uC744 \uAC00\uC838\uC624\uBA74 \uD0C8\uC625\uC5D0
    \uD544\uC694\uD55C \uC815\uBCF4\uB97C \uAC70\uB798\uD558\uAE30\uB85C \uD588\uB2E4."
  lineSeconds: 4

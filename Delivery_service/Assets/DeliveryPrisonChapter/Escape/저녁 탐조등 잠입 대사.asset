  m_Script: {fileID: 11500000, guid: 0ab88e30d5a107e49be95d525fa0728e, type: 3}
  m_Name: "\uC800\uB141 \uD0D0\uC870\uB4F1 \uC7A0\uC785 \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonNightText
  waiting: "\uBBFC\uAE30: \uCE74\uBA54\uB77C\uB294 \uAED0\uC5B4. \uAD50\uB300\uAC00
    \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9AC\uC790."
  timeCard: "\uADF8\uB0A0 \uC800\uB141 \xB7 \uD638\uC1A1 \uCD9C\uBC1C \uC9C1\uC804"
  introduction:
  - "\uBBFC\uAE30: \uD638\uC1A1\uCC28\uAC00 \uACE7 \uCD9C\uBC1C\uD574. \uC774\uC81C
    \uAC04\uC218\uBCF5\uC744 \uC785\uC5C8\uC5B4\uB3C4 \uBC16\uC5D0\uC11C \uB3CC\uC544\uB2E4\uB2C8\uBA74
    \uB4E4\uD0AC \uAC70\uC57C."
  - "\uB098: \uAC10\uC2DC\uD0D1\uC740 \uC544\uC9C1 \uC6C0\uC9C1\uC774\uACE0 \uC788\uC5B4\u2026
    \uBD88\uBE5B\uC774 \uC9C0\uB098\uAC04 \uB2E4\uC74C \uC6C0\uC9C1\uC774\uC790."
  - "\uBBFC\uAE30: \uC0C1\uC790 \uB4A4\uB85C \uC228\uC5B4. \uB09C \uB124 \uB4A4\uB97C
    \uB530\uB77C\uAC08\uAC8C. \uCC28\uB7C9 \uC606\uC5D0\uC11C \uB9CC\uB098\uC790."
  caught: "\uAC04\uC218: \uC6B4\uB3D9\uC7A5\uC5D0 \uB204\uAD6C\uC57C! \uAC70\uAE30
    \uBA48\uCDB0!"
  retry: "\uBBFC\uAE30: \uBD88\uBE5B\uC774 \uB3CC\uC544\uC624\uB294 \uAC78 \uBD10.
    \uC9C0\uB098\uAC04 \uB2E4\uC74C \uC6C0\uC9C1\uC774\uBA74 \uB3FC."
  waitingForMingi: "\uB098: \uBA3C\uC800 \uC654\uC5B4. \uBBFC\uAE30, \uC774\uCABD\uC774\uC57C!"
  complete: "\uBBFC\uAE30: \uC88B\uC544, \uB458 \uB2E4 \uC654\uC5B4. \uC774\uC81C
    \uC774 \uCC28 \uBC11\uC73C\uB85C \uC228\uC5B4\uC11C \uB098\uAC00\uB294 \uAC70\uC57C."
  lineSeconds: 3.5

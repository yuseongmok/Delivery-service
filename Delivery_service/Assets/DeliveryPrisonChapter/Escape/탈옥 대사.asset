  m_Script: {fileID: 11500000, guid: 1d4b62788f4028c45bde8e9c4e3baef2, type: 3}
  m_Name: "\uD0C8\uC625 \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonEscapeText
  ready: "\uBBFC\uAE30: \uC900\uBE44\uB294 \uB05D\uB0AC\uC5B4. \uAC04\uC218\uBCF5\uC73C\uB85C
    \uAC08\uC544\uC785\uACE0 \uD638\uC1A1\uCC28\uB7C9\uC73C\uB85C \uAC00\uC790."
  changed: "\uBBFC\uAE30: \uC81C\uBC95 \uAC04\uC218\uCC98\uB7FC \uBCF4\uC774\uB294\uB370?
    \uB2F9\uD669\uD558\uC9C0 \uB9D0\uACE0 \uB098\uB780\uD788 \uAC78\uC5B4\uAC00\uC790."
  boarding: "\uBBFC\uAE30: \uB0B4\uAC00 \uC606\uC5D0 \uD0C8\uAC8C. \uC815\uBB38\uC5D0\uC11C\uB294
    \uD3C9\uC18C\uCC98\uB7FC \uB9D0\uD574."
  checkpoint: "\uAC04\uC218: \uC815\uC9C0. \uD638\uC1A1 \uC77C\uC815 \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4.
    \uC624\uB298\uC758 \uC554\uAD6C\uD638\uB294?"
  wrong: "\uAC04\uC218: \uC554\uAD6C\uD638\uAC00 \uD2C0\uB838\uC2B5\uB2C8\uB2E4.
    \uB450 \uC0AC\uB78C \uBAA8\uB450 \uB0B4\uB824!"
  retry: "\uAC80\uBB38 \uC9C1\uC804\uBD80\uD130 \uB2E4\uC2DC \uC2DC\uC791\uD569\uB2C8\uB2E4."
  accepted: "\uAC04\uC218: \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uD1B5\uACFC\uD558\uC138\uC694."
  escaped: "\uBBFC\uAE30: \uD574\uB0C8\uC5B4\u2026 \uC774\uC81C \uC5EC\uAE30\uC11C
    \uBA40\uB9AC \uB5A0\uB098\uC790."
  checking: "\uAC04\uC218: \uC7A0\uC2DC\uB9CC\uC694. \uBA85\uB2E8\uC744 \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  relief:
  - "\uBBFC\uAE30: \u2026\uBB38 \uB2EB\uD614\uC5B4? \uC6B0\uB9AC \uC9C4\uC9DC \uB098\uC628
    \uAC70\uC9C0?"
  - "\uB098: \uC751. \uC774\uC81C \uC228 \uC26C\uC5B4\uB3C4 \uB3FC."
  - "\uBBFC\uAE30: \uB124\uAC00 \uADF8 \uC554\uAD6C\uD638\uB97C \uAE30\uC5B5 \uBABB
    \uD588\uC73C\uBA74 \uB05D\uC7A5\uC774\uC5C8\uC5B4."
  - "\uB098: \uC544\uC9C1 \uBA40\uB9AC \uAC00\uC57C \uD574. \uC774\uBC88\uC5D4 \uAC19\uC774
    \uB05D\uAE4C\uC9C0 \uAC00\uC790."
  - "\uBBFC\uAE30: \uADF8\uB798. \uAC19\uC774."
  decoys:
  - "\uBD89\uC740 \uB4F1\uB300"
  - "\uAC80\uC740 \uD30C\uB3C4"
  lineSeconds: 3

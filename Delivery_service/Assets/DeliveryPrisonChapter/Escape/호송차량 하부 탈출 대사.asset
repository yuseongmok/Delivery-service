  m_Script: {fileID: 11500000, guid: ef9d18ace5989194ebbd6aaa396491fb, type: 3}
  m_Name: "\uD638\uC1A1\uCC28\uB7C9 \uD558\uBD80 \uD0C8\uCD9C \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonTransportText
  ready: "\uBBFC\uAE30: \uBC14\uD034 \uC0AC\uC774\uB85C \uB4E4\uC5B4\uAC00. \uC544\uB798\uCABD
    \uCCA0\uC81C \uC9C0\uC9C0\uB300\uB97C \uC7A1\uC73C\uBA74 \uB3FC."
  board: "\uBBFC\uAE30: \uB0B4\uAC00 \uBA3C\uC800 \uB4E4\uC5B4\uAC08\uAC8C. \uC606\uC73C\uB85C
    \uBD99\uC5B4. \uCD9C\uBC1C\uD558\uBA74 \uC808\uB300 \uC190 \uB193\uC9C0 \uB9C8."
  departure: "\uBBFC\uAE30: \uC6C0\uC9C1\uC778\uB2E4! [SPACE]\uB97C \uBC18\uBCF5\uD574\uC11C
    \uB20C\uB7EC \uAF49 \uC7A1\uC544!"
  warning: "\uBBFC\uAE30: \uC190\uC5D0 \uD798 \uC918! \uC870\uAE08\uB9CC \uB354 \uBC84\uD168!"
  fall: "\uB098: \uC73D\u2026 \uC190\uC774 \uBBF8\uB044\uB7EC\uC84C\uC5B4!"
  retry: "\uCC28\uB7C9 \uCD9C\uBC1C \uC804\uBD80\uD130 \uB2E4\uC2DC \uC2DC\uC791\uD569\uB2C8\uB2E4.
    SPACE\uB97C \uAE38\uAC8C \uB204\uB974\uC9C0 \uB9D0\uACE0 \uBC18\uBCF5\uD574\uC11C
    \uB204\uB974\uC138\uC694."
  clearGate: "\uBBFC\uAE30: \uC815\uBB38 \uC9C0\uB0AC\uC5B4. \uC544\uC9C1 \uB193\uC9C0
    \uB9C8!"
  escaped:
  - "\uBBFC\uAE30: \uC774\uC81C \uB410\uC5B4. \uB0B4\uB824!"
  - "\uB098: \uD558\uC544\u2026 \uC9C4\uC9DC \uBC16\uC774\uC57C. \uC6B0\uB9AC \uB098\uC654\uC5B4\u2026!"
  - "\uBBFC\uAE30: \uADF8\uB7EC\uAC8C. \uB124 \uC190 \uD480\uB9AC\uB294 \uC904 \uC54C\uACE0
    \uC2EC\uC7A5\uC774 \uBA4E\uB294 \uC904 \uC54C\uC558\uB2E4."
  - "\uB098: \uB108 \uD63C\uC790 \uBCF4\uB0B4\uACA0\uB0D0. \uAC19\uC774 \uB098\uAC00\uAE30\uB85C
    \uD588\uC796\uC544."
  - "\uBBFC\uAE30: \uACE0\uB9D9\uB2E4. \uC870\uAE08\uB9CC \uC228 \uB3CC\uB9AC\uACE0,
    \uBA40\uB9AC \uAC00\uC790."
  complete: "\uD0C8\uC625 \uC131\uACF5 \xB7 \uBBFC\uAE30\uC640 \uD568\uAED8 \uAD50\uB3C4\uC18C\uB97C
    \uBC97\uC5B4\uB0AC\uB2E4"
  lineSeconds: 3.5

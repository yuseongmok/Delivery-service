  m_Script: {fileID: 11500000, guid: 4919141df89ffec4eb02e6c3a23b12de, type: 3}
  m_Name: "CCTV \uC7A0\uC785\uACFC \uD638\uC1A1 \uC900\uBE44 \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonCctvText
  disguiseGreeting:
  - "\uAC04\uC218: \uC74C? \uBABB \uBCF4\uB358 \uC5BC\uAD74\uC778\uB370, \uC0C8\uB85C
    \uC628 \uC2E0\uCC38\uC778\uAC00?"
  - "\uBBFC\uAE30: \uC608. \uAD00\uC81C\uC2E4 \uC810\uAC80\uD558\uB7EC \uC654\uC2B5\uB2C8\uB2E4."
  - "\uAC04\uC218: \uADF8\uB798, \uC548\uCABD\uC774\uC57C. \uB05D\uB098\uBA74 \uBB38
    \uC798 \uB2EB\uACE0."
  - "\uBBFC\uAE30: \u2026\uD1B5\uD588\uC5B4. \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uB4E4\uC5B4\uAC00\uC790."
  departureTime: 19:30
  interrogation:
  - "\uBBFC\uAE30: \uBE44\uB9AC \uC7A5\uBD80\uC640 \uBC15\uC9C4\uC6C5\uC758 \uBA54\uC2DC\uC9C0\uB294
    \uC6B0\uB9AC\uAC00 \uAC00\uC9C0\uACE0 \uC788\uC5B4. \uC9C0\uAE08\uBD80\uD130
    \uBB3B\uB294 \uB9D0\uC5D0 \uB300\uB2F5\uD574."
  - "\uC5FC\uC724\uD0DC: \u2026\uC6D0\uD558\uB294 \uAC8C \uBB50\uC57C?"
  - "\uB098: \uAC04\uC218\uBCF5\uC740 \uC5B4\uB514 \uC788\uC9C0? \uBC16\uC73C\uB85C
    \uB098\uAC00\uB294 \uD638\uC1A1\uCC28\uB7C9\uC740 \uC5B8\uC81C \uCD9C\uBC1C\uD574?"
  - "\uC5FC\uC724\uD0DC: \uADF8\uAC78 \uB9D0\uD558\uBA74 \uB098\uB3C4 \uC637 \uBC97\uC5B4\uC57C
    \uD574!!"
  - "\uBBFC\uAE30: \uADF8\uAC74 \uC774 \uC7A5\uBD80\uAC00 \uACF5\uAC1C\uB3FC\uB3C4
    \uB611\uAC19\uACA0\uC9C0."
  - "\uC5FC\uC724\uD0DC: \uC774\uC775\u2026 \uC54C\uACA0\uB2E4."
  - "\uC5FC\uC724\uD0DC: \uC606 \uBCF4\uAD00\uD568\uC5D0 \uC608\uBE44 \uAC04\uC218\uBCF5\uC774
    \uC788\uB2E4. \uC7A0\uAE08\uC740 \uD480\uC5B4\uC8FC\uB9C8. \uC815\uAE30 \uD638\uC1A1\uC740
    \uC800\uB141 {departure} \uCD9C\uBC1C\uC774\uC57C."
  - "\uBBFC\uAE30: \uADF8 \uCC28\uAC00 \uBC15\uC9C4\uC6C5\uD55C\uD14C \uAC00\uB294
    \uAC74\uAC00?"
  - "\uC5FC\uC724\uD0DC: \uC544\uB2C8! \uADF8\uAC74 \uC815\uAE30 \uC774\uC1A1 \uCC28\uB7C9\uC774\uC57C.
    \uB108\uD76C \uB458\uC740 \uADF8 \uCC28\uAC00 \uB098\uAC04 \uB4A4 \uBCC4\uB3C4\uB85C
    \uB118\uAE30\uAE30\uB85C \uD588\uC5B4."
  - "\uB098: \uADF8 \uC804\uC5D0 \uBE60\uC838\uB098\uAC00\uC57C\uACA0\uB124. \uAC10\uC2DC
    \uCE74\uBA54\uB77C\uB294 \uC5B4\uB514\uC11C \uAD00\uB9AC\uD558\uC9C0?"
  - "\uC5FC\uC724\uD0DC: \uC544\uB798\uCE35 \uBCF4\uC548\uC2E4 \uC548 CCTV\uC2E4\uC774\uB2E4.
    \uC810\uAC80\uD558\uB7EC \uC654\uB2E4\uACE0 \uD558\uBA74 \uB2F4\uB2F9\uC790\uAC00
    \uB4E4\uC5EC\uBCF4\uB0B4 \uC904 \uAC70\uC57C."
  - "\uBBFC\uAE30: \uAC04\uC218\uBCF5\uC73C\uB85C \uC811\uADFC\uD574\uC11C \uCE74\uBA54\uB77C\uBD80\uD130
    \uB044\uC790. \uC800\uB141\uC5D4 \uD638\uC1A1\uCC28 \uBC11\uC5D0 \uC228\uC5B4\uC11C
    \uB098\uAC00\uB294 \uAC70\uC57C."
  restraint:
  - "\uB098: \uC6B0\uB9B4 \uB118\uAE30\uB824\uB358 \uC778\uAC04\uC744 \uADF8\uB0E5
    \uB450\uACE0 \uAC08 \uC21C \uC5C6\uC5B4."
  - "\uBBFC\uAE30: \uB2E4\uC2DC \uC758\uC790\uC5D0 \uBB36\uC790. \uC544\uC9C1 \uC57D\uAE30\uC6B4\uB3C4
    \uB0A8\uC544 \uC788\uC73C\uB2C8 \uC870\uAE08 \uB354 \uC790\uAC8C \uB46C."
  - "\uC5FC\uC724\uD0DC: \uC7A0\uAE50, \uC774\uBD10\u2026!"
  secured: "\uBBFC\uAE30: \uB2E8\uB2E8\uD788 \uBB36\uC600\uC5B4. \uC7A0\uB4E0 \uD2C8\uC5D0
    \uC6C0\uC9C1\uC774\uC790."
  changed: "\uBBFC\uAE30: \uAC04\uC218\uBCF5\uC740 \uC785\uC5C8\uC5B4. \uC790\uC5F0\uC2A4\uB7FD\uAC8C
    CCTV\uC2E4\uB85C \uB4E4\uC5B4\uAC00\uC790."
  opened: "\uBBFC\uAE30: \uB0B4\uAC00 \uC785\uAD6C\uB97C \uBCF4\uACE0 \uC788\uC744\uAC8C.
    \uC601\uC0C1 \uD68C\uB85C\uB9CC \uB04A\uC5B4. \uACBD\uBCF4\uB294 \uAC74\uB4DC\uB9AC\uC9C0
    \uB9C8."
  caught: "\uAC04\uC218: \uAC70\uAE30! \uD5C8\uAC00 \uC5C6\uC774 CCTV\uC2E4\uC5D0
    \uB4E4\uC5B4\uC628 \uAC8C \uB204\uAD6C\uC57C!"
  retry: "\uBCF4\uC548\uC2E4 \uC55E\uBD80\uD130 \uB2E4\uC2DC \uC2DC\uB3C4\uD569\uB2C8\uB2E4.
    \uAC04\uC218\uC758 \uC2DC\uC120\uACFC \uBCBD \uB4A4 \uC0AC\uAC01\uC9C0\uB300\uB97C
    \uC774\uC6A9\uD558\uC138\uC694."
  disabled: "\uBBFC\uAE30: \uD654\uBA74\uC774 \uAEBC\uC84C\uC5B4. \uB179\uD654\uB3C4
    \uBA48\uCDC4\uACE0. \uB4E4\uD0A4\uAE30 \uC804\uC5D0 \uBCF5\uB3C4\uB85C \uB098\uAC00\uC790."
  complete: "\uBBFC\uAE30: \uC900\uBE44\uB294 \uB05D\uB0AC\uC5B4. \uD638\uC1A1\uCC28
    \uCD9C\uBC1C\uC740 {departure}. \uC774\uC81C \uC800\uB141\uC774 \uB420 \uB54C\uAE4C\uC9C0
    \uBAB8\uC744 \uB0AE\uCD94\uC790."
  channels:
  - "\uC218\uAC10\uB3D9 \uB179\uD654 \uCC28\uB2E8"
  - "\uC6B4\uB3D9\uC7A5 \uB179\uD654 \uCC28\uB2E8"
  - "\uC815\uBB38 \uC601\uC0C1 \uC804\uC1A1 \uCC28\uB2E8"
  lineSeconds: 3.5

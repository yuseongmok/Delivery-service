  m_Script: {fileID: 11500000, guid: d14e01e7686120d4a81bcaf0dbfcfe16, type: 3}
  m_Name: "\uBE44\uB9AC \uC99D\uAC70\uC640 \uD611\uBC15 \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonOfficeEvidenceText
  lockedSupplies: "\uBBFC\uAE30: \uC7A0\uACA8 \uC788\uC5B4. \uCC45\uC0C1 \uC8FC\uBCC0\uC5D0\uC11C
    \uC5F4\uC1E0\uB098 \uB2E8\uC11C\uBD80\uD130 \uCC3E\uC544\uBCF4\uC790."
  titles:
  - "\uAC04\uC218\uC7A5\uC758 \uBE44\uBC00 \uC7A5\uBD80"
  - "\uC624\uB298 \uBC24 \uD2B9\uBCC4 \uD638\uC1A1"
  - "\uBC15\uC9C4\uC6C5\uC758 \uBA54\uC2DC\uC9C0"
  documents:
  - "\uAC00\uC871 \uBA74\uD68C \uD3B8\uC758\uAE08 \u2014 \uAC1C\uC778 \uACC4\uC88C
    \uC785\uAE08\n\uC758\uBB34\uC2E4 \uC57D\uD488 \uC678\uBD80 \uD310\uB9E4 \u2014
    \uC815\uC0B0 \uC644\uB8CC\n\uCE58\uB8CC \uC694\uCCAD \u2014 \uBBF8\uB0A9\uC790\uB294
    \uBCF4\uB958\n\uACB0\uC7AC: \uC5FC\uC724\uD0DC"
  - "\uBCC4\uB3C4 \uC778\uACC4 \uBA85\uB2E8\n\uB300\uC0C1: \uBBFC\uAE30\uC640 \uADF8\uB188\n\uC815\uAE30
    \uD638\uC1A1 \uCD9C\uBC1C \uC774\uD6C4 \uBCC4\uB3C4 \uC774\uC1A1\n\uBAA9\uC801\uC9C0:
    \uACF5\uB780\n\uC778\uACC4\uC790: \uBC15\uC9C4\uC6C5 \uCE21"
  - "\uBC1C\uC2E0: \uBC15\uC9C4\uC6C5\n\uC57D\uC18D\uD55C \uB3C8\uC740 \uBCF4\uB0C8\uB2E4.\n\uBBFC\uAE30\uC640
    \uADF8\uB188, \uC624\uB298 \uBC24 \uB118\uACA8.\n\uC778\uACC4 \uD6C4\uC5D0\uB294
    \uB0B4\uAC00 \uCC98\uB9AC\uD558\uC9C0."
  ledger:
  - "\uB098: \uCE58\uB8CC\uBE44\uB97C \uBC1B\uACE0\uB3C4 \uC57D\uC744 \uC548 \uC92C\uB2E4\uACE0\u2026?
    \uC57D\uC740 \uBC16\uC5D0 \uD314\uC544\uB118\uAE30\uACE0?"
  - "\uBBFC\uAE30: \uC8C4\uC218\uB4E4 \uBAA9\uC228\uC73C\uB85C \uB3C8\uC744 \uBC8C\uACE0
    \uC788\uC5C8\uB124. \uC774 \uC7A5\uBD80, \uCC59\uACA8."
  transfer:
  - "\uB098: \uC5EC\uAE30 \uC6B0\uB9AC\uB97C \uB118\uAE34\uB2E4\uB294 \uB0B4\uC6A9\uC774
    \uC788\uC5B4. \uC815\uAE30 \uD638\uC1A1\uC774 \uB098\uAC04 \uB4A4\uC5D0 \uB530\uB85C
    \uB118\uAE34\uB300."
  - "\uBBFC\uAE30: \uC778\uACC4\uC790\uAC00 \uBC15\uC9C4\uC6C5 \uCE21\uC774\uC57C.
    \uADF8 \uC804\uC5D0 \uBE60\uC838\uB098\uAC00\uC57C \uD574."
  message:
  - "\uBBFC\uAE30: \uACBD\uCC30\uB9CC \uD55C\uD328\uC778 \uC904 \uC54C\uC558\uB294\uB370\u2026
    \uC5EC\uAE30\uAE4C\uC9C0 \uC5F0\uACB0\uB3FC \uC788\uC5C8\uC5B4."
  - "\uB098: \uC815\uAE30 \uD638\uC1A1\uCC28\uB7C9\uC774 \uB098\uAC08 \uB54C \uAC19\uC774
    \uBE60\uC838\uB098\uAC08 \uBC29\uBC95\uC744 \uCC3E\uC790."
  - "\uBBFC\uAE30: \uC774 \uC99D\uAC70\uB85C \uC5FC\uC724\uD0DC\uD55C\uD14C \uCD9C\uBC1C
    \uC2DC\uAC04\uACFC \uAC10\uC2DC \uCCB4\uACC4\uBD80\uD130 \uC54C\uC544\uB0B4\uC790."
  confrontation:
  - "\uBBFC\uAE30: \uC77C\uC5B4\uB098, \uAC04\uC218\uC7A5. \uC6B0\uB9AC \uC598\uAE30
    \uC880 \uD558\uC9C0."
  - "\uC5FC\uC724\uD0DC: \uB108\uD76C\u2026! \uBB38\uBC16\uC5D0 \uAC04\uC218\uB4E4\uC774
    \uC788\uC5B4. \uC18C\uB9AC \uD55C \uBC88\uC774\uBA74 \uB05D\uC774\uC57C!"
  - "\uB098: \uBD88\uB7EC. \uC57D\uC744 \uBE7C\uB3CC\uB9AC\uACE0 \uC8C4\uC218 \uAC00\uC871\uC5D0\uAC8C
    \uB3C8 \uB72F\uC740 \uC7A5\uBD80\uBD80\uD130 \uBCF4\uC5EC\uC8FC\uAC8C."
  - "\uBBFC\uAE30: \uBC15\uC9C4\uC6C5\uC5D0\uAC8C \uC6B0\uB9AC\uB97C \uB118\uAE30\uAE30\uB85C
    \uD55C \uBA54\uC2DC\uC9C0\uB3C4 \uCC59\uACBC\uC5B4."
  - "\uC5FC\uC724\uD0DC: \u2026\uC6D0\uD558\uB294 \uAC8C \uBB50\uC57C?"
  - "\uB098: \uAC04\uC218\uBCF5 \uB450 \uBC8C, \uD638\uC1A1\uCC28\uB7C9 \uC5F4\uC1E0.
    \uADF8\uB9AC\uACE0 \uCD9C\uBC1C \uC2B9\uC778."
  - "\uC5FC\uC724\uD0DC: \uAC04\uC218\uBCF5\uC740 \uC606 \uBCF4\uAD00\uD568, \uCC28\uB7C9
    \uC5F4\uC1E0\uB294 \uC11C\uB78D\uC5D0 \uC788\uC5B4. \uB458 \uB2E4 \uC7A0\uAE08\uC740
    \uD480\uC5B4\uC8FC\uC9C0."
  - "\uBBFC\uAE30: \uC815\uBB38\uC5D0 \uC5F0\uB77D\uD574. \uC608\uC815\uB41C \uD638\uC1A1\uC744
    \uC55E\uB2F9\uAE34\uB2E4\uACE0. \uD3C9\uC18C\uCC98\uB7FC \uB9D0\uD574\uC57C\uC9C0."
  call:
  - "\uC5FC\uC724\uD0DC: \uB098\uB2E4. \uC624\uB298 \uBC24 \uC608\uC815\uB41C \uD638\uC1A1\uC744
    \uC9C0\uAE08 \uCD9C\uBC1C\uC2DC\uD0A8\uB2E4."
  - "\uC5FC\uC724\uD0DC: \uC11C\uB958\uC640 \uC554\uAD6C\uD638 \uD655\uC778\uD558\uACE0
    \uBCF4\uB0B4. \uB0B4 \uC2B9\uC778\uC774\uB2E4."
  - "\uBBFC\uAE30: \uC6B0\uB9AC\uAC00 \uB098\uAC08 \uB54C\uAE4C\uC9C0 \uC5EC\uAE30
    \uC788\uC5B4. \uD5C8\uD2BC\uC9D3\uD558\uBA74 \uC7A5\uBD80\uB294 \uB124 \uBD80\uD558\uB4E4
    \uC190\uC5D0 \uB4E4\uC5B4\uAC00."
  - "\uB098: \uC11C\uB958\uB3C4 \uCC59\uACBC\uC5B4. \uAC08\uC544\uC785\uACE0 \uB098\uAC00\uC790."
  evidenceReady: "\uBBFC\uAE30: \uC99D\uAC70\uB294 \uCDA9\uBD84\uD574. \uC5FC\uC724\uD0DC\uB97C
    \uAE68\uC6B0\uC790."
  approved: "\uBBFC\uAE30: \uC7A0\uAE08\uC740 \uD480\uB838\uC5B4. \uAC04\uC218\uBCF5\uACFC
    \uCC28\uB7C9 \uC5F4\uC1E0\uB97C \uCC59\uAE30\uACE0 \uC554\uAD6C\uD638\uB3C4 \uD655\uC778\uD558\uC790."
  lineSeconds: 3.5

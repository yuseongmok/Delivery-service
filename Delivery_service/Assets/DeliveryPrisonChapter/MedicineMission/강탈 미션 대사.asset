  m_Script: {fileID: 11500000, guid: 50a494861b31eda44af82c73645cd4b9, type: 3}
  m_Name: "\uAC15\uD0C8 \uBBF8\uC158 \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonMedicineText
  lineSeconds: 4
  clue: "\uBBFC\uAE30: \uC791\uC5C5\uC2E4\uB85C \uAC00 \uBCF4\uC790. \uCD5C\uD615\uC6B1\uC774
    \uB9D0\uD55C \uB188\uC740 \uC67C\uD314\uC5D0 \uD30C\uB780 \uC644\uC7A5\uC744
    \uD558\uACE0 \uC788\uB300."
  wrong: "\uC8C4\uC218: \uC218\uBA74\uC81C? \uB09C \uADF8\uB7F0 \uAC70 \uC5C6\uC5B4.
    \uD30C\uB780 \uC644\uC7A5\uC744 \uD55C \uB140\uC11D\uC5D0\uAC8C \uBB3C\uC5B4\uBD10."
  demand:
  - "\uB098: \uC758\uBB34\uC2E4\uC5D0\uC11C \uBC1B\uC740 \uC218\uBA74\uC81C\uB97C
    \uAC00\uC9C0\uACE0 \uC788\uB2E4\uBA70? \uC6B0\uB9AC\uC5D0\uAC8C \uC880 \uB118\uACA8\uC918."
  - "\uC8C4\uC218: \uB108\uD76C\uAC00 \uBB54\uB370? \uC5EC\uAE30 \uBB3C\uAC74\uC740
    \uACF5\uC9DC\uAC00 \uC544\uB2C8\uC57C."
  - "\uBBFC\uAE30: \uC88B\uAC8C \uB9D0\uD560 \uB54C \uB05D\uB0B4\uC790."
  - "\uC8C4\uC218: \uC598\uB4E4\uC544, \uC774 \uC2E0\uC785\uB4E4\uD55C\uD14C \uADDC\uCE59
    \uC880 \uC54C\uB824 \uC918!"
  won: "\uBBFC\uAE30: \uC800\uAE30 \uC57D \uBD09\uD22C\uAC00 \uB5A8\uC5B4\uC84C\uC5B4.
    \uCC59\uAE30\uACE0 \uC6B0\uB9AC \uBC29\uC73C\uB85C \uB3CC\uC544\uAC00\uC790."
  failed: "\uC81C\uC555\uB2F9\uD588\uB2E4. \uC791\uC5C5\uC2E4 \uC55E\uC5D0\uC11C
    \uB2E4\uC2DC \uC900\uBE44\uD558\uC790."
  home:
  - "\uB098: \uC88B\uC544. \uC218\uBA74\uC81C\uB294 \uC5BB\uC5C8\uACE0, \uBB58 \uB9CC\uB4E4\uC5B4\uC57C
    \uAC04\uC218\uB4E4\uC774 \uC758\uC2EC\uD558\uC9C0 \uC54A\uACE0 \uBA39\uC744\uAE4C?"
  - "\uBBFC\uAE30: \uC6B0\uB9AC\uAC00 \uC81C\uC77C \uC798\uD558\uB294 \uAC70 \uC788\uC796\uC544.
    \uD53C\uC790\uB97C \uB9CC\uB4E4\uC790."
  - "\uB098: \uC7AC\uB8CC\uB294 \uC5B4\uB514\uC11C \uAD6C\uD558\uC9C0?"
  - "\uBBFC\uAE30: \uC758\uBB34\uC2E4 \uB4A4\uC5D0 \uAC04\uC218\uC6A9 \uC2DD\uB8CC\uD488
    \uC800\uC7A5\uACE0\uAC00 \uC788\uC5B4. \uC5F4\uC1E0\uB97C \uAD00\uB9AC\uD558\uB294
    \uAC04\uC218\uB97C \uBD24\uC5B4."
  - "\uB098: \uC27D\uC9C0 \uC54A\uACA0\uB294\uAC78\u2026"
  - "\uBBFC\uAE30: \uC6B0\uC120 \uC5EC\uAE30\uC11C \uC228 \uC880 \uB3CC\uB9AC\uC790.
    \uB2E4\uC74C\uC5D4 \uADF8 \uC5F4\uC1E0\uC57C."
  complete: "\uAC15\uD0C8 \uC644\uB8CC \xB7 \uB2E4\uC74C \uACC4\uD68D: \uC2DD\uB8CC\uD488
    \uC800\uC7A5\uACE0 \uC5F4\uC1E0 \uD655\uBCF4"

%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eab7f5fe104868649adea2e41a3dd954, type: 3}
  m_Name: "\uC18C\uB9E4\uCE58\uAE30\uC640 \uBC30\uC2DD \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonKeysText
  theftSnagLeft: "\uACE0\uB9AC\uAC00 \uAC78\uB838\uC5B4 \xB7 \uC67C\uCABD\uC73C\uB85C
    \uC0B4\uC0B4 \uC6C0\uC9C1\uC5EC \uD480\uAE30"
  theftSnagRight: "\uACE0\uB9AC\uAC00 \uAC78\uB838\uC5B4 \xB7 \uC624\uB978\uCABD\uC73C\uB85C
    \uC0B4\uC0B4 \uC6C0\uC9C1\uC5EC \uD480\uAE30"
  theftFreeze: "\uAC04\uC218\uAC00 \uB4A4\uCC99\uC778\uB2E4 \xB7 \uB9C8\uC6B0\uC2A4\uB97C
    \uC6C0\uC9C1\uC774\uC9C0 \uB9C8\uC138\uC694"
  theftCatch: "\uC5F4\uC1E0\uAC00 \uB5A8\uC5B4\uC9C4\uB2E4! \xB7 \uC6B0\uD074\uB9AD\uC73C\uB85C
    \uBC18\uB300 \uC190\uC73C\uB85C \uBC1B\uCE58\uAE30"
  theftReceive: "\uC870\uC6A9\uD788 \uC5F4\uC1E0\uB97C \uBC1B\uCCE4\uB2E4"
  theftDropped: "\uBBFC\uAE30: \uC18C\uB9AC\uAC00 \uB0AC\uC5B4! \uC5F4\uC1E0\uB294
    \uCC59\uACBC\uC73C\uB2C8 \uBE68\uB9AC \uC228\uC5B4!"
  theftGrab: "\uC5F4\uC1E0\uACE0\uB9AC\uB97C \uD074\uB9AD\uD574\uC11C \uC7A1\uC73C\uC138\uC694
    \xB7 \uCC9C\uCC9C\uD788 \uC704\uB85C \uB2F9\uAE30\uAE30"
  theftPull: "\uCC9C\uCC9C\uD788 \uC704\uB85C \uBE7C\uB0B4\uAE30 \xB7 \uC190\uC744
    \uB193\uC73C\uBA74 \uC18C\uC74C\uC774 \uAC00\uB77C\uC549\uC2B5\uB2C8\uB2E4"
  theftWarning: "\uAC04\uC218: \uBB34\uC2A8 \uC18C\uB9AC\uC9C0? \xB7 F\uB85C \uC190\uC744
    \uBE7C\uACE0 \uBB3C\uB7EC\uB098\uC138\uC694!"
  lockChoose: "\uC5F4\uC1E0\uB97C \uD074\uB9AD\uD574 \uC790\uBB3C\uC1E0\uC5D0 \uB123\uAE30
    \xB7 \uD720\uB85C \uC120\uD0DD"
  lockInsert: "\uC5F4\uC1E0\uB97C \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB123\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  lockTurn: "\uC5F4\uC1E0 \uBA38\uB9AC\uB97C \uC7A1\uACE0 \uC624\uB978\uCABD\uC73C\uB85C
    \uB4DC\uB798\uADF8\uD574\uC11C \uB3CC\uB9AC\uAE30 \xB7 \uC6B0\uD074\uB9AD\uC73C\uB85C
    \uBE7C\uAE30"
  lockWarning: "\uBBFC\uAE30: \uAC04\uC218\uAC00 \uC774\uCABD\uC744 \uBCF8\uB2E4!
    \uC190\uC744 \uBE7C\uACE0 \uC228\uC5B4!"
  lockPickHint: "\uD720\uB85C \uC5F4\uC1E0 \uACE0\uB974\uAE30 \u2192 \uC5F4\uC1E0\uB97C
    \uD074\uB9AD\uD574\uC11C \uC7A1\uAE30"
  lockPush: "\uD074\uB9AD\uC744 \uB204\uB978 \uCC44 \uC704\uB85C \uBC00\uC5B4 \uAF42\uC73C\uC138\uC694
    \xB7 \uAC78\uB9AC\uBA74 \uB2E4\uB978 \uC5F4\uC1E0!"
  lockDoesNotFit: "\uB05D\uAE4C\uC9C0 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uB294\uB2E4
    \xB7 \uC6B0\uD074\uB9AD\uC73C\uB85C \uBE7C\uACE0 \uB2E4\uB978 \uC5F4\uC1E0\uB97C
    \uACE0\uB974\uC138\uC694"
  lockFeel: "\uC5F4\uC1E0 \uBA38\uB9AC\uB97C \uC7A1\uACE0 \uC88C\uC6B0\uB85C \uCC9C\uCC9C\uD788
    \xB7 \uB538\uAE4D \uC18C\uB9AC\uAC00 \uB098\uBA74 \uBA48\uCD94\uC138\uC694"
  lockHold: "\uB9DE\uBB3C\uB838\uB2E4! \uD074\uB9AD\uC744 \uB204\uB978 \uCC44 \uC7A0\uAE50
    \uAC00\uB9CC\uD788 \uC720\uC9C0\uD558\uC138\uC694"
  lockFinalTurn: "\uC7A0\uAE08\uC774 \uD480\uB838\uB2E4 \xB7 \uC624\uB978\uCABD\uC73C\uB85C
    \uB05D\uAE4C\uC9C0 \uB3CC\uB9AC\uC138\uC694"
  lockWithdraw: "\uC5F4\uC1E0\uB97C \uBE7C\uB294 \uC911"
  lockRemembered: "\uB9DE\uB294 \uC5F4\uC1E0\uB97C \uAE30\uC5B5\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4
    \xB7 \uD074\uB9AD\uD574\uC11C \uB2E4\uC2DC \uAF42\uC73C\uC138\uC694"
  lineSeconds: 4
  keyDistraction: "\uBBFC\uAE30: \uC5F4\uC1E0 \uCC59\uACBC\uC9C0? \uB0B4\uAC00 \uB9D0
    \uAC78\uACE0 \uC788\uC744 \uD14C\uB2C8 \uCC3D\uACE0 \uBB38\uC744 \uC5F4\uC5B4."
  keyConversation: "\uBBFC\uAE30: \uAC04\uC218\uB2D8, \uB4E4\uC5B4\uC624\uB358 \uACE8\uBAA9\uC5D0\uC11C
    \uC774\uC0C1\uD55C \uC18C\uB9AC\uAC00 \uB0AC\uB294\uB370\uC694."
  keyGuardReply: "\uAC04\uC218: \uBB34\uC2A8 \uC18C\uB9AC? \uC5B4\uB514\uC11C \uB4E4\uC5C8\uB294\uB370?"
  alleyLead: "\uBBFC\uAE30: \uC800\uD76C\uAC00 \uB4E4\uC5B4\uC654\uB358 \uCABD\uC785\uB2C8\uB2E4.
    \uC81C\uAC00 \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  alleyGather: "\uAC04\uC218\uAC00 \uACE8\uBAA9 \uC785\uAD6C\uB85C \uC774\uB3D9\uD588\uB2E4.
    \uC7AC\uB8CC\uB97C \uCC59\uACA8 \uBC16\uC73C\uB85C \uB098\uAC00\uC790."
  diversionReady: "\uBBFC\uAE30: \uC5F4\uB838\uC5B4? \uB0B4\uAC00 \uAC04\uC218\uB97C
    \uB370\uB824\uAC08\uAC8C. \uC7A0\uAE50 \uAE30\uB2E4\uB824."
  diversionAsk: "\uBBFC\uAE30: \uAC04\uC218\uB2D8, \uBC30\uC2DD\uCE74\uD2B8 \uBC14\uD034\uAC00
    \uAC78\uB838\uB294\uB370 \uC7A0\uAE50 \uBD10\uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  diversionReply: "\uAC04\uC218: \uB610 \uBB50\uC57C\u2026 \uC55E\uC7A5\uC11C."
  diversionGather: "\uBBFC\uAE30: \uCE74\uD2B8\uB294 \uC800\uCABD\uC785\uB2C8\uB2E4.
    \uBA3C\uC800 \uAC00\uC2DC\uBA74 \uACE7 \uB530\uB77C\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
  meetAgain: "\uC7AC\uB8CC\uB97C \uBAA8\uB450 \uCC59\uACBC\uB2E4. \uACE8\uBAA9 \uC785\uAD6C\uC5D0\uC11C
    \uBBFC\uAE30\uC640 \uD569\uB958\uD558\uC790."
  rejoined: "\uBBFC\uAE30: \uB2E4 \uCC59\uACBC\uC9C0? \uAC04\uC218\uAC00 \uB3CC\uC544\uC624\uAE30
    \uC804\uC5D0 \uC8FC\uBC29\uC73C\uB85C \uAC00\uC790."
  start: "\uBBFC\uAE30: \uC758\uBB34\uC2E4 \uAC74\uBB3C \uC606 \uACE8\uBAA9\uC5D0
    \uCC3D\uACE0\uAC00 \uC788\uC5B4. \uAC04\uC218\uAC00 \uB4F1\uC744 \uB3CC\uB838\uC744
    \uB54C \uC5F4\uC1E0\uB97C \uBE7C \uC624\uC790. \uB098\uB294 \uB9DD\uC744 \uBCFC\uAC8C."
  stolen: "\uBBFC\uAE30: \uC88B\uC544! \uCC3D\uACE0 \uBB38\uC5D0 \uB9DE\uB294 \uC5F4\uC1E0\uB97C
    \uCC3E\uC544\uBD10. \uCC9C\uCC9C\uD788 \uC6C0\uC9C1\uC774\uACE0, \uC9E4\uB791
    \uC18C\uB9AC\uAC00 \uB098\uBA74 \uBA48\uCDB0."
  caught: "\uAC04\uC218: \uAC70\uAE30! \uCC3D\uACE0 \uC55E\uC5D0\uC11C \uBB58 \uD558\uB294
    \uAC70\uC57C?"
  supplies: "\uBBFC\uAE30: \uB3C4\uC6B0, \uC18C\uC2A4, \uCE58\uC988, \uD398\uD398\uB85C\uB2C8\uAE4C\uC9C0
    \uCC59\uACBC\uC5B4. \uC774\uC81C \uC8FC\uBC29\uC73C\uB85C \uAC00\uC790."
  cook: "\uBBFC\uAE30: \uC7AC\uB8CC\uB97C \uC62C\uB9B4 \uB54C \uC218\uBA74\uC81C\uB3C4
    \uB123\uC5B4. \uB2E4 \uB9CC\uB4E4\uBA74 \uC624\uBE10\uC5D0\uC11C \uAD6C\uC6CC\uC11C
    \uAC00\uC838\uAC00\uC790."
  wrongKey: "\uB9DE\uC9C0 \uC54A\uB294 \uC5F4\uC1E0\uB2E4. \uB2E4\uB978 \uC5F4\uC1E0\uB97C
    \uACE8\uB77C \uBCF4\uC790."
  baked: "\uBBFC\uAE30: \uC798 \uAD6C\uC6CC\uC84C\uB124. \uC811\uC2DC\uC5D0 \uB2F4\uC544\uC11C
    \uC9C1\uC811 \uAC00\uC838\uAC00\uC790."
  officeOpen: "\uBBFC\uAE30: \uC7A0\uB4E4\uC5C8\uC5B4. \uC870\uC6A9\uD788 \uAC04\uC218\uC7A5\uC2E4\uB85C
    \uB4E4\uC5B4\uAC00\uC790."
  load:
  - "\uBBFC\uAE30: \uC811\uC2DC\uC5D0 \uB2F4\uC558\uC5B4. \uAC04\uC218\uB4E4\uC5D0\uAC8C
    \uD55C \uC870\uAC01\uC529 \uB098\uB220 \uC8FC\uC790."
  served: "\uAC04\uC218: \uC9C1\uC811 \uB9CC\uB4E0 \uAC70\uC57C? \uB0C4\uC0C8 \uC88B\uC740\uB370.
    \uD55C \uC870\uAC01 \uBA39\uC5B4 \uBCFC\uAE4C."
  officerTaste: "\uAC04\uC218: \uC74C, \uB9DB\uC788\uB294\uB370? \uAC04\uC218\uC7A5
    \uC5FC\uC724\uD0DC\uB2D8\uB3C4 \uC88B\uC544\uD558\uC2DC\uACA0\uC5B4. \uAC00 \uBD10."
  officer:
  - "\uAC04\uC218: \uC7A0\uAE50 \uBA48\uCDB0. \uB108\uD76C \uBB50\uC57C?"
  - "\uBBFC\uAE30: \uD53C\uC790\uB97C \uB9CC\uB4E4\uC5C8\uB294\uB370 \uAC04\uC218\uC7A5\uB2D8\uB3C4
    \uB4DC\uC154 \uBCF4\uC2DC\uBA74 \uC88B\uC744 \uAC83 \uAC19\uC544\uC11C\uC694."
  - "\uAC04\uC218: \uC218\uC0C1\uD55C\uB370\u2026 \uC774\uB9AC \uC918 \uBD10. \uAC80\uC0AC\uB97C
    \uD574\uC57C\uACA0\uC5B4."
  warden:
  - "\uC5FC\uC724\uD0DC: \uB108\uD76C \uBB50\uC57C! \uC5EC\uAE30\uAC00 \uC5B4\uB514\uB77C\uACE0
    \uB4E4\uC5B4\uC640?"
  - "\uBBFC\uAE30: \uC800\uD76C\uAC00 \uD53C\uC790\uB97C \uB9CC\uB4E4\uC5C8\uB294\uB370
    \uD55C\uBC88 \uB4DC\uC154 \uBCF4\uC168\uC73C\uBA74 \uD574\uC11C \uAC00\uC838\uC654\uC2B5\uB2C8\uB2E4.
    \uD5C8\uB77D\uB3C4 \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
  - "\uC5FC\uC724\uD0DC: \uC74C, \uADF8\uB798? \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294
    \uAC74\uB370. \uAC00\uC838\uC640 \uBD10!"
  - "\uC5FC\uC724\uD0DC: \uC774 \uD53C\uC790\uB294 \uB300\uCCB4 \uBB50\uB0D0\u2026
    \uB108\uBB34 \uB9DB\uC788\uC796\uC544!"
  end: "\uBBFC\uAE30: \uACC4\uD68D\uB300\uB85C\uC57C. \uC870\uC6A9\uD788 \uAC04\uC218\uBCF5\uC744
    \uCC3E\uC790."

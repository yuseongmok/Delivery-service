%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eab7f5fe104868649adea2e41a3dd954, type: 3}
  m_Name: "\uC18C\uB9E4\uCE58\uAE30\uC640 \uBC30\uC2DD \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonKeysText
  lineSeconds: 4
  start: "\uBBFC\uAE30: \uC758\uBB34\uC2E4 \uAC74\uBB3C \uC606 \uACE8\uBAA9\uC5D0
    \uCC3D\uACE0\uAC00 \uC788\uC5B4. \uAC04\uC218\uAC00 \uB4F1\uC744 \uB3CC\uB838\uC744
    \uB54C \uC5F4\uC1E0\uB97C \uBE7C \uC624\uC790. \uB098\uB294 \uB9DD\uC744 \uBCFC\uAC8C."
  stolen: "\uBBFC\uAE30: \uC88B\uC544! \uC5F4\uC1E0\uAC00 \uC5EC\uB7EC \uAC1C\uB124.
    \uCC3D\uACE0 \uBB38\uC5D0 \uB9DE\uB294 \uAC78 \uCC3E\uC544\uBD10. \uAC04\uC218\uAC00
    \uB3CC\uC544\uBCF4\uBA74 \uBA48\uCD94\uACE0 \uC228\uC5B4."
  caught: "\uAC04\uC218: \uAC70\uAE30! \uCC3D\uACE0 \uC55E\uC5D0\uC11C \uBB58 \uD558\uB294
    \uAC70\uC57C?"
  supplies: "\uBBFC\uAE30: \uB3C4\uC6B0, \uC18C\uC2A4, \uCE58\uC988, \uD398\uD398\uB85C\uB2C8\uAE4C\uC9C0
    \uCC59\uACBC\uC5B4. \uC774\uC81C \uC8FC\uBC29\uC73C\uB85C \uAC00\uC790."
  cook: "\uBBFC\uAE30: \uD3C9\uC18C\uCC98\uB7FC \uD398\uD398\uB85C\uB2C8 \uD53C\uC790\uB97C
    \uB9CC\uB4E4\uC5B4. \uAD6C\uC6B4 \uB2E4\uC74C \uB0B4\uAC8C \uAC00\uC838\uC624\uBA74
    \uB3FC."
  wrongKey: "\uB9DE\uC9C0 \uC54A\uB294 \uC5F4\uC1E0\uB2E4. \uB2E4\uB978 \uC5F4\uC1E0\uB97C
    \uACE8\uB77C \uBCF4\uC790."
  baked: "\uBBFC\uAE30: \uC798 \uAD6C\uC6CC\uC84C\uB124. \uCE74\uD2B8\uB85C \uAC00\uC838\uC640."
  officeOpen: "\uBBFC\uAE30: \uD5C8\uB77D\uBC1B\uC558\uC5B4. \uAC04\uC218\uC7A5\uC2E4
    \uC548\uC73C\uB85C \uAC00\uC790."
  load:
  - "\uBBFC\uAE30: \uC798 \uAD6C\uC6CC\uC84C\uB124. \uC774\uC81C \uC900\uBE44\uD574
    \uB454 \uC218\uBA74\uC81C\uB97C \uB123\uC790."
  - "\uB098: \uD6A8\uACFC\uAC00 \uD655\uC2E4\uD574\uC57C \uD560 \uD150\uB370\u2026"
  - "\uBBFC\uAE30: \uCE74\uD2B8\uC5D0 \uC2E4\uC5C8\uC5B4. \uAC04\uC218\uB4E4\uC5D0\uAC8C
    \uD55C \uC870\uAC01\uC529 \uB098\uB220 \uC8FC\uC790."
  served: "\uAC04\uC218: \uC9C1\uC811 \uB9CC\uB4E0 \uAC70\uC57C? \uB0C4\uC0C8 \uC88B\uC740\uB370.
    \uD55C \uC870\uAC01 \uBA39\uC5B4 \uBCFC\uAE4C."
  officer:
  - "\uAC04\uC218: \uC7A0\uAE50 \uBA48\uCDB0. \uB108\uD76C \uBB50\uC57C?"
  - "\uBBFC\uAE30: \uD53C\uC790\uB97C \uB9CC\uB4E4\uC5C8\uB294\uB370 \uAC04\uC218\uC7A5\uB2D8\uB3C4
    \uB4DC\uC154 \uBCF4\uC2DC\uBA74 \uC88B\uC744 \uAC83 \uAC19\uC544\uC11C\uC694."
  - "\uAC04\uC218: \uC218\uC0C1\uD55C\uB370\u2026 \uC774\uB9AC \uC918 \uBD10. \uAC80\uC0AC\uB97C
    \uD574\uC57C\uACA0\uC5B4."
  - "\uAC04\uC218: \uC74C, \uB9DB\uC788\uB294\uB370? \uAC04\uC218\uC7A5 \uC5FC\uC724\uD0DC\uB2D8\uB3C4
    \uC88B\uC544\uD558\uC2DC\uACA0\uC5B4. \uAC00 \uBD10."
  - "\uB098: \uC608. \uD53C\uC790\uB9CC \uB4DC\uB9AC\uACE0 \uBC14\uB85C \uB098\uC624\uACA0\uC2B5\uB2C8\uB2E4."
  warden:
  - "\uC5FC\uC724\uD0DC: \uB108\uD76C \uBB50\uC57C! \uC5EC\uAE30\uAC00 \uC5B4\uB514\uB77C\uACE0
    \uB4E4\uC5B4\uC640?"
  - "\uBBFC\uAE30: \uC800\uD76C\uAC00 \uD53C\uC790\uB97C \uB9CC\uB4E4\uC5C8\uB294\uB370
    \uD55C\uBC88 \uB4DC\uC154 \uBCF4\uC168\uC73C\uBA74 \uD574\uC11C \uAC00\uC838\uC654\uC2B5\uB2C8\uB2E4.
    \uD5C8\uB77D\uB3C4 \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
  - "\uC5FC\uC724\uD0DC: \uC74C, \uADF8\uB798? \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294
    \uAC74\uB370. \uAC00\uC838\uC640 \uBD10!"
  - "\uC5FC\uC724\uD0DC: \uC774 \uD53C\uC790\uB294 \uB300\uCCB4 \uBB50\uB0D0\u2026
    \uB108\uBB34 \uB9DB\uC788\uC796\uC544!"
  end: "\uBBFC\uAE30: \uACC4\uD68D\uB300\uB85C\uC57C. \uC870\uC6A9\uD788 \uAC04\uC218\uBCF5\uC744
    \uCC3E\uC790."

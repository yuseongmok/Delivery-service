--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7bf9e84ca15c4b84389fb9784bd4c45a, type: 3}
  m_Name: "\uCCAB \uC784\uBB34 \uB300\uC0AC"
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryService.Mok.PrisonMissionText
  introduction: "\uAC04\uC218: \uBC30\uC2DD \uB2F9\uBC88\uC774\uB2E4. \uC8FC\uBC29\uC5D0\uC11C
    \uC138 \uC0AC\uB78C \uBAAB\uC744 \uB9CC\uB4E4\uC5B4 \uCE74\uD2B8\uC5D0 \uC2E4\uC5B4.\n\uB098:
    \uBBFC\uAE30\uAC00 \uC5B4\uB514 \uC788\uB294\uC9C0, \uBC30\uC2DD\uD558\uBA74\uC11C
    \uBB3C\uC5B4\uBCF4\uC790."
  prisoners:
  - "\uB098: \uCD5C\uADFC\uC5D0 \uB4E4\uC5B4\uC628 \uC0AC\uB78C \uBABB \uBD24\uC5B4?\n\uC7AC\uC18C\uC790:
    \uC5EC\uAE34 \uB9E4\uC77C \uC0C8 \uC5BC\uAD74\uC774 \uC640. \uC606\uBC29\uC5D0\uB3C4
    \uBB3C\uC5B4\uBD10."
  - "\uB098: \uB098\uB791 \uAC19\uC774 \uC7A1\uD600 \uC628 \uCE5C\uAD6C\uB97C \uCC3E\uACE0
    \uC788\uC5B4.\n\uC7AC\uC18C\uC790: \uB2E4\uCE5C \uC0AC\uB78C? \uC800 \uB05D\uBC29
    \uCE5C\uAD6C\uAC00 \uC758\uBB34\uC2E4 \uCCAD\uC18C\uB97C \uD588\uC73C\uB2C8 \uC54C\uACA0\uC9C0."
  - "\uC7AC\uC18C\uC790: \uB2E4\uB9AC\uC5D0 \uCD1D \uB9DE\uC740 \uC0C8\uB0B4\uAE30
    \uB9D0\uC774\uC9C0? \uC758\uBB34\uC2E4\uC5D0 \uB204\uC6CC \uC788\uC5B4. \uC6B0\uB9B0
    \uC77C\uD558\uB294\uB370 \uAC54\uB294 \uC26C\uAE30\uB9CC \uD55C\uB2E4\uB2C8\uAE4C.\n\uB098:
    \uC758\uBB34\uC2E4\u2026 \uAC04\uC218 \uB208\uC744 \uD53C\uD574 \uAC00\uC57C\uACA0\uC5B4."
  mingi:
  - "\uB098: \uBBFC\uAE30, \uAD1C\uCC2E\uC544?\n\uBBFC\uAE30: \uBAA9\uC18C\uB9AC
    \uB0AE\uCDB0. \uB2E4\uB9AC\uB294 \uC880 \uB098\uC544\uC84C\uC5B4. \uC5EC\uAE30\uB3C4
    \uC548\uC804\uD558\uC9C4 \uC54A\uC544."
  - "\uBBFC\uAE30: \uAC04\uC218\uC7A5 \uC5FC\uC724\uD0DC\uAC00 \uCD9C\uC785 \uAE30\uB85D\uACFC
    \uCC28\uB7C9 \uC5F4\uC1E0\uB97C \uAD00\uB9AC\uD574. \uADF8\uC758 \uBC29\uC5D0
    \uC811\uADFC\uD560 \uBC29\uBC95\uBD80\uD130 \uCC3E\uC790."
  - "\uB098: \uB09C \uC8FC\uBC29 \uC77C\uC744 \uB9E1\uC558\uC5B4. \uBC25\uC744 \uB098\uB974\uBA74\uC11C
    \uC54C\uC544\uBCFC\uAC8C.\n\uBBFC\uAE30: \uC88B\uC544. \uC9C0\uAE08\uC740 \uB4E4\uD0A4\uC9C0
    \uB9D0\uACE0 \uBC29\uC73C\uB85C \uB3CC\uC544\uAC00. \uB2E4\uC74C \uAE30\uD68C\uB97C
    \uAE30\uB2E4\uB9AC\uC790."
  completed: "\uBBFC\uAE30\uC758 \uC704\uCE58\uB97C \uD655\uC778\uD588\uB2E4. \uC8FC\uBC29
    \uC77C\uC740 \uAC04\uC218\uC7A5\uC5D0\uAC8C \uC811\uADFC\uD560 \uAE30\uD68C\uAC00
    \uB420\uC9C0\uB3C4 \uBAA8\uB978\uB2E4.\n\uCCAB \uC784\uBB34 \uC644\uB8CC"
  caught: "\uAC04\uC218: \uD5C8\uAC00 \uC5C6\uC774 \uC758\uBB34\uC2E4\uC5D0 \uB4E4\uC5B4\uC624\uBA74
    \uC548 \uB41C\uB2E4!\n\uC758\uBB34\uC2E4 \uC9C4\uC785\uBD80\uD130 \uB2E4\uC2DC
    \uC2DC\uB3C4\uD569\uB2C8\uB2E4."
  attacked: "\uAC04\uC218: \uACF5\uACA9\uC774\uB2E4! \uC6C0\uC9C1\uC774\uC9C0 \uB9C8!\n\uC784\uBB34\uB97C
    \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uC2DC\uC791\uD569\uB2C8\uB2E4."
  objectives:
  - "\uC8FC\uBC29\uC5D0\uC11C \uBC25 3\uC778\uBD84 \uB9CC\uB4E4\uAE30"
  - "\uC644\uC131\uB41C \uC2DD\uC0AC\uB97C \uBC30\uC2DD\uCE74\uD2B8\uC5D0 \uC2E3\uAE30"
  - "\uBC30\uC2DD\uCE74\uD2B8\uB85C \uC7AC\uC18C\uC790\uC5D0\uAC8C \uC2DD\uC0AC \uC804\uB2EC"
  - "\uAC04\uC218\uC758 \uC2DC\uC120\uC744 \uD53C\uD574 \uC758\uBB34\uC2E4\uB85C
    \uB4E4\uC5B4\uAC00\uAE30"
  - "\uBBFC\uAE30\uC640 \uC870\uC6A9\uD788 \uB300\uD654\uD558\uAE30"
  - "\uB4E4\uD0A4\uC9C0 \uC54A\uACE0 \uC790\uAE30 \uBC29\uC73C\uB85C \uB3CC\uC544\uAC00\uAE30"
  - "\uBBFC\uAE30\uB97C \uCC3E\uC544\uC11C \xB7 \uC644\uB8CC"
